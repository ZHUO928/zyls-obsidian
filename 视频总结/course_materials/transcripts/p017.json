      "text": "這個8位圓碼表示的真值圍負3"
    },
    {
      "start": 303.44,
      "end": 304.2,
      "text": "以此類推"
    },
    {
      "start": 304.72,
      "end": 307.78,
      "text": "這個8位圓碼表示的真值圍負127"
    },
    {
      "start": 308.43,
      "end": 309.21,
      "text": "不但看出"
    },
    {
      "start": 309.71,
