      "text": "也就是數值0"
    },
    {
      "start": 318.93,
      "end": 319.69,
      "text": "因此"
    },
    {
      "start": 319.95,
      "end": 324.29,
      "text": "8位圓碼能表示的不同數據的數量為256-1"
    },
