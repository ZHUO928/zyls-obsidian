{
  "file": "p147.mp3",
  "duration": 790.1054375,
  "language": "zh",
  "segments": [
    {
      "start": 3.79,
      "end": 7.79,
      "text": "同学们好,欢迎大家来到我的计算机组成员里维克堂"
    },
    {
      "start": 7.79,
      "end": 11.47,
      "text": "在上几课中,我们对IO控制方式进行了概述"
    },
    {
      "start": 11.47,
      "end": 16.59,
      "text": "本节课,我们给同学们介绍IO控制方式中的程序直接控制方式"
    },
    {
      "start": 16.59,
      "end": 19.15,
      "text": "也就是程序查询方式"
    },
    {
      "start": 19.15,
      "end": 21.87,
      "text": "这种IO控制方式的基本思想是"
    },
    {
      "start": 21.87,
      "end": 26.83,
      "text": "CPU通过执行一段IO程序来实现与IO设备的数据交换"
    },
    {
      "start": 26.83,
      "end": 30.67,
      "text": "这是最原始最简单的IO控制方式"
    },
    {
      "start": 30.83,
      "end": 36.83,
      "text": "这种IO控制方式又可进一步分为程序查询方式和直接传送方式"
    },
    {
      "start": 36.83,
      "end": 40.83,
      "text": "其中程序查询方式也称为轮旋方式"
    },
    {
      "start": 40.83,
      "end": 44.03,
      "text": "在这种方式下,每次数据传送前"
    },
    {
      "start": 44.03,
      "end": 47.23,
      "text": "CPU必须主动查询IO设备状态"
    },
    {
      "start": 47.23,
      "end": 50.27,
      "text": "在IO设备就序后才能进行操作"
    },
    {
      "start": 50.27,
      "end": 52.67,
      "text": "属于有条件传送方式"
    },
    {
      "start": 52.67,
      "end": 56.82,
      "text": "IO程序通过与IO接口中的命令计准器DCR"
    },
    {
      "start": 56.82,
      "end": 58.66,
      "text": "状态计准器DSR"
    },
    {
      "start": 58.74,
      "end": 62.26,
      "text": "以及数据缓冲计准器DBR进行数据交互"
    },
    {
      "start": 62.26,
      "end": 64.82,
      "text": "来实现设备控制和传输"
    },
    {
      "start": 64.82,
      "end": 66.26,
      "text": "请同学们注意"
    },
    {
      "start": 66.26,
      "end": 69.94,
      "text": "上述个计准器的位宽、数目以及功能定义"
    },
    {
      "start": 69.94,
      "end": 72.26,
      "text": "因设备和厂商而异"
    },
    {
      "start": 72.26,
      "end": 75.62,
      "text": "编写驱动程序时必须遵循具体约定"
    },
    {
      "start": 75.62,
      "end": 77.22,
      "text": "不同类型的IO设备"
    },
    {
      "start": 77.22,
      "end": 80.32,
      "text": "其程序查询的流程有所不同"
    },
    {
      "start": 80.32,
      "end": 82.08,
      "text": "对于直接传送方式"
    },
    {
      "start": 82.08,
      "end": 84.4,
      "text": "则无需查询IO设备状态"
    },
    {
      "start": 84.4,
      "end": 86.24,
      "text": "直接进行数据交互"
    },
    {
      "start": 86.24,
      "end": 88.64,
      "text": "属于无条件传送方式"
    },
    {
      "start": 88.72,
      "end": 91.68,
      "text": "可将其看作是程序查询方式的测例"
    },
    {
      "start": 91.68,
      "end": 94.24,
      "text": "一般适用于非常简单的IO设备"
    },
    {
      "start": 94.24,
      "end": 96.96,
      "text": "例如开关、LED显示"
    },
    {
      "start": 96.96,
      "end": 98.62,
      "text": "就不再介绍了"
    },
    {
      "start": 98.62,
      "end": 102.22,
      "text": "接下来我们来举例说明程序查询方式"
    },
    {
      "start": 102.22,
      "end": 105.26,
      "text": "例如对于键盘这种简单的数据设备"
    },
    {
      "start": 105.26,
      "end": 107.74,
      "text": "其没有命令计准器DCR"
    },
    {
      "start": 107.74,
      "end": 109.26,
      "text": "当按下按键时"
    },
    {
      "start": 109.26,
      "end": 112.22,
      "text": "键盘控制器将被按下按键的键值"
    },
    {
      "start": 112.22,
      "end": 113.82,
      "text": "也就是ASCMA"
    },
    {
      "start": 113.82,
      "end": 117.34,
      "text": "存放在键盘的数据缓冲计准器DBR中"
    },
    {
      "start": 117.42,
      "end": 120.7,
      "text": "同时将键盘的状态计准器DCR中的"
    },
    {
      "start": 120.7,
      "end": 122.7,
      "text": "Ready标志位置为1"
    },
    {
      "start": 122.7,
      "end": 125.33,
      "text": "表示当前有按键数据"
    },
    {
      "start": 125.33,
      "end": 128.53,
      "text": "当CPU需要从键盘获取按键数据时"
    },
    {
      "start": 128.53,
      "end": 132.13,
      "text": "则通过总线读取状态计准器DCR"
    },
    {
      "start": 132.13,
      "end": 135.17,
      "text": "以便查询DCR中的Ready标志位"
    },
    {
      "start": 135.17,
      "end": 138.61,
      "text": "若为0则继续查询直至该位为1"
    },
    {
      "start": 138.61,
      "end": 143.73,
      "text": "若为1则通过总线读取数据缓冲计准器DBR中的键值"
    },
    {
      "start": 143.73,
      "end": 144.93,
      "text": "完成操作后"
    },
    {
      "start": 144.93,
      "end": 148.06,
      "text": "DCR中的Ready标志位自动清理"
    },
    {
      "start": 148.06,
      "end": 150.14,
      "text": "我们给出本利的流程图"
    },
    {
      "start": 150.14,
      "end": 153.7,
      "text": "相信同学们都能看懂就不再追数了"
    },
    {
      "start": 153.7,
      "end": 155.06,
      "text": "需要说明的是"
    },
    {
      "start": 155.06,
      "end": 157.54,
      "text": "如果需要连续获取多个按键"
    },
    {
      "start": 157.54,
      "end": 161.44,
      "text": "则需要给上属流程加上循环控制"
    },
    {
      "start": 161.44,
      "end": 165.44,
      "text": "接下来给出的是本利相应的MIPS会边程序"
    },
    {
      "start": 165.44,
      "end": 169.2,
      "text": "其中所涉及到的IO接口的统一编织方式"
    },
    {
      "start": 169.2,
      "end": 172.24,
      "text": "也就是使用仿存指令访问IO设备"
    },
    {
      "start": 172.32,
      "end": 175.76,
      "text": "我们在上上次课中已经给同学们介绍过了"
    },
    {
      "start": 175.76,
      "end": 176.48,
      "text": "因此"
    },
    {
      "start": 176.48,
      "end": 179.52,
      "text": "接下来请同学们暂停播放视频"
    },
    {
      "start": 179.52,
      "end": 183.36,
      "text": "根据这段MIPS会边程序的代码注释进行理解"
    },
    {
      "start": 183.36,
      "end": 189.44,
      "text": "我们就不再追数了"
    },
    {
      "start": 189.44,
      "end": 192.96,
      "text": "我们再给出本利相应的X86会边程序"
    },
    {
      "start": 192.96,
      "end": 196.64,
      "text": "其中所涉及到的IO接口的独立编织方式"
    },
    {
      "start": 196.64,
      "end": 199.92,
      "text": "也就是使用专用IO指令访问IO设备"
    },
    {
      "start": 199.92,
      "end": 203.6,
      "text": "我们在上上次课中也已经给同学们介绍过了"
    },
    {
      "start": 203.6,
      "end": 204.32,
      "text": "因此"
    },
    {
      "start": 204.4,
      "end": 207.36,
      "text": "接下来请同学们暂停播放视频"
    },
    {
      "start": 207.36,
      "end": 211.12,
      "text": "根据这段X86会边程序的代码注释进行理解"
    },
    {
      "start": 211.12,
      "end": 218.27,
      "text": "就不再追数了"
    },
    {
      "start": 218.27,
      "end": 218.91,
      "text": "好的"
    },
    {
      "start": 218.91,
      "end": 221.63,
      "text": "本利实际上给出的是输入设备"
    },
    {
      "start": 221.63,
      "end": 222.35,
      "text": "接下来"
    },
    {
      "start": 222.35,
      "end": 224.67,
      "text": "我们再来看一个输出设备的例子"
    },
    {
      "start": 224.67,
      "end": 228.59,
      "text": "例如对于自负显示中端这种简单的输出设备"
    },
    {
      "start": 228.59,
      "end": 231.23,
      "text": "其没有命令计存器DCR"
    },
    {
      "start": 231.23,
      "end": 234.67,
      "text": "当CPU需要输出自负到自负显示中端时"
    },
    {
      "start": 234.67,
      "end": 239.47,
      "text": "则通过总线读取自负显示中端的状态计存器DSR"
    },
    {
      "start": 239.47,
      "end": 242.35,
      "text": "以便查询DSR中的Ready标志位"
    },
    {
      "start": 242.35,
      "end": 247.15,
      "text": "若为1表示自负显示中端可以接收CPU的自负数据"
    },
    {
      "start": 247.15,
      "end": 253.39,
      "text": "此时CPU将自负数据写入自负显示中端的数据缓冲计存器DBR"
    },
    {
      "start": 253.39,
      "end": 256.83,
      "text": "若为0表示自负显示中端尚未就绪"
    },
    {
      "start": 256.83,
      "end": 259.87,
      "text": "则继续查询直至该位为1"
    },
    {
      "start": 259.87,
      "end": 263.55,
      "text": "当自负显示中端接收到来自CPU的自负数据号"
    },
    {
      "start": 263.55,
      "end": 265.31,
      "text": "执行以下操作"
    },
    {
      "start": 265.39,
      "end": 268.91,
      "text": "1 立即将DSR中的Ready标志位清零"
    },
    {
      "start": 268.91,
      "end": 270.59,
      "text": "也就是复位"
    },
    {
      "start": 270.59,
      "end": 273.14,
      "text": "2 进行显示处理"
    },
    {
      "start": 273.14,
      "end": 276.9,
      "text": "3 重新将DSR中的Ready标志位置1"
    },
    {
      "start": 276.9,
      "end": 280.03,
      "text": "表示可以接收新的自负数据"
    },
    {
      "start": 280.03,
      "end": 282.19,
      "text": "我们给出本例的流程图"
    },
    {
      "start": 282.19,
      "end": 285.82,
      "text": "相信同学们都能看懂就不再追数了"
    },
    {
      "start": 285.82,
      "end": 287.26,
      "text": "需要说明的是"
    },
    {
      "start": 287.26,
      "end": 289.66,
      "text": "如果需要连续输出多个自负"
    },
    {
      "start": 289.66,
      "end": 293.3,
      "text": "则需要给上述流程加上循环控制"
    },
    {
      "start": 293.3,
      "end": 297.14,
      "text": "接下来给出的是本例相应的MIPS挥边程序"
    },
    {
      "start": 297.14,
      "end": 299.46,
      "text": "请同学们暂停播放视频"
    },
    {
      "start": 299.46,
      "end": 302.98,
      "text": "根据这段MIPS挥边程序的代码注释进行理解"
    },
    {
      "start": 302.98,
      "end": 308.88,
      "text": "就不再追数了"
    },
    {
      "start": 308.88,
      "end": 312.08,
      "text": "我们再给出本例相应的X86挥边程序"
    },
    {
      "start": 312.08,
      "end": 314.32,
      "text": "请同学们暂停播放视频"
    },
    {
      "start": 314.32,
      "end": 317.92,
      "text": "根据这段X86挥边程序的代码注释进行理解"
    },
    {
      "start": 317.92,
      "end": 319.44,
      "text": "就不再追数了"
    },
    {
      "start": 324.78,
      "end": 325.58,
      "text": "好的"
    },
    {
      "start": 325.58,
      "end": 328.22,
      "text": "对于我们之前刚刚取过的这两个例子"
    },
    {
      "start": 328.22,
      "end": 332.3,
      "text": "如果将键盘程序和自负显示中端程序串接起来"
    },
    {
      "start": 332.46,
      "end": 334.06,
      "text": "加上循环控制后"
    },
    {
      "start": 334.06,
      "end": 338.27,
      "text": "还可以实现键盘输入回显功能"
    },
    {
      "start": 338.27,
      "end": 339.63,
      "text": "需要说明的是"
    },
    {
      "start": 339.63,
      "end": 343.31,
      "text": "上述两个例子中的键盘设备和自负显示中端设备"
    },
    {
      "start": 343.31,
      "end": 345.55,
      "text": "都属于典型的自负设备"
    },
    {
      "start": 345.55,
      "end": 348.75,
      "text": "其功能单一只支持顺序访问"
    },
    {
      "start": 348.75,
      "end": 351.87,
      "text": "因此不需要命令计准器DCR"
    },
    {
      "start": 351.87,
      "end": 354.27,
      "text": "而对于复杂的输入输出设备"
    },
    {
      "start": 354.27,
      "end": 356.99,
      "text": "则需要支持数据的双向交互"
    },
    {
      "start": 356.99,
      "end": 360.43,
      "text": "甚至需要以数据块为单位进行传输"
    },
    {
      "start": 360.43,
      "end": 362.59,
      "text": "其控制流程价位复杂"
    },
    {
      "start": 362.67,
      "end": 363.79,
      "text": "那么接下来呢"
    },
    {
      "start": 363.79,
      "end": 365.23,
      "text": "我们就给同学们介绍"
    },
    {
      "start": 365.23,
      "end": 368.26,
      "text": "复杂输入输出设备的查询流程"
    },
    {
      "start": 368.26,
      "end": 371.94,
      "text": "CPU与复杂输入输出设备进行数据交互时"
    },
    {
      "start": 371.94,
      "end": 375.54,
      "text": "首先要读取设备状态计存器DSR的内容"
    },
    {
      "start": 375.54,
      "end": 378.74,
      "text": "以便根据其中的就序标志位Ready的值"
    },
    {
      "start": 378.74,
      "end": 381.06,
      "text": "判断设备是否已就序"
    },
    {
      "start": 381.06,
      "end": 383.3,
      "text": "若Ready标志位的值不为一"
    },
    {
      "start": 383.3,
      "end": 385.38,
      "text": "则继续进行查询"
    },
    {
      "start": 385.38,
      "end": 387.62,
      "text": "若Ready标志位的值为一"
    },
    {
      "start": 387.62,
      "end": 390.42,
      "text": "则可以通过总线向设备的IO接口"
    },
    {
      "start": 390.5,
      "end": 393.54,
      "text": "发送命令和参数来启动设备"
    },
    {
      "start": 393.54,
      "end": 396.82,
      "text": "这样设备就开始执行相应的操作"
    },
    {
      "start": 396.82,
      "end": 398.98,
      "text": "这可能需要较长的时间"
    },
    {
      "start": 398.98,
      "end": 400.98,
      "text": "而CPU在启动设备后"
    },
    {
      "start": 400.98,
      "end": 403.86,
      "text": "就开始不断的查询设备状态"
    },
    {
      "start": 403.86,
      "end": 405.3,
      "text": "当设备就序时"
    },
    {
      "start": 405.3,
      "end": 408.64,
      "text": "就可以进行实际的数据传输"
    },
    {
      "start": 408.64,
      "end": 410.08,
      "text": "需要说明的是"
    },
    {
      "start": 410.08,
      "end": 411.6,
      "text": "在上述流程中"
    },
    {
      "start": 411.6,
      "end": 415.04,
      "text": "需要两次循环查询设备状态的过程"
    },
    {
      "start": 415.04,
      "end": 417.92,
      "text": "如果在第一次循环查询设备状态的过程中"
    },
    {
      "start": 417.92,
      "end": 419.6,
      "text": "发现设备不正常"
    },
    {
      "start": 419.6,
      "end": 422.8,
      "text": "也可直接向设备发送复位命令"
    },
    {
      "start": 422.8,
      "end": 423.52,
      "text": "另外"
    },
    {
      "start": 423.52,
      "end": 425.52,
      "text": "当设备收到正常的命令"
    },
    {
      "start": 425.52,
      "end": 427.76,
      "text": "也就是非复位命令"
    },
    {
      "start": 427.76,
      "end": 430.0,
      "text": "就立刻进行准备或处理"
    },
    {
      "start": 430.0,
      "end": 432.88,
      "text": "也就是进入设备准备阶段"
    },
    {
      "start": 432.88,
      "end": 435.65,
      "text": "该阶段可能需要较长的时间"
    },
    {
      "start": 435.65,
      "end": 436.93,
      "text": "设备准备好后"
    },
    {
      "start": 436.93,
      "end": 441.94,
      "text": "会将设备状态计论器DSR中的就续标志位Ready之一"
    },
    {
      "start": 441.94,
      "end": 442.82,
      "text": "相应的"
    },
    {
      "start": 442.82,
      "end": 444.42,
      "text": "CPU在启动设备后"
    },
    {
      "start": 444.42,
      "end": 447.14,
      "text": "就开始持续查询设备状态"
    },
    {
      "start": 447.14,
      "end": 449.3,
      "text": "也称为轮寻"
    },
    {
      "start": 449.38,
      "end": 451.54,
      "text": "主要有两种轮寻策略"
    },
    {
      "start": 451.54,
      "end": 453.06,
      "text": "一种是忙等待"
    },
    {
      "start": 453.06,
      "end": 455.22,
      "text": "也称为独占式查询"
    },
    {
      "start": 455.22,
      "end": 457.38,
      "text": "另一种是定时轮寻"
    },
    {
      "start": 457.38,
      "end": 460.1,
      "text": "我们画出这两种轮寻策略的示意图"
    },
    {
      "start": 460.1,
      "end": 462.02,
      "text": "以方便同学们理解"
    },
    {
      "start": 462.02,
      "end": 464.82,
      "text": "首先来画独占式查询的示意图"
    },
    {
      "start": 464.82,
      "end": 465.86,
      "text": "如同所示"
    },
    {
      "start": 465.86,
      "end": 468.02,
      "text": "水平方向为时间"
    },
    {
      "start": 468.02,
      "end": 472.1,
      "text": "CPU执行包含有访问IOS设备功能的用户程序"
    },
    {
      "start": 472.1,
      "end": 475.1,
      "text": "用户程序发送设备命令和参数"
    },
    {
      "start": 475.1,
      "end": 476.54,
      "text": "IOS设备收到后"
    },
    {
      "start": 476.54,
      "end": 478.22,
      "text": "进入准备阶段"
    },
    {
      "start": 478.3,
      "end": 480.94,
      "text": "而CPU在发送设备命令和参数后"
    },
    {
      "start": 480.94,
      "end": 483.74,
      "text": "就开始反复查询设备的状态"
    },
    {
      "start": 483.74,
      "end": 485.74,
      "text": "也称为轮寻等待"
    },
    {
      "start": 485.74,
      "end": 487.74,
      "text": "这样一旦设备就续"
    },
    {
      "start": 487.74,
      "end": 490.46,
      "text": "CPU就能立即发现设备已就续"
    },
    {
      "start": 490.46,
      "end": 493.57,
      "text": "竟然可以进入实际的数据传输阶段"
    },
    {
      "start": 493.57,
      "end": 495.97,
      "text": "之后执行用户程序的其他部分"
    },
    {
      "start": 495.97,
      "end": 497.86,
      "text": "就不再追数了"
    },
    {
      "start": 497.86,
      "end": 501.04,
      "text": "我们再来画出定时轮寻的示意图"
    },
    {
      "start": 501.04,
      "end": 504.8,
      "text": "CPU执行包含有访问IOS设备功能的用户程序"
    },
    {
      "start": 504.8,
      "end": 507.07,
      "text": "就为用户进程PE"
    },
    {
      "start": 507.07,
      "end": 509.66,
      "text": "CPU发送设备命令和参数"
    },
    {
      "start": 509.66,
      "end": 512.78,
      "text": "IOS设备收到后进入准备阶段"
    },
    {
      "start": 512.78,
      "end": 514.54,
      "text": "相较于独占式查询"
    },
    {
      "start": 514.54,
      "end": 515.98,
      "text": "对于定时轮寻"
    },
    {
      "start": 515.98,
      "end": 518.54,
      "text": "CPU在发送设备命令和参数后"
    },
    {
      "start": 518.54,
      "end": 520.94,
      "text": "不需要反复查询设备的状态"
    },
    {
      "start": 520.94,
      "end": 523.1,
      "text": "而是启动一个定时器"
    },
    {
      "start": 523.1,
      "end": 525.66,
      "text": "然后挂起当前用户进程PE"
    },
    {
      "start": 525.66,
      "end": 528.06,
      "text": "并将其放入IOS等待队列"
    },
    {
      "start": 528.06,
      "end": 530.54,
      "text": "也就是进行进程调度"
    },
    {
      "start": 530.54,
      "end": 532.86,
      "text": "调度其他用户进程运行"
    },
    {
      "start": 532.86,
      "end": 536.11,
      "text": "这里我们将其他用户进程即为P2"
    },
    {
      "start": 536.19,
      "end": 539.07,
      "text": "假设在该时刻还有设备就续"
    },
    {
      "start": 539.07,
      "end": 540.35,
      "text": "而在该时刻"
    },
    {
      "start": 540.35,
      "end": 543.87,
      "text": "之前启动的定时器产生了定时中断"
    },
    {
      "start": 543.87,
      "end": 547.23,
      "text": "CPU会执行相应的定时中断服务程序"
    },
    {
      "start": 547.23,
      "end": 550.83,
      "text": "该程序的主要任务就是查询设备状态"
    },
    {
      "start": 550.83,
      "end": 552.43,
      "text": "如果设备已就续"
    },
    {
      "start": 552.43,
      "end": 554.59,
      "text": "则唤醒用户进程PE"
    },
    {
      "start": 554.59,
      "end": 557.34,
      "text": "否则将继续进行定时轮寻"
    },
    {
      "start": 557.34,
      "end": 560.54,
      "text": "这样当用户进程P2执行结束后"
    },
    {
      "start": 560.54,
      "end": 561.9,
      "text": "通过进程调度"
    },
    {
      "start": 561.9,
      "end": 565.34,
      "text": "就可以继续执行之前唤醒的用户进程PE"
    },
    {
      "start": 565.42,
      "end": 567.82,
      "text": "进行实际的数据成数"
    },
    {
      "start": 567.82,
      "end": 571.02,
      "text": "通过对比上述这两种轮寻策略的示意图"
    },
    {
      "start": 571.02,
      "end": 572.3,
      "text": "不能发现"
    },
    {
      "start": 572.3,
      "end": 573.98,
      "text": "对于独占式查询"
    },
    {
      "start": 573.98,
      "end": 577.18,
      "text": "轮寻等待浪费了大量的CPU时间"
    },
    {
      "start": 577.18,
      "end": 579.1,
      "text": "一般在单人物操作系统中"
    },
    {
      "start": 579.1,
      "end": 581.02,
      "text": "可采用独占式查询"
    },
    {
      "start": 581.02,
      "end": 583.18,
      "text": "因为CPU在轮寻等待过程中"
    },
    {
      "start": 583.18,
      "end": 585.57,
      "text": "不需要执行其他任务"
    },
    {
      "start": 585.57,
      "end": 587.09,
      "text": "对于超高速设备"
    },
    {
      "start": 587.09,
      "end": 588.69,
      "text": "由于设备响应快"
    },
    {
      "start": 588.69,
      "end": 590.69,
      "text": "相应的轮寻等待时间短"
    },
    {
      "start": 590.69,
      "end": 593.55,
      "text": "独占式查询也可以接受"
    },
    {
      "start": 593.55,
      "end": 595.07,
      "text": "对于定时轮寻"
    },
    {
      "start": 595.15,
      "end": 596.99,
      "text": "设备准备数据的过程中"
    },
    {
      "start": 596.99,
      "end": 599.15,
      "text": "CPU可执行其他任务"
    },
    {
      "start": 599.15,
      "end": 601.23,
      "text": "这样就有效避免了"
    },
    {
      "start": 601.23,
      "end": 604.43,
      "text": "轮寻等待对CPU时间的大量浪费"
    },
    {
      "start": 604.43,
      "end": 605.95,
      "text": "不过中断服务"
    },
    {
      "start": 605.95,
      "end": 608.59,
      "text": "还是需要占有一定的CPU时间"
    },
    {
      "start": 608.59,
      "end": 609.71,
      "text": "从上所说"
    },
    {
      "start": 609.71,
      "end": 612.19,
      "text": "定时轮寻适用于外部设备自身"
    },
    {
      "start": 612.19,
      "end": 615.55,
      "text": "没有中断请求功能的多任务操作系统"
    },
    {
      "start": 615.55,
      "end": 617.63,
      "text": "可能有些同学已经发现了"
    },
    {
      "start": 617.63,
      "end": 619.15,
      "text": "对于定时轮寻"
    },
    {
      "start": 619.15,
      "end": 622.59,
      "text": "定时时间间隔的选择是一个关键问题"
    },
    {
      "start": 622.59,
      "end": 624.67,
      "text": "若定时时间间隔太短"
    },
    {
      "start": 624.75,
      "end": 626.11,
      "text": "则中断频繁"
    },
    {
      "start": 626.11,
      "end": 628.19,
      "text": "竟然频繁进行中断服务"
    },
    {
      "start": 628.19,
      "end": 629.9,
      "text": "开销浪费大"
    },
    {
      "start": 629.9,
      "end": 632.06,
      "text": "若定时时间间隔太长"
    },
    {
      "start": 632.06,
      "end": 634.14,
      "text": "则IOS设备准备好数据号"
    },
    {
      "start": 634.14,
      "end": 636.26,
      "text": "可能得不到及时处理"
    },
    {
      "start": 636.26,
      "end": 638.74,
      "text": "因此为了提高CPU利用率"
    },
    {
      "start": 638.74,
      "end": 643.06,
      "text": "并且确保IOS设备的数据得到及时处理而不丢失"
    },
    {
      "start": 643.06,
      "end": 646.13,
      "text": "需要合理设置定时时间间隔"
    },
    {
      "start": 646.13,
      "end": 647.25,
      "text": "例如"
    },
    {
      "start": 647.25,
      "end": 651.41,
      "text": "键盘设备和鼠标设备的输入速度比CPU慢得多"
    },
    {
      "start": 651.41,
      "end": 652.21,
      "text": "因此"
    },
    {
      "start": 652.21,
      "end": 654.77,
      "text": "只要以比人的反应速度快的频率"
    },
    {
      "start": 654.77,
      "end": 656.21,
      "text": "进行定时轮寻"
    },
    {
      "start": 656.21,
      "end": 659.01,
      "text": "就可以确保设备数据不丢失"
    },
    {
      "start": 659.01,
      "end": 660.13,
      "text": "综上所说"
    },
    {
      "start": 660.13,
      "end": 663.89,
      "text": "慢速设备比较适合定时轮寻这种轮型设备"
    },
    {
      "start": 663.89,
      "end": 666.77,
      "text": "而快速设备的定时轮寻开销大"
    },
    {
      "start": 666.77,
      "end": 667.49,
      "text": "另外"
    },
    {
      "start": 667.49,
      "end": 670.37,
      "text": "程序查询方式的IO接口设计简单"
    },
    {
      "start": 670.37,
      "end": 671.49,
      "text": "容易实现"
    },
    {
      "start": 671.49,
      "end": 674.8,
      "text": "常见于早期单人物操作系统中"
    },
    {
      "start": 674.8,
      "end": 676.4,
      "text": "现代多人物操作系统"
    },
    {
      "start": 676.4,
      "end": 678.64,
      "text": "在多人物引导成功之前"
    },
    {
      "start": 678.64,
      "end": 680.56,
      "text": "必须使用程序查询方式"
    },
    {
      "start": 680.56,
      "end": 682.56,
      "text": "与IO设备进行交互"
    },
    {
      "start": 682.56,
      "end": 683.84,
      "text": "例如键盘"
    },
    {
      "start": 683.84,
      "end": 684.48,
      "text": "磁盘"
    },
    {
      "start": 684.48,
      "end": 685.36,
      "text": "显示器等"
    },
    {
      "start": 685.36,
      "end": 688.54,
      "text": "都必须支持程序查询方式"
    },
    {
      "start": 688.54,
      "end": 689.26,
      "text": "好的"
    },
    {
      "start": 689.26,
      "end": 690.06,
      "text": "接下来"
    },
    {
      "start": 690.06,
      "end": 691.66,
      "text": "请同学们挑战这道"
    },
    {
      "start": 691.66,
      "end": 695.5,
      "text": "与本节课内容相关的408考研例年真题"
    },
    {
      "start": 695.5,
      "end": 697.74,
      "text": "请同学们暂停播放视频"
    },
    {
      "start": 697.74,
      "end": 699.18,
      "text": "动手练习一下"
    },
    {
      "start": 699.18,
      "end": 706.74,
      "text": "然后给出你的答案"
    },
    {
      "start": 706.74,
      "end": 708.66,
      "text": "本题的答案是选项C"
    },
    {
      "start": 708.66,
      "end": 710.18,
      "text": "大家都选对了吗"
    },
    {
      "start": 710.18,
      "end": 712.1,
      "text": "我们来一起分析一下"
    },
    {
      "start": 712.1,
      "end": 713.14,
      "text": "题目给定"
    },
    {
      "start": 713.14,
      "end": 715.38,
      "text": "每秒至少查询200次"
    },
    {
      "start": 715.46,
      "end": 718.5,
      "text": "查询程序运行一次所用的十中周期数"
    },
    {
      "start": 718.5,
      "end": 719.94,
      "text": "至少为500"
    },
    {
      "start": 719.94,
      "end": 722.66,
      "text": "因此每秒用于查询的时间至少为"
    },
    {
      "start": 722.66,
      "end": 723.78,
      "text": "500乘以200"
    },
    {
      "start": 723.78,
      "end": 726.18,
      "text": "等于10万个十中周期"
    },
    {
      "start": 726.18,
      "end": 727.06,
      "text": "题目给定"
    },
    {
      "start": 727.06,
      "end": 729.62,
      "text": "Project主评为50兆赫兹"
    },
    {
      "start": 729.62,
      "end": 731.62,
      "text": "因此CPU时间为"
    },
    {
      "start": 731.62,
      "end": 734.58,
      "text": "50乘以10的六四方个十中周期"
    },
    {
      "start": 734.58,
      "end": 736.34,
      "text": "综合一式和二式"
    },
    {
      "start": 736.34,
      "end": 739.54,
      "text": "即可得到CPU用于设备A到IO的时间"
    },
    {
      "start": 739.54,
      "end": 741.94,
      "text": "占整个CPU时间的百分比"
    },
    {
      "start": 741.94,
      "end": 742.98,
      "text": "综上所述"
    },
    {
      "start": 742.98,
      "end": 745.52,
      "text": "本题的答案是选项C"
    },
    {
      "start": 745.68,
      "end": 746.4,
      "text": "好的"
    },
    {
      "start": 746.4,
      "end": 748.56,
      "text": "本节课到这里就结束了"
    },
    {
      "start": 748.56,
      "end": 750.56,
      "text": "请同学们快速回忆一下"
    },
    {
      "start": 750.56,
      "end": 786.03,
      "text": "本节课的主要内容"
    },
    {
      "start": 786.03,
      "end": 786.75,
      "text": "同学们"
    },
    {
      "start": 786.75,
      "end": 788.11,
      "text": "我们下节课见"
    }
  ]
}