{
  "file": "p042.mp3",
  "duration": 212.648375,
  "language": "zh",
  "segments": [
    {
      "start": 2.96,
      "end": 7.36,
      "text": "同学们好,欢迎大家来到我的计算机组成原理,微课堂。"
    },
    {
      "start": 7.36,
      "end": 11.96,
      "text": "本节课,我们介绍辅典除法运算的相关知识。"
    },
    {
      "start": 11.96,
      "end": 15.62,
      "text": "假设X和Y是两个辅典数,"
    },
    {
      "start": 15.62,
      "end": 19.52,
      "text": "EX和EY分别是它们各自的接码,"
    },
    {
      "start": 19.52,
      "end": 23.91,
      "text": "MX和MY分别是它们各自的尾数,"
    },
    {
      "start": 23.91,
      "end": 28.21,
      "text": "则X和Y各自可表示为以下形式,"
    },
    {
      "start": 28.21,
      "end": 33.26,
      "text": "因此X除以外可得如下形式,"
    },
    {
      "start": 34.51,
      "end": 37.71,
      "text": "不难看出,两个辅典数的除法运算,"
    },
    {
      "start": 37.71,
      "end": 41.41,
      "text": "实际上需要将它们各自的接码相见,"
    },
    {
      "start": 41.41,
      "end": 43.54,
      "text": "尾数相除,"
    },
    {
      "start": 43.54,
      "end": 47.64,
      "text": "尾数相除才用定点小数除法,"
    },
    {
      "start": 47.64,
      "end": 49.31,
      "text": "这就需要确保,"
    },
    {
      "start": 49.31,
      "end": 53.31,
      "text": "背除数X的尾数MX的绝对值,"
    },
    {
      "start": 53.31,
      "end": 57.21,
      "text": "小于除数Y的尾数MY的绝对值,"
    },
    {
      "start": 57.21,
      "end": 59.97,
      "text": "否则需要做相应调整,"
    },
    {
      "start": 59.97,
      "end": 65.58,
      "text": "尾数相处的结果可能需要规格化和手足处理,"
    },
    {
      "start": 65.78,
      "end": 69.78,
      "text": "接码相见才用定点整数前法运算,"
    },
    {
      "start": 69.78,
      "end": 74.46,
      "text": "当两个接码一号时可能会发生一出,"
    },
    {
      "start": 74.46,
      "end": 75.76,
      "text": "综上所说,"
    },
    {
      "start": 75.76,
      "end": 79.55,
      "text": "辅典除法运算包含以下四个步骤,"
    },
    {
      "start": 79.55,
      "end": 82.67,
      "text": "步骤一,尾数调整,"
    },
    {
      "start": 82.67,
      "end": 85.46,
      "text": "步骤二,接码相见,"
    },
    {
      "start": 85.46,
      "end": 88.32,
      "text": "步骤三,尾数相除,"
    },
    {
      "start": 88.32,
      "end": 92.01,
      "text": "步骤四,规格化和手足,"
    },
    {
      "start": 92.01,
      "end": 94.21,
      "text": "在执行步骤一时,"
    },
    {
      "start": 94.21,
      "end": 96.71,
      "text": "如果发现背除数X的尾数,"
    },
    {
      "start": 96.81,
      "end": 98.81,
      "text": "MX的绝对值,"
    },
    {
      "start": 98.81,
      "end": 103.01,
      "text": "大于除数Y的尾数MY的绝对值,"
    },
    {
      "start": 103.01,
      "end": 105.93,
      "text": "则需要进行尾数调整,"
    },
    {
      "start": 105.93,
      "end": 110.23,
      "text": "也就是将尾数MX至右移移位,"
    },
    {
      "start": 110.23,
      "end": 114.49,
      "text": "相应的将接码EX加1即可,"
    },
    {
      "start": 114.49,
      "end": 119.19,
      "text": "这是因为操作数在运算前是规格化数,"
    },
    {
      "start": 119.19,
      "end": 122.88,
      "text": "因此最多只做一字调整,"
    },
    {
      "start": 122.88,
      "end": 124.88,
      "text": "尾数调整的目的在于,"
    },
    {
      "start": 124.98,
      "end": 128.42,
      "text": "防止伤的尾数出现混乱,"
    },
    {
      "start": 128.42,
      "end": 130.92,
      "text": "在进行接码相见时,"
    },
    {
      "start": 130.92,
      "end": 133.62,
      "text": "才用定点整数减法运算,"
    },
    {
      "start": 133.62,
      "end": 135.52,
      "text": "可能会发生一出,"
    },
    {
      "start": 135.52,
      "end": 138.22,
      "text": "因此因做一出判断,"
    },
    {
      "start": 138.22,
      "end": 141.87,
      "text": "以便通知计算机做一出处理,"
    },
    {
      "start": 141.87,
      "end": 144.27,
      "text": "在进行尾数相除时,"
    },
    {
      "start": 144.27,
      "end": 146.57,
      "text": "才用定点小数除法,"
    },
    {
      "start": 146.57,
      "end": 151.26,
      "text": "运算结果可能需要进行规格化和舍入处理,"
    },
    {
      "start": 151.26,
      "end": 154.16,
      "text": "而规格化和舍入处理,"
    },
    {
      "start": 154.26,
      "end": 157.54,
      "text": "与辅典加减法是相同的,"
    },
    {
      "start": 157.54,
      "end": 160.14,
      "text": "对于HP1754辅典说,"
    },
    {
      "start": 160.14,
      "end": 163.97,
      "text": "接码运算才用以码的运算规则,"
    },
    {
      "start": 163.97,
      "end": 165.47,
      "text": "尾数相除时,"
    },
    {
      "start": 165.47,
      "end": 168.49,
      "text": "隐藏位也要参与运算,"
    },
    {
      "start": 168.49,
      "end": 174.44,
      "text": "才用HP1754的规格化和一出检测与处理方法,"
    },
    {
      "start": 174.44,
      "end": 176.44,
      "text": "需要特别注意的是,"
    },
    {
      "start": 176.44,
      "end": 179.34,
      "text": "HP1754辅典处法运算中,"
    },
    {
      "start": 179.34,
      "end": 182.86,
      "text": "不存在向右规格化操作,"
    },
    {
      "start": 182.86,
      "end": 185.72,
      "text": "不知同学们是否已经发现了,"
    },
    {
      "start": 185.72,
      "end": 188.42,
      "text": "辅典处法运算所涉及到的,"
    },
    {
      "start": 188.42,
      "end": 190.72,
      "text": "定点整数减法运算,"
    },
    {
      "start": 190.72,
      "end": 193.42,
      "text": "定点小数除法运算,"
    },
    {
      "start": 193.42,
      "end": 195.82,
      "text": "辅典加减法的一出判断,"
    },
    {
      "start": 195.82,
      "end": 198.02,
      "text": "规格化和舍入处理,"
    },
    {
      "start": 198.02,
      "end": 200.02,
      "text": "我们在之前的几节课中,"
    },
    {
      "start": 200.02,
      "end": 202.22,
      "text": "都已经学习过了,"
    },
    {
      "start": 202.22,
      "end": 205.18,
      "text": "因此就不再追数了,"
    },
    {
      "start": 205.18,
      "end": 208.58,
      "text": "好的,本节课到这里就结束了,"
    },
    {
      "start": 208.58,
      "end": 211.08,
      "text": "同学们,我们下节课见!"
    }
  ]
}