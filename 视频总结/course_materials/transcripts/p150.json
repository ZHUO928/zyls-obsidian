    },
    {
      "start": 648.71,
      "end": 649.51,
      "text": "好的"
    },
    {
      "start": 649.51,
      "end": 652.21,
      "text": "選項D才是本題的正確答案"
    },
    {
      "start": 652.21,
      "end": 654.81,
      "text": "相信將答案錯選為選項C的同學"
    },
    {
      "start": 654.81,
