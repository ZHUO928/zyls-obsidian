{
  "file": "p049.mp3",
  "duration": 1358.738875,
  "language": "zh",
  "segments": [
    {
      "start": 3.25,
      "end": 7.67,
      "text": "同学们好,欢迎大家来到我的计算机组成员里维克堂"
    },
    {
      "start": 7.67,
      "end": 12.23,
      "text": "本节课,我们介绍主存中数据存放的相关知识"
    },
    {
      "start": 12.23,
      "end": 16.35,
      "text": "分别为,机器自长与存储自长的区别"
    },
    {
      "start": 16.35,
      "end": 18.11,
      "text": "地址访问模式"
    },
    {
      "start": 18.11,
      "end": 20.4,
      "text": "大端和小端方式"
    },
    {
      "start": 20.4,
      "end": 22.53,
      "text": "数据的边界对齐"
    },
    {
      "start": 22.53,
      "end": 26.77,
      "text": "首先来看机器自长与存储自长的区别"
    },
    {
      "start": 26.77,
      "end": 30.12,
      "text": "有关机器自长和存储自长的概念"
    },
    {
      "start": 30.12,
      "end": 32.92,
      "text": "我们在第一章就给同学们介绍过了"
    },
    {
      "start": 33.08,
      "end": 34.64,
      "text": "机器自长是指"
    },
    {
      "start": 34.64,
      "end": 38.51,
      "text": "CPU一次能够处理的二净值数据的位数"
    },
    {
      "start": 38.51,
      "end": 39.95,
      "text": "存储自长是指"
    },
    {
      "start": 39.95,
      "end": 44.67,
      "text": "主存中的一个存储单元所能存储的二净值位数"
    },
    {
      "start": 44.67,
      "end": 49.88,
      "text": "我们在上节课还刚刚回顾过存储自长的概念"
    },
    {
      "start": 49.88,
      "end": 51.44,
      "text": "请同学们注意"
    },
    {
      "start": 51.44,
      "end": 54.8,
      "text": "存储自长与机器自长不一定相同"
    },
    {
      "start": 54.8,
      "end": 58.28,
      "text": "例如,机器自长为32位的计算机"
    },
    {
      "start": 58.28,
      "end": 60.16,
      "text": "所采用的存储自长"
    },
    {
      "start": 60.24,
      "end": 64.44,
      "text": "可以是16位32位或64位"
    },
    {
      "start": 64.44,
      "end": 68.0,
      "text": "接下来我们介绍地址访问模式"
    },
    {
      "start": 68.0,
      "end": 69.24,
      "text": "一般情况下"
    },
    {
      "start": 69.24,
      "end": 72.68,
      "text": "主存是按照字节进行编指的"
    },
    {
      "start": 72.68,
      "end": 74.36,
      "text": "而存储自长"
    },
    {
      "start": 74.36,
      "end": 79.24,
      "text": "也就是主存中的一个存储单元所能存储的二净值位数"
    },
    {
      "start": 79.24,
      "end": 82.08,
      "text": "是字节的二的整数次密辈"
    },
    {
      "start": 82.08,
      "end": 83.76,
      "text": "例如一字节"
    },
    {
      "start": 83.76,
      "end": 84.72,
      "text": "二字节"
    },
    {
      "start": 84.72,
      "end": 86.2,
      "text": "四字节等"
    },
    {
      "start": 86.2,
      "end": 88.04,
      "text": "我们来举例说明"
    },
    {
      "start": 88.04,
      "end": 90.24,
      "text": "假设这是主存的存储体"
    },
    {
      "start": 90.24,
      "end": 92.63,
      "text": "机器所存储的信息"
    },
    {
      "start": 92.63,
      "end": 96.95,
      "text": "途中每个小句型框中的信息为16净值形式"
    },
    {
      "start": 96.95,
      "end": 101.17,
      "text": "因此为8位二净值数借一字节"
    },
    {
      "start": 101.17,
      "end": 103.57,
      "text": "采用16净值形式进行表示"
    },
    {
      "start": 103.57,
      "end": 106.33,
      "text": "是为了方便我们阅读和输线"
    },
    {
      "start": 106.33,
      "end": 108.81,
      "text": "我们对每个字节进行编指"
    },
    {
      "start": 108.81,
      "end": 109.89,
      "text": "对于本例"
    },
    {
      "start": 109.89,
      "end": 113.21,
      "text": "采用4位二净值数进行编指即可"
    },
    {
      "start": 113.21,
      "end": 114.77,
      "text": "需要说明的是"
    },
    {
      "start": 114.77,
      "end": 117.21,
      "text": "这里采用二净值数进行编指"
    },
    {
      "start": 117.21,
      "end": 119.65,
      "text": "而没有采用16净值形式"
    },
    {
      "start": 119.69,
      "end": 121.49,
      "text": "是为了本节课后续内容"
    },
    {
      "start": 121.49,
      "end": 123.44,
      "text": "同学们容易理解"
    },
    {
      "start": 123.44,
      "end": 126.84,
      "text": "实际上当主存的容量再大一些时"
    },
    {
      "start": 126.84,
      "end": 128.96,
      "text": "按字节进行编指时"
    },
    {
      "start": 128.96,
      "end": 132.12,
      "text": "所需的二净值数的位数就比较大了"
    },
    {
      "start": 132.12,
      "end": 135.12,
      "text": "对于阅读和输线都不方便"
    },
    {
      "start": 135.12,
      "end": 139.08,
      "text": "因此往往也采用16净值形式"
    },
    {
      "start": 139.08,
      "end": 141.56,
      "text": "若将途中的每一个小句型框"
    },
    {
      "start": 141.56,
      "end": 143.88,
      "text": "看作是一个存储单元"
    },
    {
      "start": 143.88,
      "end": 146.81,
      "text": "则存储自常为一字节"
    },
    {
      "start": 146.81,
      "end": 149.65,
      "text": "若将途中每两个小句型框"
    },
    {
      "start": 149.65,
      "end": 151.93,
      "text": "看作是一个存储单元"
    },
    {
      "start": 151.93,
      "end": 154.45,
      "text": "则存储自常为两字节"
    },
    {
      "start": 154.45,
      "end": 158.52,
      "text": "也就是16位也称为半字"
    },
    {
      "start": 158.52,
      "end": 161.12,
      "text": "若将途中每四个小句型框"
    },
    {
      "start": 161.12,
      "end": 163.36,
      "text": "看作是一个存储单元"
    },
    {
      "start": 163.36,
      "end": 165.84,
      "text": "则存储自常为四字节"
    },
    {
      "start": 165.84,
      "end": 169.46,
      "text": "也就是32位也称为字"
    },
    {
      "start": 169.46,
      "end": 172.5,
      "text": "以机器自常为32位的计算机为例"
    },
    {
      "start": 172.5,
      "end": 176.1,
      "text": "对主存的访问既可以按字节访问"
    },
    {
      "start": 176.1,
      "end": 178.7,
      "text": "也可以按16位半字访问"
    },
    {
      "start": 178.7,
      "end": 181.69,
      "text": "还可以按32位自访问"
    },
    {
      "start": 181.69,
      "end": 185.76,
      "text": "因此可将主存地址分为字节地址"
    },
    {
      "start": 185.76,
      "end": 187.41,
      "text": "半字地址"
    },
    {
      "start": 187.41,
      "end": 189.12,
      "text": "字地址"
    },
    {
      "start": 189.12,
      "end": 191.6,
      "text": "若对主存按字节访问"
    },
    {
      "start": 191.6,
      "end": 193.44,
      "text": "则所使用的字节地址"
    },
    {
      "start": 193.44,
      "end": 197.11,
      "text": "就是主存按字节编址的字节地址"
    },
    {
      "start": 197.11,
      "end": 200.07,
      "text": "若对主存按16位半字访问"
    },
    {
      "start": 200.07,
      "end": 202.59,
      "text": "则所使用的是半字地址"
    },
    {
      "start": 202.59,
      "end": 211.02,
      "text": "本例中的半字地址如读所示"
    },
    {
      "start": 211.02,
      "end": 213.94,
      "text": "若对主存按32位自访问"
    },
    {
      "start": 213.94,
      "end": 216.6,
      "text": "则所使用的是字地址"
    },
    {
      "start": 216.6,
      "end": 223.91,
      "text": "本例中的字地址如读所示"
    },
    {
      "start": 223.91,
      "end": 226.15,
      "text": "通过本例还可以发现"
    },
    {
      "start": 226.15,
      "end": 229.07,
      "text": "将字节地址逻辑右移移位"
    },
    {
      "start": 229.07,
      "end": 231.03,
      "text": "即可得到半字地址"
    },
    {
      "start": 231.03,
      "end": 234.68,
      "text": "逻辑右移两位即可得到字地址"
    },
    {
      "start": 234.68,
      "end": 237.44,
      "text": "例如本例中的这个字节地址"
    },
    {
      "start": 237.44,
      "end": 239.04,
      "text": "逻辑右移移位"
    },
    {
      "start": 239.04,
      "end": 241.4,
      "text": "即可得到这个半字地址"
    },
    {
      "start": 241.4,
      "end": 244.2,
      "text": "而将这个半字地址逻辑右移移位"
    },
    {
      "start": 244.2,
      "end": 246.24,
      "text": "即可得到这个字地址"
    },
    {
      "start": 246.28,
      "end": 249.84,
      "text": "这也相当于将字节地址逻辑右移两位"
    },
    {
      "start": 249.84,
      "end": 251.82,
      "text": "得到字地址"
    },
    {
      "start": 251.82,
      "end": 253.58,
      "text": "接下来我们给出一个"
    },
    {
      "start": 253.58,
      "end": 256.14,
      "text": "使用InterX86会边语言"
    },
    {
      "start": 256.14,
      "end": 258.62,
      "text": "访问左侧所示的主存庄"
    },
    {
      "start": 258.62,
      "end": 260.58,
      "text": "不同存储单元的例子"
    },
    {
      "start": 260.58,
      "end": 263.5,
      "text": "以加深同学们对按字节访问"
    },
    {
      "start": 263.5,
      "end": 265.22,
      "text": "按16位半字访问"
    },
    {
      "start": 265.22,
      "end": 267.66,
      "text": "按32位自访问的理解"
    },
    {
      "start": 267.66,
      "end": 269.26,
      "text": "为了简单起见"
    },
    {
      "start": 269.26,
      "end": 273.04,
      "text": "我们假设数据段计存器DS的值为0"
    },
    {
      "start": 273.04,
      "end": 276.16,
      "text": "没有学习过InterX86会边语言的同学"
    },
    {
      "start": 276.16,
      "end": 277.64,
      "text": "也不用担心"
    },
    {
      "start": 277.64,
      "end": 280.2,
      "text": "我们会对本地中的每条语句的功能"
    },
    {
      "start": 280.2,
      "end": 281.98,
      "text": "做出解释"
    },
    {
      "start": 281.98,
      "end": 283.9,
      "text": "这是第一条语句"
    },
    {
      "start": 283.9,
      "end": 285.14,
      "text": "它的作用是"
    },
    {
      "start": 285.14,
      "end": 287.18,
      "text": "将地址零X4开始的"
    },
    {
      "start": 287.18,
      "end": 289.1,
      "text": "一字节存储单元的内容"
    },
    {
      "start": 289.1,
      "end": 291.92,
      "text": "送入8位计存器Al"
    },
    {
      "start": 291.92,
      "end": 294.4,
      "text": "地址零X4中的零X"
    },
    {
      "start": 294.4,
      "end": 296.08,
      "text": "实际上是零X4"
    },
    {
      "start": 296.08,
      "end": 298.44,
      "text": "只是读起来方便"
    },
    {
      "start": 298.44,
      "end": 300.92,
      "text": "在InterX86会边语言中"
    },
    {
      "start": 300.92,
      "end": 303.62,
      "text": "表示这是16进之数"
    },
    {
      "start": 303.62,
      "end": 306.5,
      "text": "因此其相应的二进之形式为"
    },
    {
      "start": 306.5,
      "end": 308.37,
      "text": "0100"
    },
    {
      "start": 308.37,
      "end": 311.45,
      "text": "这是该地址对应的存储单元"
    },
    {
      "start": 311.45,
      "end": 314.2,
      "text": "其存储的信息为00"
    },
    {
      "start": 314.2,
      "end": 316.8,
      "text": "因此这条语记执行号"
    },
    {
      "start": 316.8,
      "end": 319.9,
      "text": "计存器Al的内容为00"
    },
    {
      "start": 319.9,
      "end": 321.82,
      "text": "这是第二条语句"
    },
    {
      "start": 321.82,
      "end": 323.02,
      "text": "它的作用是"
    },
    {
      "start": 323.02,
      "end": 324.94,
      "text": "将地址零X4开始的"
    },
    {
      "start": 324.94,
      "end": 327.06,
      "text": "两字节存储单元的内容"
    },
    {
      "start": 327.06,
      "end": 330.47,
      "text": "送入16位计存器AX"
    },
    {
      "start": 330.47,
      "end": 334.15,
      "text": "地址零X4的二进之形式为00"
    },
    {
      "start": 334.15,
      "end": 337.44,
      "text": "这是该地址所定的字节单元"
    },
    {
      "start": 337.48,
      "end": 339.6,
      "text": "由于这条语句访问的是"
    },
    {
      "start": 339.6,
      "end": 342.36,
      "text": "有两字节构成的存储单元"
    },
    {
      "start": 342.36,
      "end": 344.48,
      "text": "因此该字节单元后的"
    },
    {
      "start": 344.48,
      "end": 347.34,
      "text": "这个字节单元也被访问"
    },
    {
      "start": 347.34,
      "end": 348.62,
      "text": "从上所说"
    },
    {
      "start": 348.62,
      "end": 350.3,
      "text": "这条语句执行号"
    },
    {
      "start": 350.3,
      "end": 354.05,
      "text": "计存器AX的内容为EF00"
    },
    {
      "start": 354.05,
      "end": 356.05,
      "text": "这是第三条语句"
    },
    {
      "start": 356.05,
      "end": 357.25,
      "text": "它的作用是"
    },
    {
      "start": 357.25,
      "end": 358.97,
      "text": "将地址零X4开始的"
    },
    {
      "start": 358.97,
      "end": 361.09,
      "text": "四字节存储单元的内容"
    },
    {
      "start": 361.09,
      "end": 364.48,
      "text": "送入32位计存器EAX"
    },
    {
      "start": 364.48,
      "end": 368.1,
      "text": "地址零X4的二进之形式为00"
    },
    {
      "start": 368.1,
      "end": 371.45,
      "text": "这是该地址所对应的字节单元"
    },
    {
      "start": 371.45,
      "end": 373.21,
      "text": "由于这条语句访问的是"
    },
    {
      "start": 373.21,
      "end": 375.93,
      "text": "有四字节构成的存储单元"
    },
    {
      "start": 375.93,
      "end": 378.05,
      "text": "因此该字节单元后的"
    },
    {
      "start": 378.05,
      "end": 381.36,
      "text": "这三个字节单元也被访问"
    },
    {
      "start": 381.36,
      "end": 382.64,
      "text": "从上所说"
    },
    {
      "start": 382.64,
      "end": 384.28,
      "text": "这条语句执行号"
    },
    {
      "start": 384.28,
      "end": 389.02,
      "text": "计存器EAX的内容为ABCDEF00"
    },
    {
      "start": 389.02,
      "end": 391.1,
      "text": "从上述程序可以看出"
    },
    {
      "start": 391.1,
      "end": 392.58,
      "text": "对于字节访问"
    },
    {
      "start": 392.58,
      "end": 393.58,
      "text": "半字访问"
    },
    {
      "start": 393.58,
      "end": 394.46,
      "text": "字访问"
    },
    {
      "start": 394.46,
      "end": 397.14,
      "text": "这三种不同的地址访问模式"
    },
    {
      "start": 397.18,
      "end": 399.02,
      "text": "所使用的主存地址"
    },
    {
      "start": 399.02,
      "end": 401.7,
      "text": "实际上都是字节地址"
    },
    {
      "start": 401.7,
      "end": 402.5,
      "text": "会边指令"
    },
    {
      "start": 402.5,
      "end": 406.1,
      "text": "对会边程序会边程相应的机器指令"
    },
    {
      "start": 406.1,
      "end": 408.9,
      "text": "CPU在执行机器指令时"
    },
    {
      "start": 408.9,
      "end": 410.14,
      "text": "可将字节地址的"
    },
    {
      "start": 410.14,
      "end": 413.16,
      "text": "第两位用于访问控制"
    },
    {
      "start": 413.16,
      "end": 415.72,
      "text": "假设存储制成为32位"
    },
    {
      "start": 415.72,
      "end": 419.08,
      "text": "也就是存储单元由四字节构成"
    },
    {
      "start": 419.08,
      "end": 423.16,
      "text": "当机器指令只是采用字节访问模式时"
    },
    {
      "start": 423.16,
      "end": 424.2,
      "text": "则字节地址的"
    },
    {
      "start": 424.2,
      "end": 427.04,
      "text": "第两位用于选择存储单元中的"
    },
    {
      "start": 427.04,
      "end": 428.84,
      "text": "哪一个字节"
    },
    {
      "start": 428.84,
      "end": 432.64,
      "text": "当机器指令只是采用半字访问模式时"
    },
    {
      "start": 432.64,
      "end": 434.92,
      "text": "则字节地址的倒数第二位"
    },
    {
      "start": 434.92,
      "end": 438.32,
      "text": "用于选择存储单元中的哪个半字"
    },
    {
      "start": 438.32,
      "end": 442.72,
      "text": "例如对于这个由四字节构成的存储单元"
    },
    {
      "start": 442.72,
      "end": 444.96,
      "text": "若采用字节访问模式"
    },
    {
      "start": 444.96,
      "end": 446.88,
      "text": "则字节地址的第两位"
    },
    {
      "start": 446.88,
      "end": 450.59,
      "text": "用于选择该存储单元中的某一个字节"
    },
    {
      "start": 450.59,
      "end": 452.87,
      "text": "若采用半字访问模式"
    },
    {
      "start": 452.87,
      "end": 455.11,
      "text": "则字节地址的倒数第二位"
    },
    {
      "start": 455.11,
      "end": 459.03,
      "text": "用于选择存储单元中的某一个半字"
    },
    {
      "start": 459.03,
      "end": 460.27,
      "text": "对于本地"
    },
    {
      "start": 460.27,
      "end": 463.55,
      "text": "可能有的同学还会产生这样的疑问"
    },
    {
      "start": 463.55,
      "end": 467.39,
      "text": "例如这是第三条语句的执行结果"
    },
    {
      "start": 467.39,
      "end": 472.69,
      "text": "它为什么不是另外这种形式呢"
    },
    {
      "start": 472.69,
      "end": 476.92,
      "text": "这样我们就引出了大端和小端方式"
    },
    {
      "start": 476.92,
      "end": 481.84,
      "text": "我们将左侧由下至上的主存内容和相应的字节地址"
    },
    {
      "start": 481.84,
      "end": 487.08,
      "text": "化成水平方式如足所示"
    },
    {
      "start": 487.08,
      "end": 490.76,
      "text": "这是主存地址的增长方向"
    },
    {
      "start": 490.76,
      "end": 494.45,
      "text": "这是第三条语句的执行结果"
    },
    {
      "start": 494.45,
      "end": 499.97,
      "text": "可以发现数据的低字节保存在主存的低地址中"
    },
    {
      "start": 499.97,
      "end": 504.52,
      "text": "而数据的高字节保存在主存的高地址中"
    },
    {
      "start": 504.52,
      "end": 507.47,
      "text": "这就是所谓的小端方式"
    },
    {
      "start": 507.47,
      "end": 509.59,
      "text": "若换成这种形式"
    },
    {
      "start": 509.59,
      "end": 514.08,
      "text": "则数据的低字节保存在主存的高地址中"
    },
    {
      "start": 514.08,
      "end": 518.48,
      "text": "而数据的高字节保存在主存的低地址中"
    },
    {
      "start": 518.48,
      "end": 521.36,
      "text": "这就是所谓的大端方式"
    },
    {
      "start": 521.36,
      "end": 525.16,
      "text": "由于本力采用的是英特尔X86处理器架构"
    },
    {
      "start": 525.16,
      "end": 528.88,
      "text": "其采用小端方式进行数据存放"
    },
    {
      "start": 528.88,
      "end": 533.43,
      "text": "因此不会得到大端方式进行数据存放的结果"
    },
    {
      "start": 533.43,
      "end": 537.72,
      "text": "接下来我们对比一下小端和大端方式"
    },
    {
      "start": 537.72,
      "end": 540.88,
      "text": "上面这种情况就是小端方式"
    },
    {
      "start": 540.88,
      "end": 545.76,
      "text": "也就是将数据的低字节保存在主存的低地址中"
    },
    {
      "start": 545.76,
      "end": 550.24,
      "text": "而数据的高字节保存在主存的高地址中"
    },
    {
      "start": 550.24,
      "end": 556.78,
      "text": "这样可以将主存地址的高低与数据的未全有效的结合起来"
    },
    {
      "start": 556.78,
      "end": 560.02,
      "text": "高地址存储的数据部分的全值高"
    },
    {
      "start": 560.02,
      "end": 563.26,
      "text": "低地址存储的数据部分的全值低"
    },
    {
      "start": 563.26,
      "end": 565.01,
      "text": "符合逻辑"
    },
    {
      "start": 565.01,
      "end": 568.09,
      "text": "下面这种情况就是大端方式"
    },
    {
      "start": 568.09,
      "end": 572.93,
      "text": "也就是将数据的高字节保存在主存的低地址中"
    },
    {
      "start": 572.93,
      "end": 577.29,
      "text": "而数据的低字节保存在主存的高地址中"
    },
    {
      "start": 577.29,
      "end": 580.61,
      "text": "这样符合人类的正常思维"
    },
    {
      "start": 580.61,
      "end": 582.97,
      "text": "请同学们注意"
    },
    {
      "start": 582.97,
      "end": 586.93,
      "text": "上述两种方式并没有绝对的优劣之分"
    },
    {
      "start": 586.93,
      "end": 593.72,
      "text": "他们在不同的处理器架构和应用场景中都有各自的适用性和优势"
    },
    {
      "start": 593.72,
      "end": 601.56,
      "text": "例如英特尔X86,I-64,Risk 5等处理器采用的就是小端方式"
    },
    {
      "start": 601.56,
      "end": 605.16,
      "text": "而PowerPC处理器采用大端方式"
    },
    {
      "start": 605.16,
      "end": 611.32,
      "text": "AM、NiPS等处理器同时支持大端方式和小端方式"
    },
    {
      "start": 611.32,
      "end": 612.72,
      "text": "除处理器外"
    },
    {
      "start": 612.72,
      "end": 616.04,
      "text": "大小端方式还设计外部设备设计"
    },
    {
      "start": 616.04,
      "end": 617.44,
      "text": "网络数据传输"
    },
    {
      "start": 617.44,
      "end": 619.78,
      "text": "音视频文件保存等"
    },
    {
      "start": 619.78,
      "end": 621.98,
      "text": "小端与大端方式的区别"
    },
    {
      "start": 621.98,
      "end": 625.9,
      "text": "不仅存在于处理器的计存器存主器中"
    },
    {
      "start": 625.9,
      "end": 632.22,
      "text": "在指令级,系统总线等各个层次中也可能存在差别"
    },
    {
      "start": 632.22,
      "end": 636.42,
      "text": "接下来,给同学们介绍本节课的最后一部分内容"
    },
    {
      "start": 636.42,
      "end": 639.1,
      "text": "也就是数据的边界对齐"
    },
    {
      "start": 639.1,
      "end": 643.56,
      "text": "我们知道,主存空间一般按字节进行编织"
    },
    {
      "start": 643.56,
      "end": 649.25,
      "text": "高级研中不同数据类型的辨量所包含的字节数量可能不同"
    },
    {
      "start": 649.25,
      "end": 652.93,
      "text": "编译器在为这些辨量分配主存空间时"
    },
    {
      "start": 652.93,
      "end": 657.87,
      "text": "理论上可以从主存空间的任何一个字节地址开始"
    },
    {
      "start": 657.87,
      "end": 665.67,
      "text": "然而,当一个多字节辨量被编译器分布在不同的32位字存储单元中时"
    },
    {
      "start": 665.67,
      "end": 669.43,
      "text": "方论该辨量就需要多个存取周期"
    },
    {
      "start": 669.43,
      "end": 672.51,
      "text": "因此,为了提高数据访问效率"
    },
    {
      "start": 672.51,
      "end": 678.35,
      "text": "应该考虑数据辨量、数据结构在主存空间中的边界对齐问题"
    },
    {
      "start": 678.35,
      "end": 680.07,
      "text": "我们来举例说明"
    },
    {
      "start": 680.07,
      "end": 682.99,
      "text": "假设存储自长为32位"
    },
    {
      "start": 682.99,
      "end": 687.15,
      "text": "给C原不同数据类型的辨量分配主存空间"
    },
    {
      "start": 687.23,
      "end": 691.91,
      "text": "这是C原中各种数据类型所对应的存储大项"
    },
    {
      "start": 691.91,
      "end": 693.55,
      "text": "单位为字节"
    },
    {
      "start": 693.55,
      "end": 698.95,
      "text": "我们在第二章的C原中的数据类型及转换那些课中"
    },
    {
      "start": 698.95,
      "end": 700.55,
      "text": "曾给同学们介绍过"
    },
    {
      "start": 700.55,
      "end": 703.29,
      "text": "希望同学们能熟练掌握"
    },
    {
      "start": 703.29,
      "end": 705.89,
      "text": "我们划出本利的主存空间"
    },
    {
      "start": 705.89,
      "end": 708.61,
      "text": "每个小的巨型框为一字节"
    },
    {
      "start": 708.61,
      "end": 714.04,
      "text": "一行由四个小的巨型框构成了四字节的存储单元"
    },
    {
      "start": 714.12,
      "end": 718.24,
      "text": "这是因为本利给定存储自长为32位"
    },
    {
      "start": 718.24,
      "end": 720.56,
      "text": "也就是四字节"
    },
    {
      "start": 720.56,
      "end": 726.48,
      "text": "这里我们采用实净制数给主存空间的每个字节进行编织"
    },
    {
      "start": 726.48,
      "end": 729.0,
      "text": "目的是为了方便同学们理解"
    },
    {
      "start": 729.0,
      "end": 733.06,
      "text": "但实践中往往采用16净制形式"
    },
    {
      "start": 733.06,
      "end": 738.45,
      "text": "另外一般只给出每个存储单元的第一个字节的地址即可"
    },
    {
      "start": 738.45,
      "end": 741.23,
      "text": "首先来看这种分配方案"
    },
    {
      "start": 741.27,
      "end": 745.91,
      "text": "将字节地址00-03共四个连续的字节"
    },
    {
      "start": 745.91,
      "end": 748.68,
      "text": "分配给硬的形变量A"
    },
    {
      "start": 748.68,
      "end": 753.6,
      "text": "将字节地址04-05共两个连续的字节"
    },
    {
      "start": 753.6,
      "end": 756.39,
      "text": "分配给12的形变量B"
    },
    {
      "start": 756.39,
      "end": 761.39,
      "text": "将字节地址06-13共8个连续的字节"
    },
    {
      "start": 761.39,
      "end": 764.16,
      "text": "分配给w形变量C"
    },
    {
      "start": 764.16,
      "end": 767.64,
      "text": "将字节地址为14的这一个字节"
    },
    {
      "start": 767.64,
      "end": 770.3,
      "text": "分配给x形变量D"
    },
    {
      "start": 770.34,
      "end": 775.14,
      "text": "将字节地址15-16共两个连续的字节"
    },
    {
      "start": 775.14,
      "end": 777.85,
      "text": "分配给12的形变量E"
    },
    {
      "start": 777.85,
      "end": 780.45,
      "text": "再来看另外一种分配方案"
    },
    {
      "start": 780.45,
      "end": 784.65,
      "text": "将字节地址00-03共四个连续的字节"
    },
    {
      "start": 784.65,
      "end": 787.16,
      "text": "分配给硬的形变量A"
    },
    {
      "start": 787.16,
      "end": 791.8,
      "text": "将字节地址04-05共两个连续的字节"
    },
    {
      "start": 791.8,
      "end": 794.42,
      "text": "分配给12的形变量D"
    },
    {
      "start": 794.42,
      "end": 799.26,
      "text": "将字节地址08-15共8个连续的字节"
    },
    {
      "start": 799.26,
      "end": 801.96,
      "text": "分配给w形变量C"
    },
    {
      "start": 801.96,
      "end": 805.12,
      "text": "将字节地址为16的这一个字节"
    },
    {
      "start": 805.12,
      "end": 807.76,
      "text": "分配给x形变量D"
    },
    {
      "start": 807.76,
      "end": 812.52,
      "text": "将字节地址18-19共两个连续的字节"
    },
    {
      "start": 812.52,
      "end": 815.36,
      "text": "分配给12的形变量E"
    },
    {
      "start": 815.36,
      "end": 817.52,
      "text": "对于上面这种分配方案"
    },
    {
      "start": 817.52,
      "end": 821.03,
      "text": "就是数据的边界为对齐的情况"
    },
    {
      "start": 821.03,
      "end": 822.23,
      "text": "不难发现"
    },
    {
      "start": 822.23,
      "end": 826.23,
      "text": "这种分配方案对存储空间的利用率最高"
    },
    {
      "start": 826.23,
      "end": 829.45,
      "text": "但是存在访问性的问题"
    },
    {
      "start": 829.45,
      "end": 832.21,
      "text": "例如变量C的8个字节"
    },
    {
      "start": 832.21,
      "end": 835.49,
      "text": "分布在三个存储单元中"
    },
    {
      "start": 835.49,
      "end": 840.41,
      "text": "因此访问该变量的就需要三个存取周期"
    },
    {
      "start": 840.41,
      "end": 841.93,
      "text": "变量E的两个字节"
    },
    {
      "start": 841.93,
      "end": 844.73,
      "text": "分布在两个存储单元中"
    },
    {
      "start": 844.73,
      "end": 849.4,
      "text": "因此访问该变量需要两个存取周期"
    },
    {
      "start": 849.4,
      "end": 854.41,
      "text": "而下面这种方案就是数据的边界对齐的情况"
    },
    {
      "start": 854.41,
      "end": 858.32,
      "text": "这种分配方案有效提升了访问性能"
    },
    {
      "start": 858.32,
      "end": 861.08,
      "text": "例如变量C的8个字节"
    },
    {
      "start": 861.08,
      "end": 863.92,
      "text": "分布在两个存储单元中"
    },
    {
      "start": 863.92,
      "end": 868.37,
      "text": "因此访问该变量需要两个存取周期"
    },
    {
      "start": 868.37,
      "end": 869.81,
      "text": "变量E的两个字节"
    },
    {
      "start": 869.81,
      "end": 872.53,
      "text": "分布在一个存储单元中"
    },
    {
      "start": 872.53,
      "end": 877.4,
      "text": "因此访问该变量需要一个存取周期"
    },
    {
      "start": 877.4,
      "end": 879.4,
      "text": "但我们也不能发现"
    },
    {
      "start": 879.4,
      "end": 883.36,
      "text": "这种分配方案会造成存储空间的浪费"
    },
    {
      "start": 883.36,
      "end": 885.38,
      "text": "需要折中考虑"
    },
    {
      "start": 885.38,
      "end": 887.34,
      "text": "目前主流的编译器"
    },
    {
      "start": 887.38,
      "end": 889.9,
      "text": "会采用边界对齐的方案"
    },
    {
      "start": 889.9,
      "end": 892.94,
      "text": "不仅对数据变量进行边界对齐"
    },
    {
      "start": 892.94,
      "end": 897.29,
      "text": "还会对复杂的数据结构进行边界对齐"
    },
    {
      "start": 897.29,
      "end": 898.45,
      "text": "通过本例"
    },
    {
      "start": 898.45,
      "end": 901.67,
      "text": "我们可以给出边界对齐的规则"
    },
    {
      "start": 901.67,
      "end": 903.31,
      "text": "对于字节数据"
    },
    {
      "start": 903.31,
      "end": 905.87,
      "text": "其不存在边界对齐的问题"
    },
    {
      "start": 905.87,
      "end": 909.79,
      "text": "因为主存空间一般都是按字节编指的"
    },
    {
      "start": 909.79,
      "end": 913.15,
      "text": "例如本例中的一字节差行变量D"
    },
    {
      "start": 913.15,
      "end": 916.28,
      "text": "可以存储在任意字节单元"
    },
    {
      "start": 916.28,
      "end": 917.68,
      "text": "对于半字"
    },
    {
      "start": 917.68,
      "end": 920.04,
      "text": "也就是两个字节的数据"
    },
    {
      "start": 920.04,
      "end": 923.44,
      "text": "其齐使字节地址的最低意外为0"
    },
    {
      "start": 923.44,
      "end": 926.48,
      "text": "也就是地址是二的整数倍"
    },
    {
      "start": 926.48,
      "end": 930.0,
      "text": "例如本例中的两字节差行变量B"
    },
    {
      "start": 930.0,
      "end": 932.4,
      "text": "其齐使字节地址04"
    },
    {
      "start": 932.4,
      "end": 934.6,
      "text": "转换成二进字可以看出"
    },
    {
      "start": 934.6,
      "end": 936.99,
      "text": "其最低意外为0"
    },
    {
      "start": 936.99,
      "end": 940.71,
      "text": "又例如本例中的两字节差行变量E"
    },
    {
      "start": 940.71,
      "end": 943.15,
      "text": "其齐使字节地址18"
    },
    {
      "start": 943.15,
      "end": 945.59,
      "text": "转换成二进字可以看出"
    },
    {
      "start": 945.67,
      "end": 948.32,
      "text": "其最低意外为0"
    },
    {
      "start": 948.32,
      "end": 949.48,
      "text": "对于单字"
    },
    {
      "start": 949.48,
      "end": 951.48,
      "text": "也就是四字节数据"
    },
    {
      "start": 951.48,
      "end": 954.92,
      "text": "其齐使字节地址的最低两位为0"
    },
    {
      "start": 954.92,
      "end": 957.68,
      "text": "也就是地址是四的整数倍"
    },
    {
      "start": 957.68,
      "end": 961.36,
      "text": "例如本例中的四字节硬的行变量A"
    },
    {
      "start": 961.36,
      "end": 963.68,
      "text": "其齐使字节地址00"
    },
    {
      "start": 963.68,
      "end": 965.8,
      "text": "转换成二进字可以看出"
    },
    {
      "start": 965.8,
      "end": 968.58,
      "text": "其最低两位为0"
    },
    {
      "start": 968.58,
      "end": 969.78,
      "text": "对于双字"
    },
    {
      "start": 969.78,
      "end": 971.9,
      "text": "也就是八字节数据"
    },
    {
      "start": 971.9,
      "end": 975.9,
      "text": "其齐使字节地址的最低三位为0"
    },
    {
      "start": 975.9,
      "end": 978.98,
      "text": "也就是地址是八的整数倍"
    },
    {
