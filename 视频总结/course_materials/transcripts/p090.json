      "text": "送入32位通用寄存器EAX"
    },
    {
      "start": 413.74,
      "end": 416.85,
      "text": "再来看间接寻止方式"
    },
    {
      "start": 416.93,
      "end": 419.41,
      "text": "指令中的寻止方式自断的值"
    },
    {
      "start": 419.41,
      "end": 420.85,
      "text": "就是用来表明"
    },
    {
      "start": 420.85,
      "end": 423.17,
      "text": "间接寻止方式的特征码"
    },
    {
      "start": 423.17,
      "end": 425.14,
