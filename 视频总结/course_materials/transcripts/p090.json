{
  "file": "p090.mp3",
  "duration": 838.240375,
  "language": "zh",
  "segments": [
    {
      "start": 3.38,
      "end": 7.54,
      "text": "同学们好,欢迎大家来到我的计算机组成员里维克堂"
    },
    {
      "start": 7.54,
      "end": 11.14,
      "text": "从本节课开始,我们要用两词课的时间"
    },
    {
      "start": 11.14,
      "end": 14.9,
      "text": "给同学们介绍以下这些操作术寻止方式"
    },
    {
      "start": 15.54,
      "end": 18.42,
      "text": "通过前两词课的学习,我们知道"
    },
    {
      "start": 18.42,
      "end": 24.5,
      "text": "不同指令可能采用不同的操作术寻止方式来获取操作术"
    },
    {
      "start": 24.5,
      "end": 30.34,
      "text": "因此,可将指令格式中的地址码自断划分为以下两个部分"
    },
    {
      "start": 30.53,
      "end": 35.73,
      "text": "一部分是寻止方式,也称为寻止特征自断"
    },
    {
      "start": 35.73,
      "end": 40.9,
      "text": "用大写字母M表示,另一部分是形式地址自断"
    },
    {
      "start": 40.9,
      "end": 44.83,
      "text": "用大写字母D来表示,如读所示"
    },
    {
      "start": 44.83,
      "end": 49.23,
      "text": "这是我们之前给同学们介绍过的指令的一般格式"
    },
    {
      "start": 49.23,
      "end": 52.75,
      "text": "由操作码和地址码两个自断构成"
    },
    {
      "start": 52.75,
      "end": 55.38,
      "text": "将操作码自断保持不变"
    },
    {
      "start": 55.38,
      "end": 60.26,
      "text": "地址码自断划分为寻止方式自断和形式地址自断"
    },
    {
      "start": 60.56,
      "end": 65.92,
      "text": "这样就构成了含有寻止方式的单地址指令格式"
    },
    {
      "start": 65.92,
      "end": 72.29,
      "text": "寻止方式自断的位数取决于所要支持不同寻止方式的数量"
    },
    {
      "start": 72.29,
      "end": 74.21,
      "text": "操作术寻止的过程"
    },
    {
      "start": 74.21,
      "end": 78.93,
      "text": "实际上就是把寻止方式和形式地址的不同组合"
    },
    {
      "start": 78.93,
      "end": 82.69,
      "text": "转换成操作术的有效地址的过程"
    },
    {
      "start": 82.69,
      "end": 85.25,
      "text": "在同学们了解了上述概念后"
    },
    {
      "start": 85.25,
      "end": 88.05,
      "text": "本节课我们给同学们介绍"
    },
    {
      "start": 88.21,
      "end": 92.29,
      "text": "左侧这些操作术寻止方式装比较简单的五个"
    },
    {
      "start": 92.29,
      "end": 95.15,
      "text": "首先来看立即寻止方式"
    },
    {
      "start": 95.15,
      "end": 98.98,
      "text": "指令中的寻止方式自断的值"
    },
    {
      "start": 98.98,
      "end": 102.42,
      "text": "就是用来表明立即寻止方式的特征码"
    },
    {
      "start": 102.42,
      "end": 104.29,
      "text": "例如明明明"
    },
    {
      "start": 104.29,
      "end": 107.65,
      "text": "这表明指令中形式地址自断的值"
    },
    {
      "start": 107.65,
      "end": 109.33,
      "text": "就是操作术本身"
    },
    {
      "start": 109.33,
      "end": 110.99,
      "text": "从上所述"
    },
    {
      "start": 110.99,
      "end": 112.91,
      "text": "在立即寻止方式下"
    },
    {
      "start": 112.91,
      "end": 116.99,
      "text": "操作术与指令是一起存放在主存中的"
    },
    {
      "start": 116.99,
      "end": 118.99,
      "text": "例如下属所示"
    },
    {
      "start": 119.15,
      "end": 123.23,
      "text": "这是主存中存放的某条立即寻止指令"
    },
    {
      "start": 123.23,
      "end": 128.27,
      "text": "可以看到操作术与指令是一起存放在主存中的"
    },
    {
      "start": 128.27,
      "end": 129.74,
      "text": "因此可知"
    },
    {
      "start": 129.74,
      "end": 131.42,
      "text": "在取指令时"
    },
    {
      "start": 131.42,
      "end": 134.14,
      "text": "操作术随指令一起被读取"
    },
    {
      "start": 134.14,
      "end": 137.74,
      "text": "并送到CPU内的指令寄存器IR中"
    },
    {
      "start": 137.74,
      "end": 139.81,
      "text": "在指令执行时"
    },
    {
      "start": 139.81,
      "end": 143.65,
      "text": "直接从指令寄存器IR中获取操作术"
    },
    {
      "start": 143.65,
      "end": 146.61,
      "text": "而无需访问其他存储单元"
    },
    {
      "start": 146.94,
      "end": 148.14,
      "text": "从上所述"
    },
    {
      "start": 148.14,
      "end": 150.78,
      "text": "可以得到立即寻止方式的特点"
    },
    {
      "start": 150.78,
      "end": 153.74,
      "text": "那就是取操作术快"
    },
    {
      "start": 153.74,
      "end": 156.62,
      "text": "但形式地址自断的位宽有限"
    },
    {
      "start": 156.62,
      "end": 159.7,
      "text": "限制了操作术的表示范围"
    },
    {
      "start": 159.7,
      "end": 160.98,
      "text": "立即寻止方式"
    },
    {
      "start": 160.98,
      "end": 164.0,
      "text": "一般用于给辨量付出值"
    },
    {
      "start": 164.0,
      "end": 164.88,
      "text": "例如"
    },
    {
      "start": 164.88,
      "end": 166.72,
      "text": "这是InternX86中"
    },
    {
      "start": 166.72,
      "end": 169.79,
      "text": "才用立即寻止方式的指令举例"
    },
    {
      "start": 169.79,
      "end": 173.15,
      "text": "将16进至立即数5132408"
    },
    {
      "start": 173.15,
      "end": 177.07,
      "text": "送入了32位通用寄存器EAX"
    },
    {
      "start": 177.15,
      "end": 179.95,
      "text": "也许有的同学已经看出来了"
    },
    {
      "start": 179.95,
      "end": 181.15,
      "text": "这条指令中"
    },
    {
      "start": 181.15,
      "end": 184.35,
      "text": "包含了高老师对大家的祝福"
    },
    {
      "start": 184.35,
      "end": 185.15,
      "text": "好的"
    },
    {
      "start": 185.15,
      "end": 187.97,
      "text": "再来看直接寻止方式"
    },
    {
      "start": 187.97,
      "end": 190.45,
      "text": "指令中的寻止方式自断的值"
    },
    {
      "start": 190.45,
      "end": 191.73,
      "text": "就是用来表明"
    },
    {
      "start": 191.73,
      "end": 193.81,
      "text": "直接寻止方式的特征码"
    },
    {
      "start": 193.81,
      "end": 195.63,
      "text": "例如001"
    },
    {
      "start": 195.63,
      "end": 196.59,
      "text": "这表明"
    },
    {
      "start": 196.59,
      "end": 198.83,
      "text": "指令中形式地址自断的值"
    },
    {
      "start": 198.83,
      "end": 201.34,
      "text": "是操作术的主存地址"
    },
    {
      "start": 201.34,
      "end": 202.62,
      "text": "从上所述"
    },
    {
      "start": 202.62,
      "end": 204.46,
      "text": "在直接寻止方式下"
    },
    {
      "start": 204.46,
      "end": 205.9,
      "text": "操作术与指令"
    },
    {
      "start": 205.9,
      "end": 208.74,
      "text": "是分开存放在主存中的"
    },
    {
      "start": 208.74,
      "end": 210.72,
      "text": "例如下途所示"
    },
    {
      "start": 210.72,
      "end": 213.04,
      "text": "这是存放在主存中的某条"
    },
    {
      "start": 213.04,
      "end": 215.1,
      "text": "直接寻止指令"
    },
    {
      "start": 215.1,
      "end": 217.18,
      "text": "这是存放在主存中的"
    },
    {
      "start": 217.18,
      "end": 219.58,
      "text": "该指令的操作术"
    },
    {
      "start": 219.58,
      "end": 222.3,
      "text": "该指令中的形式地址自断的值"
    },
    {
      "start": 222.3,
      "end": 225.25,
      "text": "给出了操作术的主存地址"
    },
    {
      "start": 225.25,
      "end": 226.53,
      "text": "因此可知"
    },
    {
      "start": 226.53,
      "end": 228.21,
      "text": "在取与指令时"
    },
    {
      "start": 228.21,
      "end": 230.37,
      "text": "操作术不会随指令液体"
    },
    {
      "start": 230.37,
      "end": 232.85,
      "text": "被读取并送到CPU内的"
    },
    {
      "start": 232.85,
      "end": 235.49,
      "text": "指令寄存器IR中"
    },
    {
      "start": 235.49,
      "end": 237.17,
      "text": "在指令执行时"
    },
    {
      "start": 237.33,
      "end": 239.01,
      "text": "需要访问一次主存"
    },
    {
      "start": 239.01,
      "end": 241.33,
      "text": "来获取操作术"
    },
    {
      "start": 241.33,
      "end": 242.61,
      "text": "从上所述"
    },
    {
      "start": 242.61,
      "end": 245.47,
      "text": "可以得到直接寻止方式的特点"
    },
    {
      "start": 245.47,
      "end": 246.51,
      "text": "那就是"
    },
    {
      "start": 246.51,
      "end": 248.43,
      "text": "操作术的地址直观"
    },
    {
      "start": 248.43,
      "end": 251.46,
      "text": "无需专门计算操作术的地址"
    },
    {
      "start": 251.46,
      "end": 252.34,
      "text": "但是"
    },
    {
      "start": 252.34,
      "end": 254.9,
      "text": "形式地址自断的位宽有限"
    },
    {
      "start": 254.9,
      "end": 257.86,
      "text": "限制了操作术的表示范围"
    },
    {
      "start": 257.86,
      "end": 258.74,
      "text": "另外"
    },
    {
      "start": 258.74,
      "end": 261.3,
      "text": "操作术的地址位于指令中"
    },
    {
      "start": 261.3,
      "end": 263.73,
      "text": "因此不方便修改"
    },
    {
      "start": 263.73,
      "end": 266.21,
      "text": "下面给出的是Intel x86中"
    },
    {
      "start": 266.21,
      "end": 269.47,
      "text": "采用直接寻止方式的指令举例"
    },
    {
      "start": 269.47,
      "end": 271.63,
      "text": "从16进至主存地址"
    },
    {
      "start": 271.63,
      "end": 273.39,
      "text": "5132408处"
    },
    {
      "start": 273.39,
      "end": 275.95,
      "text": "读取一个32位的操作术"
    },
    {
      "start": 275.95,
      "end": 277.39,
      "text": "并将该操作术"
    },
    {
      "start": 277.39,
      "end": 281.46,
      "text": "送入32位通用寄存器Dax"
    },
    {
      "start": 281.46,
      "end": 284.53,
      "text": "再来看寄存器寻止方式"
    },
    {
      "start": 284.53,
      "end": 287.09,
      "text": "指令中的寻止方式自断的值"
    },
    {
      "start": 287.09,
      "end": 288.37,
      "text": "就是用来表明"
    },
    {
      "start": 288.37,
      "end": 290.85,
      "text": "寄存器寻止方式的特征码"
    },
    {
      "start": 290.85,
      "end": 292.61,
      "text": "例如010"
    },
    {
      "start": 292.61,
      "end": 293.65,
      "text": "这表明"
    },
    {
      "start": 293.65,
      "end": 295.89,
      "text": "指令中形式地址自断的值"
    },
    {
      "start": 295.89,
      "end": 297.01,
      "text": "是操作术"
    },
    {
      "start": 297.01,
      "end": 299.5,
      "text": "所在通用寄存器的编号"
    },
    {
      "start": 299.5,
      "end": 300.86,
      "text": "通常所说"
    },
    {
      "start": 300.86,
      "end": 303.02,
      "text": "在寄存器寻止方式下"
    },
    {
      "start": 303.02,
      "end": 306.53,
      "text": "操作术与指令是分开存放的"
    },
    {
      "start": 306.53,
      "end": 308.69,
      "text": "操作术存放在CPU内的"
    },
    {
      "start": 308.69,
      "end": 310.77,
      "text": "某个通用寄存器中"
    },
    {
      "start": 310.77,
      "end": 313.86,
      "text": "而指令存放在主存中"
    },
    {
      "start": 313.86,
      "end": 316.42,
      "text": "指令中的形式地址自断的值"
    },
    {
      "start": 316.42,
      "end": 317.94,
      "text": "给出的是操作术"
    },
    {
      "start": 317.94,
      "end": 320.34,
      "text": "所在通用寄存器的编号"
    },
    {
      "start": 320.34,
      "end": 322.18,
      "text": "例如下屠所示"
    },
    {
      "start": 322.18,
      "end": 324.1,
      "text": "这是存放在主存中的"
    },
    {
      "start": 324.1,
      "end": 326.9,
      "text": "某条寄存器寻止指令"
    },
    {
      "start": 326.9,
      "end": 330.27,
      "text": "这是CPU内的通用寄存器组"
    },
    {
      "start": 330.27,
      "end": 332.83,
      "text": "这是存放在某个通用寄存器中的"
    },
    {
      "start": 332.83,
      "end": 334.56,
      "text": "操作术"
    },
    {
      "start": 334.56,
      "end": 337.28,
      "text": "主存中的这条寄存器寻止指令的"
    },
    {
      "start": 337.28,
      "end": 339.2,
      "text": "形式地址自断的值"
    },
    {
      "start": 339.2,
      "end": 341.28,
      "text": "给出了该指令的操作术"
    },
    {
      "start": 341.28,
      "end": 344.48,
      "text": "所在的通用寄存器的编号"
    },
    {
      "start": 344.48,
      "end": 345.84,
      "text": "因此可知"
    },
    {
      "start": 345.84,
      "end": 347.52,
      "text": "在取指令时"
    },
    {
      "start": 347.52,
      "end": 350.8,
      "text": "操作术不会随指令一起被读取"
    },
    {
      "start": 350.8,
      "end": 352.4,
      "text": "并送到CPU内的"
    },
    {
      "start": 352.4,
      "end": 354.9,
      "text": "指令寄存器IR中"
    },
    {
      "start": 354.98,
      "end": 356.82,
      "text": "而在指令执行时"
    },
    {
      "start": 356.82,
      "end": 358.9,
      "text": "只需要访问寄存器"
    },
    {
      "start": 358.9,
      "end": 361.3,
      "text": "不需要访问慢速主存"
    },
    {
      "start": 361.3,
      "end": 363.6,
      "text": "来获取操作术"
    },
    {
      "start": 363.6,
      "end": 364.8,
      "text": "综上所说"
    },
    {
      "start": 364.8,
      "end": 368.19,
      "text": "可以得到寄存器寻止方式的特点"
    },
    {
      "start": 368.19,
      "end": 370.43,
      "text": "那就是获取操作术"
    },
    {
      "start": 370.43,
      "end": 372.83,
      "text": "不需要访问慢速主存"
    },
    {
      "start": 372.83,
      "end": 374.83,
      "text": "而是从寄存器获取"
    },
    {
      "start": 374.83,
      "end": 377.22,
      "text": "指令执行速度快"
    },
    {
      "start": 377.22,
      "end": 378.18,
      "text": "另外"
    },
    {
      "start": 378.18,
      "end": 380.9,
      "text": "由于通用寄存器的数量上"
    },
    {
      "start": 380.9,
      "end": 385.14,
      "text": "因此所需的形式地址自断的位数就上"
    },
    {
      "start": 385.22,
      "end": 387.46,
      "text": "有利于缩短指令自长"
    },
    {
      "start": 387.46,
      "end": 389.74,
      "text": "节省存储空间"
    },
    {
      "start": 389.74,
      "end": 390.78,
      "text": "但是"
    },
    {
      "start": 390.78,
      "end": 392.78,
      "text": "也正是由于这个原因"
    },
    {
      "start": 392.78,
      "end": 394.7,
      "text": "导致寄存器寻止"
    },
    {
      "start": 394.7,
      "end": 398.72,
      "text": "不能为大量的操作术提高存储服务"
    },
    {
      "start": 398.72,
      "end": 400.12,
      "text": "下面给出的是"
    },
    {
      "start": 400.12,
      "end": 401.52,
      "text": "英特尔X86中"
    },
    {
      "start": 401.52,
      "end": 405.17,
      "text": "采用寄存器寻止方式的指令举例"
    },
    {
      "start": 405.17,
      "end": 407.25,
      "text": "将32位通用寄存器"
    },
    {
      "start": 407.25,
      "end": 408.93,
      "text": "EBX中的内容"
    },
    {
      "start": 408.93,
