    },
    {
      "start": 425.14,
      "end": 426.1,
      "text": "这表明"
    },
    {
      "start": 426.1,
      "end": 428.26,
      "text": "指令中形式地址自断的值"
    },
    {
      "start": 428.26,
      "end": 430.94,
      "text": "是操作术的间接地址"
    },
    {
      "start": 430.94,
      "end": 432.94,
      "text": "在间接寻止方式下"
    },
    {
      "start": 432.94,
