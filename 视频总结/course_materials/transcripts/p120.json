{
  "file": "p120.mp3",
  "duration": 304.2975,
  "language": "zh",
  "segments": [
    {
      "start": 4.46,
      "end": 8.62,
      "text": "同學們好 歡迎大家來到我的計算機組成原理維克堂"
    },
    {
      "start": 8.62,
      "end": 11.78,
      "text": "在上節課中 我們給同學們介紹了"
    },
    {
      "start": 11.78,
      "end": 14.78,
      "text": "異常與中斷的相關基本概念"
    },
    {
      "start": 14.78,
      "end": 20.94,
      "text": "儘管不同計算機體系結構對異常和中斷的定義不完全相同"
    },
    {
      "start": 20.94,
      "end": 25.3,
      "text": "但是 異常與中斷的處理方式基本一致"
    },
    {
      "start": 25.3,
      "end": 28.52,
      "text": "為了簡單起見 除必要情況"
    },
    {
      "start": 28.52,
      "end": 31.72,
      "text": "我們將異常和中斷統稱為中斷"
    },
    {
      "start": 32.21,
      "end": 34.93,
      "text": "在同學們了解了上述基本概念後"
    },
    {
      "start": 34.93,
      "end": 39.73,
      "text": "本節課 我們給同學們介紹異常與中斷的處理過程"
    },
    {
      "start": 39.95,
      "end": 42.23,
      "text": "當發生中斷事件時"
    },
    {
      "start": 42.23,
      "end": 45.19,
      "text": "CPU會收到相應的中斷請求"
    },
    {
      "start": 45.19,
      "end": 49.76,
      "text": "進入中斷想贏週期 進行想贏處理"
    },
    {
      "start": 49.76,
      "end": 52.8,
      "text": "請同學們注意 一般情況下"
    },
    {
      "start": 52.8,
      "end": 55.08,
      "text": "在當前指令執行結束時"
    },
    {
      "start": 55.08,
      "end": 59.28,
      "text": "CPU才會進入中斷想贏週期 進行想贏處理"
    },
    {
      "start": 59.5,
      "end": 64.06,
      "text": "但是 若當前指令的執行引發了故障異常"
    },
    {
      "start": 64.06,
      "end": 65.94,
      "text": "例如缺業異常"
    },
    {
      "start": 65.94,
      "end": 71.22,
      "text": "則CPU必須立即進入中斷想贏週期 進行想贏處理"
    },
    {
      "start": 71.22,
      "end": 74.97,
      "text": "CPU在中斷想贏週期內的主要任務是"
    },
    {
      "start": 74.97,
      "end": 79.76,
      "text": "關中斷 保存斷點 中斷識別"
    },
    {
      "start": 79.76,
      "end": 81.77,
      "text": "我們來具體說明"
    },
    {
      "start": 81.77,
      "end": 86.51,
      "text": "關中斷是指臨時禁止中斷請求"
    },
    {
      "start": 86.51,
      "end": 90.07,
      "text": "這樣做是為了在中斷想贏週期的操作"
    },
    {
      "start": 90.07,
      "end": 93.39,
      "text": "以及後續進入的中斷服務程序中"
    },
    {
      "start": 93.39,
      "end": 96.39,
      "text": "進行保護現場的操作的完整性"
    },
    {
      "start": 96.39,
      "end": 99.3,
      "text": "以確保中斷服務程序執行完畢後"
    },
    {
      "start": 99.3,
      "end": 101.94,
      "text": "能夠返回斷點正確執行"
    },
    {
      "start": 101.94,
      "end": 104.13,
      "text": "對於單級中斷"
    },
    {
      "start": 104.13,
      "end": 107.85,
      "text": "只有在中斷返回時才需要開中斷"
    },
    {
      "start": 107.85,
      "end": 110.22,
      "text": "對於多級嵌套中斷"
    },
    {
      "start": 110.22,
      "end": 111.98,
      "text": "完成現場保護後"
    },
    {
      "start": 111.98,
      "end": 114.38,
      "text": "就可以通過指令開中斷"
    },
    {
      "start": 114.38,
      "end": 116.34,
      "text": "以方便中斷嵌套"
    },
    {
      "start": 116.34,
      "end": 119.02,
      "text": "這裡解釋一下中斷嵌套"
    },
    {
      "start": 119.18,
      "end": 120.74,
      "text": "所謂中斷嵌套"
    },
    {
      "start": 120.74,
      "end": 123.86,
      "text": "是指在支持中斷優先級的系統中"
    },
    {
      "start": 123.86,
      "end": 128.06,
      "text": "當一個腳底優先級的中斷服務程序執行過程中"
    },
    {
      "start": 128.06,
      "end": 130.74,
      "text": "主動重新打開了中斷允許"
    },
    {
      "start": 130.74,
      "end": 133.74,
      "text": "通常是在必要的關鍵代碼段之後"
    },
    {
      "start": 133.74,
      "end": 138.32,
      "text": "此時 如果出現了一個更高優先級的中斷請求"
    },
    {
      "start": 138.32,
      "end": 140.9,
      "text": "CPU將暫停當前"
    },
    {
      "start": 140.9,
      "end": 144.54,
      "text": "也就是腳底優先級中斷服務程序的執行"
    },
    {
      "start": 144.54,
      "end": 146.46,
      "text": "保存期上下文"
    },
    {
      "start": 146.54,
      "end": 147.98,
      "text": "並立即相應處理"
    },
    {
      "start": 147.98,
      "end": 151.27,
      "text": "該更高優先級中斷的中斷服務程序"
    },
    {
      "start": 151.27,
      "end": 152.63,
      "text": "處理完畢後"
    },
    {
      "start": 152.63,
      "end": 155.07,
      "text": "CPU返回並繼續執行"
    },
    {
      "start": 155.07,
      "end": 158.47,
      "text": "被暫停的低優先級中斷服務程序"
    },
    {
      "start": 158.47,
      "end": 162.51,
      "text": "最後再返回到主程序"
    },
    {
      "start": 162.51,
      "end": 164.15,
      "text": "保存斷點是指"
    },
    {
      "start": 164.15,
      "end": 166.67,
      "text": "保存中斷服務程序結束後"
    },
    {
      "start": 166.67,
      "end": 168.03,
      "text": "應返回到的"
    },
    {
      "start": 168.03,
      "end": 171.06,
      "text": "之前被中斷的程序中的位置"
    },
    {
      "start": 171.06,
      "end": 173.5,
      "text": "對於已經執行完畢的指令"
    },
    {
      "start": 173.5,
      "end": 176.78,
      "text": "應保存的斷點是下一條指令的位置"
    },
    {
      "start": 176.94,
      "end": 178.26,
      "text": "需要注意的是"
    },
    {
      "start": 178.26,
      "end": 181.29,
      "text": "有可能不是順序指令地址"
    },
    {
      "start": 181.29,
      "end": 186.17,
      "text": "對於切業故障、斷錯誤等執行指令引起的故障異常"
    },
    {
      "start": 186.17,
      "end": 188.65,
      "text": "由於指令並沒有執行成功"
    },
    {
      "start": 188.65,
      "end": 193.25,
      "text": "因此保存的斷點應該是異常指令本身的TC值"
    },
    {
      "start": 193.25,
      "end": 197.38,
      "text": "以便異常處理後重新執行該指令"
    },
    {
      "start": 197.38,
      "end": 199.86,
      "text": "為了支持多級嵌套中斷"
    },
    {
      "start": 199.86,
      "end": 201.54,
      "text": "對於X86解構"
    },
    {
      "start": 201.54,
      "end": 204.9,
      "text": "應將自動將斷點壓入內存堆佔"
    },
    {
      "start": 205.06,
      "end": 206.86,
      "text": "通過佔的後勁先出"
    },
    {
      "start": 206.86,
      "end": 209.22,
      "text": "也就是LIFO特性"
    },
    {
      "start": 209.22,
      "end": 211.61,
      "text": "天然支持多級嵌套"
    },
    {
      "start": 211.61,
      "end": 213.21,
      "text": "對於MIPS架構"
    },
    {
      "start": 213.21,
      "end": 215.13,
      "text": "硬架僅將斷點存入"
    },
    {
      "start": 215.13,
      "end": 218.82,
      "text": "亦被覆蓋的異常指令計存器EPC"
    },
    {
      "start": 218.82,
      "end": 221.7,
      "text": "需要軟架在中斷服務程序中"
    },
    {
      "start": 221.7,
      "end": 225.06,
      "text": "立即將EPC的內容保存至內存"
    },
    {
      "start": 225.06,
      "end": 226.74,
      "text": "例如內核佔"
    },
    {
      "start": 226.74,
      "end": 227.62,
      "text": "否則"
    },
    {
      "start": 227.62,
      "end": 228.78,
      "text": "見到發生時"
    },
    {
      "start": 228.78,
      "end": 231.22,
      "text": "新中斷會覆蓋EPC"
    },
    {
      "start": 231.22,
      "end": 233.5,
      "text": "從而導致原始斷點丟失"
    },
    {
      "start": 233.5,
      "end": 236.17,
      "text": "無法正確返回"
    },
    {
      "start": 236.17,
      "end": 237.97,
      "text": "中斷識別是指"
    },
    {
      "start": 237.97,
      "end": 240.25,
      "text": "根據當前的中斷請求"
    },
    {
      "start": 240.25,
      "end": 242.45,
      "text": "識別出中斷來源"
    },
    {
      "start": 242.45,
      "end": 246.41,
      "text": "也就是識別出具體發生了什麼中斷"
    },
    {
      "start": 246.41,
      "end": 249.57,
      "text": "並將該中斷的中斷服務程序入口地址"
    },
    {
      "start": 249.57,
      "end": 252.89,
      "text": "送入程序基礎器PC"
    },
    {
      "start": 252.89,
      "end": 253.73,
      "text": "至此"
    },
    {
      "start": 253.73,
      "end": 255.57,
      "text": "我們就給同學們介紹了"
    },
    {
      "start": 255.57,
      "end": 259.54,
      "text": "CPU在中斷響應週期中的三個主要任務"
    },
    {
      "start": 259.54,
      "end": 261.4,
      "text": "請同學們注意"
    },
    {
      "start": 261.4,
      "end": 263.28,
      "text": "中斷響應週期內的操作"
    },
    {
      "start": 263.28,
      "end": 265.12,
      "text": "全部由硬架實現"
    },
    {
      "start": 265.12,
      "end": 267.51,
      "text": "並且不可被打斷"
    },
    {
      "start": 267.51,
      "end": 269.55,
      "text": "中斷響應週期結束後"
    },
    {
      "start": 269.55,
      "end": 273.15,
      "text": "CPU從當前PC中取出中斷服務程序的"
    },
    {
      "start": 273.15,
      "end": 275.55,
      "text": "第一條指令開始執行"
    },
    {
      "start": 275.55,
      "end": 277.51,
      "text": "直到中斷返回"
    },
    {
      "start": 277.51,
      "end": 280.66,
      "text": "這部分任務是軟件實現的"
    },
    {
      "start": 280.66,
      "end": 281.74,
      "text": "總上所說"
    },
    {
      "start": 281.74,
      "end": 283.38,
      "text": "整個中斷處理過程"
    },
    {
      "start": 283.38,
      "end": 287.06,
      "text": "是硬架和軟架協同實現的"
    },
    {
      "start": 287.06,
      "end": 288.14,
      "text": "那麼下節課"
    },
    {
      "start": 288.14,
      "end": 289.74,
      "text": "我們給同學們介紹"
    },
    {
      "start": 289.74,
      "end": 291.98,
      "text": "中斷處理的相關硬架"
    },
    {
      "start": 291.98,
      "end": 293.38,
      "text": "下節課"
    },
    {
      "start": 293.46,
      "end": 296.85,
      "text": "我們給同學們介紹中斷服務程序"
    },
    {
      "start": 296.85,
      "end": 297.65,
      "text": "好的"
    },
    {
      "start": 297.65,
      "end": 300.05,
      "text": "本節課到這裡就結束了"
    },
    {
      "start": 300.05,
      "end": 300.89,
      "text": "同學們"
    },
    {
      "start": 300.89,
      "end": 302.21,
      "text": "我們下節課見"
    }
  ]
}