{
  "file": "p012.mp3",
  "duration": 641.544125,
  "language": "zh",
  "segments": [
    {
      "start": 3.89,
      "end": 8.41,
      "text": "同學們好 歡迎大家來到我的計算機組成原理威克堂"
    },
    {
      "start": 8.41,
      "end": 12.05,
      "text": "從本節課開始 我們要分幾次課的時間"
    },
    {
      "start": 12.05,
      "end": 14.85,
      "text": "分別介紹定點數的四種編碼"
    },
    {
      "start": 14.85,
      "end": 20.25,
      "text": "這四種編碼分別是原碼、補碼、繁碼以及移碼"
    },
    {
      "start": 20.25,
      "end": 25.85,
      "text": "本節課 我們介紹四種編碼中最簡單的一種 也就是原碼"
    },
    {
      "start": 25.85,
      "end": 31.77,
      "text": "對於原碼 符號位為比特0表示正數 為比特1表示復數"
    },
    {
      "start": 31.77,
      "end": 34.97,
      "text": "而數值位為真值的絕對值"
    },
    {
      "start": 34.97,
      "end": 40.1,
      "text": "因此 原碼表示又稱為帶符號的絕對值表示"
    },
    {
      "start": 40.1,
      "end": 41.94,
      "text": "我們來舉例說明"
    },
    {
      "start": 41.94,
      "end": 45.3,
      "text": "首先來看定點整數的原碼表示舉例"
    },
    {
      "start": 45.3,
      "end": 49.26,
      "text": "假設真值X等於正的1110"
    },
    {
      "start": 49.26,
      "end": 51.26,
      "text": "這是其原碼表示"
    },
    {
      "start": 51.26,
      "end": 54.78,
      "text": "也就是符號位用比特0表示正號"
    },
    {
      "start": 54.78,
      "end": 57.98,
      "text": "而數值位去真值的絕對值即可"
    },
    {
      "start": 57.98,
      "end": 61.8,
      "text": "假設真值X等於負的1110"
    },
    {
      "start": 61.96,
      "end": 63.96,
      "text": "這是其原碼表示"
    },
    {
      "start": 63.96,
      "end": 67.56,
      "text": "也就是符號位用比特1表示負號"
    },
    {
      "start": 67.56,
      "end": 71.27,
      "text": "而數值位去真值的絕對值即可"
    },
    {
      "start": 71.27,
      "end": 72.79,
      "text": "為了閱讀方便"
    },
    {
      "start": 72.79,
      "end": 75.83,
      "text": "以及區分定點整數的原碼表示"
    },
    {
      "start": 75.83,
      "end": 78.47,
      "text": "與定點小數的原碼表示"
    },
    {
      "start": 78.47,
      "end": 81.03,
      "text": "規定在定點整數的原碼表示中"
    },
    {
      "start": 81.03,
      "end": 85.11,
      "text": "符號位與數值位之間用豆號隔開"
    },
    {
      "start": 85.11,
      "end": 87.27,
      "text": "在定點小數的原碼表示中"
    },
    {
      "start": 87.27,
      "end": 91.48,
      "text": "符號位與數值位之間用小數點隔開"
    },
    {
      "start": 91.56,
      "end": 93.0,
      "text": "我們來舉例說明"
    },
    {
      "start": 93.0,
      "end": 95.82,
      "text": "定點小數的原碼表示"
    },
    {
      "start": 95.82,
      "end": 100.25,
      "text": "假設真值X等於正的0.1101"
    },
    {
      "start": 100.25,
      "end": 102.33,
      "text": "這是其原碼表示"
    },
    {
      "start": 102.33,
      "end": 104.97,
      "text": "也就是小數點左側的符號位"
    },
    {
      "start": 104.97,
      "end": 107.21,
      "text": "用比特0表示正號"
    },
    {
      "start": 107.21,
      "end": 111.0,
      "text": "而數值位去真值的絕對值即可"
    },
    {
      "start": 111.0,
      "end": 115.0,
      "text": "假設真值X等於負的0.1101"
    },
    {
      "start": 115.0,
      "end": 117.0,
      "text": "這是其原碼表示"
    },
    {
      "start": 117.0,
      "end": 119.56,
      "text": "也就是小數點左側的符號位"
    },
    {
      "start": 119.56,
      "end": 121.8,
      "text": "用比特1表示負號"
    },
    {
      "start": 121.8,
      "end": 125.61,
      "text": "而數值位去真值的絕對值即可"
    },
    {
      "start": 125.61,
      "end": 126.57,
      "text": "接下來"
    },
    {
      "start": 126.57,
      "end": 133.54,
      "text": "請同學們完成以下練習"
    },
    {
      "start": 133.54,
      "end": 135.78,
      "text": "相信大家都能正確完成"
    },
    {
      "start": 135.78,
      "end": 138.14,
      "text": "我們就不再墜速了"
    },
    {
      "start": 138.14,
      "end": 139.02,
      "text": "下面"
    },
    {
      "start": 139.02,
      "end": 142.14,
      "text": "我們想辦法將原碼的編碼規則"
    },
    {
      "start": 142.14,
      "end": 144.3,
      "text": "寫成表達式的形式"
    },
    {
      "start": 144.3,
      "end": 147.4,
      "text": "也就是給出原碼的定義"
    },
    {
      "start": 147.4,
      "end": 150.78,
      "text": "首先來看定點整數的原碼定義"
    },
    {
      "start": 150.78,
      "end": 153.58,
      "text": "假設真值X為定點整數"
    },
    {
      "start": 153.58,
      "end": 155.74,
      "text": "N為X的原碼表示中"
    },
    {
      "start": 155.82,
      "end": 157.42,
      "text": "數值位的位數"
    },
    {
      "start": 157.42,
      "end": 159.78,
      "text": "也就是比特數量"
    },
    {
      "start": 159.78,
      "end": 163.96,
      "text": "那麼真值X的原碼表示分兩種情況"
    },
    {
      "start": 163.96,
      "end": 166.36,
      "text": "一種是X大於等於0"
    },
    {
      "start": 166.36,
      "end": 169.1,
      "text": "小於2的N字方的情況"
    },
    {
      "start": 169.1,
      "end": 171.02,
      "text": "這裡需要說明的是"
    },
    {
      "start": 171.02,
      "end": 173.9,
      "text": "由於N為真值X的原碼表示中"
    },
    {
      "start": 173.9,
      "end": 175.58,
      "text": "數值位的位數"
    },
    {
      "start": 175.58,
      "end": 179.78,
      "text": "因此其最大值為2的N字方減1"
    },
    {
      "start": 179.78,
      "end": 181.7,
      "text": "所以我們給出的條件是"
    },
    {
      "start": 181.7,
      "end": 184.73,
      "text": "X小於2的N字方"
    },
    {
      "start": 184.73,
      "end": 186.09,
      "text": "這種情況下"
    },
    {
      "start": 186.17,
      "end": 188.17,
      "text": "真值X要么是0"
    },
    {
      "start": 188.17,
      "end": 190.33,
      "text": "要么是個正整數"
    },
    {
      "start": 190.33,
      "end": 192.65,
      "text": "因此其原碼表示為0"
    },
    {
      "start": 192.65,
      "end": 194.39,
      "text": "抖號X"
    },
    {
      "start": 194.39,
      "end": 196.55,
      "text": "抖號左側的符號位為0"
    },
    {
      "start": 196.55,
      "end": 198.07,
      "text": "表示正號"
    },
    {
      "start": 198.07,
      "end": 200.23,
      "text": "抖號右側為數值位"
    },
    {
      "start": 200.23,
      "end": 203.08,
      "text": "取值就是真值X"
    },
    {
      "start": 203.08,
      "end": 204.28,
      "text": "另一種是"
    },
    {
      "start": 204.28,
      "end": 207.4,
      "text": "X大於-2的N字方"
    },
    {
      "start": 207.4,
      "end": 209.46,
      "text": "小於等於0的情況"
    },
    {
      "start": 209.46,
      "end": 210.66,
      "text": "這種情況下"
    },
    {
      "start": 210.66,
      "end": 212.66,
      "text": "真值X要么是0"
    },
    {
      "start": 212.66,
      "end": 214.82,
      "text": "要么是一個負整數"
    },
    {
      "start": 214.82,
      "end": 216.34,
      "text": "其原碼表示為"
    },
    {
      "start": 216.34,
      "end": 219.82,
      "text": "2的N字方加X的絕對值"
    },
    {
      "start": 219.82,
      "end": 222.7,
      "text": "這相當於在X的絕對值前"
    },
    {
      "start": 222.7,
      "end": 224.78,
      "text": "添加了一個符號位"
    },
    {
      "start": 224.78,
      "end": 228.09,
      "text": "其位權值為2的N字方"
    },
    {
      "start": 228.09,
      "end": 230.1,
      "text": "我們來舉例說明"
    },
    {
      "start": 230.1,
      "end": 232.42,
      "text": "假設真值X等於負的"
    },
    {
      "start": 232.42,
      "end": 235.26,
      "text": "b3,b2,b1,b0"
    },
    {
      "start": 235.26,
      "end": 236.22,
      "text": "很顯然"
    },
    {
      "start": 236.22,
      "end": 238.63,
      "text": "真值的位數N等於4"
    },
    {
      "start": 238.63,
      "end": 240.55,
      "text": "則X的原碼表示"
    },
    {
      "start": 240.55,
      "end": 242.58,
      "text": "可用該式寫出"
    },
    {
      "start": 242.58,
      "end": 244.66,
      "text": "借2的4字方"
    },
    {
      "start": 244.66,
      "end": 249.61,
      "text": "加上負的b3,b2,b1,b0的絕對值"
    },
    {
      "start": 249.61,
      "end": 251.53,
      "text": "脫去絕對值符號"
    },
    {
      "start": 251.53,
      "end": 252.89,
      "text": "將2的4字方"
    },
    {
      "start": 252.89,
      "end": 255.16,
      "text": "寫成二徑之形式"
    },
    {
      "start": 255.16,
      "end": 257.8,
      "text": "最後可得X的原碼表示為"
    },
    {
      "start": 257.8,
      "end": 261.67,
      "text": "1,b3,b2,b1,b0"
    },
    {
      "start": 261.67,
      "end": 262.79,
      "text": "不要忘記"
    },
    {
      "start": 262.79,
      "end": 267.37,
      "text": "用逗號將符號位和數值位隔開"
    },
    {
      "start": 267.37,
      "end": 268.73,
      "text": "如果有些同學"
    },
    {
      "start": 268.73,
      "end": 270.09,
      "text": "還不是很明白"
    },
    {
      "start": 270.09,
      "end": 271.21,
      "text": "沒有關係"
    },
    {
      "start": 271.21,
      "end": 274.2,
      "text": "我們再用具體數值來舉例"
    },
    {
      "start": 274.2,
      "end": 275.24,
      "text": "例如"
    },
    {
      "start": 275.24,
      "end": 277.8,
      "text": "X等於正的1,1,1,0"
    },
    {
      "start": 277.8,
      "end": 279.48,
      "text": "則其原碼表示"
    },
    {
      "start": 279.48,
      "end": 284.44,
      "text": "可按該式寫出"
    },
    {
      "start": 284.44,
      "end": 285.48,
      "text": "又例如"
    },
    {
      "start": 285.48,
      "end": 288.28,
      "text": "X等於負的1,1,1,0"
    },
    {
      "start": 288.28,
      "end": 289.8,
      "text": "則其原碼表示"
    },
    {
      "start": 289.8,
      "end": 294.25,
      "text": "可按該式寫出"
    },
    {
      "start": 294.25,
      "end": 296.01,
      "text": "脫去絕對值符號"
    },
    {
      "start": 296.01,
      "end": 297.45,
      "text": "將2的4字方"
    },
    {
      "start": 297.45,
      "end": 299.45,
      "text": "寫成二徑之形式"
    },
    {
      "start": 299.45,
      "end": 302.01,
      "text": "最後可得X的原碼表示為"
    },
    {
      "start": 302.01,
      "end": 303.61,
      "text": "1,1,1,1,0"
    },
    {
      "start": 303.61,
      "end": 305.53,
      "text": "其中左側第一個1"
    },
    {
      "start": 305.61,
      "end": 307.13,
      "text": "是符號位上的1"
    },
    {
      "start": 307.13,
      "end": 308.49,
      "text": "表示符號"
    },
    {
      "start": 308.49,
      "end": 311.53,
      "text": "而剩餘其他個位是數值位"
    },
    {
      "start": 311.53,
      "end": 314.18,
      "text": "取之為真值的絕對值"
    },
    {
      "start": 314.18,
      "end": 315.22,
      "text": "不要忘記"
    },
    {
      "start": 315.22,
      "end": 319.14,
      "text": "用逗號將符號位和數值位隔開"
    },
    {
      "start": 319.14,
      "end": 320.02,
      "text": "接下來"
    },
    {
      "start": 320.02,
      "end": 322.98,
      "text": "請同學們按定點整數的原碼定義"
    },
    {
      "start": 322.98,
      "end": 329.96,
      "text": "完成以下練習"
    },
    {
      "start": 329.96,
      "end": 332.44,
      "text": "相信大家都能正確完成"
    },
    {
      "start": 332.44,
      "end": 335.27,
      "text": "我們就不再增數了"
    },
    {
      "start": 335.27,
      "end": 338.23,
      "text": "相較於定點整數的原碼定義式"
    },
    {
      "start": 338.23,
      "end": 341.75,
      "text": "定點小數的原碼定義式比較簡單"
    },
    {
      "start": 341.75,
      "end": 343.11,
      "text": "該條件表明"
    },
    {
      "start": 343.11,
      "end": 345.03,
      "text": "真值X要麼是0"
    },
    {
      "start": 345.03,
      "end": 347.51,
      "text": "要麼是個正的純小數"
    },
    {
      "start": 347.51,
      "end": 348.71,
      "text": "其原碼表示"
    },
    {
      "start": 348.71,
      "end": 350.87,
      "text": "就是真值X自身"
    },
    {
      "start": 350.87,
      "end": 351.75,
      "text": "只不過"
    },
    {
      "start": 351.75,
      "end": 354.63,
      "text": "此時X中的小數點左側的0"
    },
    {
      "start": 354.63,
      "end": 357.88,
      "text": "作為符號位表示正號"
    },
    {
      "start": 357.88,
      "end": 359.56,
      "text": "而該條件表明"
    },
    {
      "start": 359.56,
      "end": 361.4,
      "text": "真值X要麼是0"
    },
    {
      "start": 361.4,
      "end": 364.04,
      "text": "要麼是個負的純小數"
    },
    {
      "start": 364.04,
      "end": 365.56,
      "text": "其原碼表示為"
    },
    {
      "start": 365.56,
      "end": 368.55,
      "text": "1加上X的絕對值"
    },
    {
      "start": 368.63,
      "end": 371.03,
      "text": "相當於在X絕對值前面"
    },
    {
      "start": 371.03,
      "end": 373.59,
      "text": "添加了一個取之為1的符號位"
    },
    {
      "start": 373.59,
      "end": 375.03,
      "text": "表示負號"
    },
    {
      "start": 375.03,
      "end": 377.11,
      "text": "我們來舉例說明"
    },
    {
      "start": 377.11,
      "end": 380.87,
      "text": "例如X等於正的0.1101"
    },
    {
      "start": 380.87,
      "end": 382.23,
      "text": "則其原碼表示"
    },
    {
      "start": 382.23,
      "end": 387.14,
      "text": "可按該式寫出"
    },
    {
      "start": 387.14,
      "end": 391.27,
      "text": "又例如X等於負的0.1101"
    },
    {
      "start": 391.27,
      "end": 392.71,
      "text": "則其原碼表示"
    },
    {
      "start": 392.71,
      "end": 398.42,
      "text": "可按該式寫出"
    },
    {
      "start": 398.42,
      "end": 400.26,
      "text": "拖去絕對值符號"
    },
    {
      "start": 400.26,
      "end": 402.82,
      "text": "最後可得X的原碼表示為"
    },
    {
      "start": 402.82,
      "end": 404.58,
      "text": "1.1101"
    },
    {
      "start": 404.58,
      "end": 407.7,
      "text": "其中小數點左側為符號位"
    },
    {
      "start": 407.7,
      "end": 410.02,
      "text": "取之為1表示負號"
    },
    {
      "start": 410.02,
      "end": 412.18,
      "text": "小數點右側為數值位"
    },
    {
      "start": 412.18,
      "end": 414.98,
      "text": "取之為X的絕對值"
    },
    {
      "start": 414.98,
      "end": 415.86,
      "text": "接下來"
    },
    {
      "start": 415.86,
      "end": 419.06,
      "text": "請同學們按定點小數的原碼定義"
    },
    {
      "start": 419.06,
      "end": 426.52,
      "text": "完成以下練習"
    },
    {
      "start": 426.52,
      "end": 428.76,
      "text": "相信大家都能正確完成"
    },
    {
      "start": 428.76,
      "end": 431.21,
      "text": "我們就不再追數了"
    },
    {
      "start": 431.21,
      "end": 432.09,
      "text": "接下來"
    },
    {
      "start": 432.09,
      "end": 435.29,
      "text": "再請同學們按定點小數的原碼定義"
    },
    {
      "start": 435.29,
      "end": 437.21,
      "text": "完成以下練習"
    },
    {
      "start": 437.21,
      "end": 445.3,
      "text": "看看會出現什麼有趣的現象"
    },
    {
      "start": 445.3,
      "end": 446.18,
      "text": "沒錯"
    },
    {
      "start": 446.18,
      "end": 448.98,
      "text": "可以發現真之鱗在原碼中"
    },
    {
      "start": 448.98,
      "end": 451.67,
      "text": "有兩種不同的表示"
    },
    {
      "start": 451.67,
      "end": 453.27,
      "text": "需要說明的是"
    },
    {
      "start": 453.27,
      "end": 455.99,
      "text": "如果按照定點整數的原碼定義"
    },
    {
      "start": 455.99,
      "end": 458.87,
      "text": "可以得到與上述相同的結果"
    },
    {
      "start": 458.87,
      "end": 461.67,
      "text": "有興趣的同學可以自己試一試"
    },
    {
      "start": 461.67,
      "end": 464.07,
      "text": "我們就不再正數了"
    },
    {
      "start": 464.07,
      "end": 464.95,
      "text": "接下來"
    },
    {
      "start": 464.95,
      "end": 468.25,
      "text": "我們來總結一下原碼的優缺點"
    },
    {
      "start": 468.25,
      "end": 469.77,
      "text": "原碼的優點是"
    },
    {
      "start": 469.77,
      "end": 472.09,
      "text": "表示方法簡單直觀"
    },
    {
      "start": 472.09,
      "end": 474.49,
      "text": "這一點在同學們之後學習"
    },
    {
      "start": 474.49,
      "end": 478.52,
      "text": "無碼 反碼 以碼時會更有體會"
    },
    {
      "start": 478.52,
      "end": 480.44,
      "text": "原碼的其中一個缺點"
    },
    {
      "start": 480.44,
      "end": 482.68,
      "text": "我們之前剛剛介紹過"
    },
    {
      "start": 482.68,
      "end": 484.44,
      "text": "那就是對於真之鱗"
    },
    {
      "start": 484.44,
      "end": 486.76,
      "text": "有兩種不同的表示"
    },
    {
      "start": 486.76,
      "end": 489.85,
      "text": "這會給數據運算帶來麻煩"
    },
    {
      "start": 489.85,
      "end": 491.85,
      "text": "而原碼的另一個缺點"
    },
    {
      "start": 491.85,
      "end": 495.0,
      "text": "我們通過舉例來引出"
    },
    {
      "start": 495.0,
      "end": 498.36,
      "text": "假設有政務和復三兩個真值"
    },
    {
      "start": 498.36,
      "end": 501.27,
      "text": "我們要將他們進行加法運算"
    },
    {
      "start": 501.27,
      "end": 502.95,
      "text": "這非常簡單"
    },
    {
      "start": 502.95,
      "end": 506.55,
      "text": "相信小學生都能通過新算或手算"
    },
    {
      "start": 506.55,
      "end": 508.5,
      "text": "來正確完成"
    },
    {
      "start": 508.5,
      "end": 509.22,
      "text": "然而"
    },
    {
      "start": 509.22,
      "end": 511.78,
      "text": "我們知道在計算機內部"
    },
    {
      "start": 511.78,
      "end": 515.3,
      "text": "真值政務和復三無法直接表示"
    },
    {
      "start": 515.3,
      "end": 517.64,
      "text": "可以用其原碼來表示"
    },
    {
      "start": 517.64,
      "end": 520.82,
      "text": "這是政務的原碼表示"
    },
    {
      "start": 520.82,
      "end": 523.86,
      "text": "這是復三的原碼表示"
    },
    {
      "start": 523.86,
      "end": 525.54,
      "text": "我們來看看這兩個原碼"
    },
    {
      "start": 525.54,
      "end": 527.93,
      "text": "進行加法的情況"
    },
    {
      "start": 527.93,
      "end": 530.81,
      "text": "從第一位開始二進之加法"
    },
    {
      "start": 530.81,
      "end": 532.81,
      "text": "一加一得一零"
    },
    {
      "start": 532.81,
      "end": 536.01,
      "text": "寫零並向高位進一"
    },
    {
      "start": 536.01,
      "end": 538.65,
      "text": "零加一加一得一零"
    },
    {
      "start": 538.65,
      "end": 541.98,
      "text": "寫零並向高位進一"
    },
    {
      "start": 541.98,
      "end": 544.54,
      "text": "一加零加一得一零"
    },
    {
      "start": 544.54,
      "end": 547.59,
      "text": "寫零並向高位進一"
    },
    {
      "start": 547.59,
      "end": 550.63,
      "text": "零加零加一得一"
    },
    {
      "start": 550.63,
      "end": 553.4,
      "text": "零加零得零"
    },
    {
      "start": 553.4,
      "end": 555.88,
      "text": "零加零得零"
    },
    {
      "start": 555.88,
      "end": 558.2,
      "text": "零加零得零"
    },
    {
      "start": 558.2,
      "end": 560.94,
      "text": "零加一得一"
    },
    {
      "start": 560.94,
      "end": 562.94,
      "text": "通過計算結果的符號位"
    },
    {
      "start": 562.94,
      "end": 565.02,
      "text": "為比特一可知"
    },
    {
      "start": 565.02,
      "end": 567.18,
      "text": "計算結果為復數"
    },
    {
      "start": 567.26,
      "end": 570.5,
      "text": "這與真值的計算結果矛盾"
    },
    {
      "start": 570.5,
      "end": 574.5,
      "text": "這樣我們就得出了原碼的另一個缺點"
    },
    {
      "start": 574.5,
      "end": 578.71,
      "text": "那就是符號位不能直接參與運算"
    },
    {
      "start": 578.71,
      "end": 581.67,
      "text": "介於原碼的以上兩個缺點"
    },
    {
      "start": 581.67,
      "end": 583.27,
      "text": "原碼在計算機中"
    },
    {
      "start": 583.27,
      "end": 585.11,
      "text": "目前僅僅用於表示"
    },
    {
      "start": 585.11,
      "end": 588.09,
      "text": "伏電數的維碼或稱為數"
    },
    {
      "start": 588.09,
      "end": 590.33,
      "text": "伏電數的表示比較複雜"
    },
    {
      "start": 590.33,
      "end": 592.57,
      "text": "我們將在介紹完定點數的"
    },
    {
      "start": 592.57,
      "end": 596.39,
      "text": "四種編碼之後進行詳細介紹"
    },
    {
      "start": 596.39,
      "end": 597.27,
      "text": "下節課"
    },
    {
      "start": 597.27,
      "end": 599.59,
      "text": "我們為同學們介紹補碼"
    },
    {
      "start": 599.59,
      "end": 603.54,
      "text": "補碼解決了原碼的上數兩個缺點"
    },
    {
      "start": 603.54,
      "end": 604.42,
      "text": "好的"
    },
    {
      "start": 604.42,
      "end": 606.82,
      "text": "本節課到這裡就結束了"
    },
    {
      "start": 606.82,
      "end": 612.47,
      "text": "我們將本節課的內容小節如下"
    },
    {
      "start": 612.47,
      "end": 614.07,
      "text": "需要說明的是"
    },
    {
      "start": 614.07,
      "end": 616.79,
      "text": "根據定點數的原碼定義是"
    },
    {
      "start": 616.79,
      "end": 619.35,
      "text": "我們可以寫出真值的原碼"
    },
    {
      "start": 619.35,
      "end": 620.71,
      "text": "這在本節課中"
    },
    {
      "start": 620.71,
      "end": 623.9,
      "text": "我們已經進行了多次練習"
    },
    {
      "start": 623.9,
      "end": 627.02,
      "text": "從定點數的原碼定義是不難看出"
    },
    {
      "start": 627.02,
      "end": 628.46,
      "text": "利用定義是"
    },
    {
      "start": 628.46,
      "end": 630.06,
      "text": "我們也可以反過來"
    },
    {
      "start": 630.14,
      "end": 633.0,
      "text": "那就是寫出原碼的真值"
    },
    {
      "start": 633.0,
      "end": 636.94,
      "text": "這一點請同學們自行練習即可"
    },
    {
      "start": 636.94,
      "end": 637.82,
      "text": "同學們"
    },
    {
      "start": 637.82,
      "end": 639.26,
      "text": "我們下節課見"
    }
  ]
}