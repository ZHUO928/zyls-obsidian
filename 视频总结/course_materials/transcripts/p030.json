    },
    {
      "start": 928.1,
      "end": 932.1,
      "text": "该加法器的最低位产生合数的S12位,"
    },
    {
      "start": 932.1,
      "end": 933.4,
      "text": "与此同时,"
    },
    {
      "start": 933.4,
      "end": 936.1,
      "text": "又起第三个四位快速加法器,"
    },
    {
      "start": 936.1,
