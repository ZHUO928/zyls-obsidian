    },
    {
      "start": 776.65,
      "end": 779.14,
      "text": "用来输出四位合数。"
    },
    {
      "start": 779.14,
      "end": 780.24,
      "text": "这个输出端,"
    },
    {
      "start": 780.24,
      "end": 782.97,
      "text": "用来输出向高位的进位。"
    },
    {
      "start": 782.97,
      "end": 783.87,
      "text": "接下来,"
    },
    {
      "start": 783.87,
