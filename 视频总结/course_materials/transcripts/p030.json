    {
      "start": 702.28,
      "end": 704.88,
      "text": "即为四位串型进位加法器,"
    },
    {
      "start": 705.28,
      "end": 707.28,
      "text": "其时间关键延迟,"
    },
    {
      "start": 707.28,
      "end": 713.84,
      "text": "也就是各数位的合数全部产生所需要的时长为12T。"
    },
    {
      "start": 713.84,
      "end": 718.54,
      "text": "这是本节课我们刚刚介绍过的四位快速加法器,"
    },
    {
      "start": 718.54,
      "end": 721.5,
      "text": "其时间关键延迟为8T,"
    },
    {
      "start": 721.5,
      "end": 726.79,
      "text": "其性能比四位串型进位加法器提升了1.5倍。"
    },
    {
      "start": 726.79,
      "end": 727.59,
      "text": "然而,"
    },
    {
      "start": 727.59,
      "end": 729.49,
      "text": "有的同学可能会认为,"
    },
    {
      "start": 729.49,
      "end": 731.92,
      "text": "性能提升并不是很大,"
    },
    {
      "start": 731.92,
      "end": 732.92,
      "text": "这是因为,"
    },
    {
      "start": 732.92,
      "end": 735.62,
      "text": "我们比较的是四位加法器,"
    },
    {
      "start": 735.62,
      "end": 737.85,
      "text": "其位宽比较小,"
    },
    {
      "start": 737.85,
      "end": 739.95,
      "text": "对于串型进位加法器,"
    },
    {
      "start": 739.95,
      "end": 741.75,
      "text": "其时间关键延迟,"
    },
    {
      "start": 741.75,
      "end": 745.05,
      "text": "与加法器的位宽N成线性关系,"
    },
    {
      "start": 745.05,
      "end": 746.55,
      "text": "当N角大时,"
    },
    {
      "start": 746.55,
      "end": 749.48,
      "text": "时间关键延迟就比较大,"
    },
    {
      "start": 749.48,
      "end": 751.58,
      "text": "为了进行后续对比。"
    },
    {
      "start": 751.58,
      "end": 752.38,
      "text": "接下来,"
    },
    {
      "start": 752.38,
      "end": 754.68,
      "text": "我们使用四位快速加法器,"
    },
    {
      "start": 754.68,
      "end": 758.24,
      "text": "来构建更大位宽的加法器电路。"
    },
    {
      "start": 758.24,
      "end": 759.74,
      "text": "为了简单起见,"
    },
    {
      "start": 759.74,
      "end": 761.04,
      "text": "我们使用符号,"
    },
    {
      "start": 761.04,
      "end": 765.59,
      "text": "来屏蔽四位快速加法器电路的组成细节。"
    },
    {
      "start": 765.59,
      "end": 766.89,
      "text": "这八个输入端,"
