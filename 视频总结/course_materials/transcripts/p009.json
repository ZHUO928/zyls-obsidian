      "text": "SE的运算速度快"
    },
    {
      "start": 655.94,
      "end": 658.02,
      "text": "根据本例可以看出"
    },
    {
      "start": 658.02,
      "end": 660.42,
      "text": "仅仅通过计算机编译后"
