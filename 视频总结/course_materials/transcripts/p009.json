    {
      "start": 1047.93,
      "end": 1050.83,
      "text": "我们来一起分析一下"
    },
    {
      "start": 1050.87,
      "end": 1052.75,
      "text": "mips这个性能指标"
    },
    {
      "start": 1052.75,
      "end": 1056.4,
      "text": "是指每秒执行多少百万条指令"
    },
    {
      "start": 1056.4,
      "end": 1058.32,
      "text": "cpi这个性能指标"
    },
    {
      "start": 1058.32,
      "end": 1063.01,
      "text": "是指执行一条指令所需要的十中周期数量"
    },
    {
      "start": 1063.01,
      "end": 1064.97,
      "text": "ipc这个性能指标"
    },
    {
      "start": 1064.97,
      "end": 1069.17,
      "text": "是指每个十中周期能够执行的指定数量"
    },
    {
      "start": 1069.17,
      "end": 1071.62,
      "text": "它是cpi的倒数"
    },
    {
      "start": 1071.62,
