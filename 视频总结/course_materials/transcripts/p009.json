      "start": 929.22,
      "end": 930.82,
      "text": "不同测试程序中"
    },
    {
      "start": 930.82,
      "end": 933.34,
      "text": "包含的浮点运算量不同"
    },
    {
      "start": 933.34,
      "end": 936.85,
      "text": "测试得到的结果也不相同"
    },
    {
      "start": 936.85,
      "end": 937.69,
      "text": "最后"
    },
    {
      "start": 937.69,
      "end": 940.37,
      "text": "我们还要给同学们简单介绍一下"
    },
    {
      "start": 940.37,
      "end": 944.88,
      "text": "使用基准程序进行性能评估的概念"
    },
    {
      "start": 944.88,
      "end": 948.04,
      "text": "基准程序是一组特定的程序"
    },
    {
      "start": 948.04,
      "end": 951.58,
      "text": "专门用于评测计算机的性能"
    },
    {
      "start": 951.58,
      "end": 954.94,
      "text": "这些程序能够有效的模拟计算机"
    },
    {
      "start": 954.94,
      "end": 957.86,
      "text": "在处理实际任务时的表现"
    },
    {
      "start": 957.86,
      "end": 962.02,
      "text": "在不同计算机上运行同样的基准程序"
    },
    {
      "start": 962.02,
      "end": 966.14,
      "text": "通过比较各计算机运行基准程序的时间"
    },
    {
      "start": 966.14,
      "end": 969.3,
      "text": "从而评测他们各自的性能"
    },
    {
      "start": 969.3,
      "end": 972.3,
      "text": "不同基准程序的评测重点不同"
    },
    {
      "start": 972.3,
      "end": 974.18,
      "text": "例如CPU性能"
    },
    {
      "start": 974.18,
      "end": 975.54,
      "text": "图形性能"
    },
    {
      "start": 975.54,
      "end": 976.9,
      "text": "存储性能"
    },
    {
      "start": 976.9,
      "end": 978.78,
      "text": "浮点述计算性能"
    },
    {
      "start": 978.78,
      "end": 981.55,
      "text": "病情计算性能等"
    },
    {
      "start": 981.55,
      "end": 985.98,
      "text": "这是目前国际上流行的一些基准程序"
    },
    {
      "start": 985.98,
      "end": 991.14,
      "text": "有兴趣的同学可以自行查阅"
    },
    {
      "start": 991.14,
      "end": 992.02,
      "text": "至此"
    },
    {
      "start": 992.02,
      "end": 997.18,
      "text": "我们就将计算机硬件的相关性能指标全部介绍完了"
    },
    {
      "start": 997.18,
      "end": 999.5,
      "text": "再次提醒同学们注意"
    },
    {
      "start": 999.5,
      "end": 1003.62,
      "text": "衡量计算机系统性能是一项比较复杂的任务"
    },
    {
      "start": 1003.62,
      "end": 1008.13,
      "text": "很难仅凭借单一指标进行精确衡量"
    },
    {
      "start": 1008.13,
      "end": 1011.49,
      "text": "上述一些衡量计算机性能的指标之间"
    },
    {
      "start": 1011.49,
      "end": 1013.67,
      "text": "也不是完全独立的"
    },
    {
      "start": 1013.67,
      "end": 1015.51,
      "text": "改变其中一项指标"
    },
    {
      "start": 1015.51,
