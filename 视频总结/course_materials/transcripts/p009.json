    {
      "start": 897.18,
      "end": 899.26,
      "text": "相较于M-Flopes"
    },
    {
      "start": 899.26,
      "end": 902.1,
      "text": "衡量每秒执行辅典运算的次数"
    },
    {
      "start": 902.1,
      "end": 906.48,
      "text": "还有以下更大的单位"
    },
    {
      "start": 906.48,
      "end": 914.82,
      "text": "这是这些单位之间的换算关系"
