    {
      "start": 660.42,
      "end": 663.18,
      "text": "目标代码中包含的指令数量"
    },
    {
      "start": 663.18,
      "end": 667.09,
      "text": "来评估计算机性能是不准确的"
    },
    {
      "start": 667.09,
      "end": 668.53,
      "text": "在本例中"
    },
    {
      "start": 668.53,
      "end": 672.79,
      "text": "尽管SE包含的指令数量比SE多"
    },
    {
      "start": 672.83,
      "end": 675.03,
      "text": "但是由于SE中"
    },
    {
      "start": 675.03,
