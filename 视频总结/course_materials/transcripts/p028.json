      "text": "但一般情況下"
    },
    {
      "start": 510.5,
      "end": 512.18,
      "text": "我們會按設計要求"
    },
    {
      "start": 512.18,
      "end": 514.5,
      "text": "利用公式或卡諾圖"
    },
    {
      "start": 514.5,
      "end": 516.66,
      "text": "對邏輯表達式進行劃件"
    },
    {
      "start": 516.74,
      "end": 520.61,
      "text": "並轉換成滿足設計要求的邏輯表達式"
    },
    {
      "start": 520.61,
      "end": 521.57,
      "text": "例如"
    },
    {
      "start": 521.57,
      "end": 523.41,
      "text": "轉換成如下所示的"
    },
    {
      "start": 523.41,
      "end": 527.09,
      "text": "由兩次議會運算構成的邏輯表達式"
    },
    {
      "start": 527.09,
      "end": 528.53,
      "text": "該邏輯表達式"
    },
    {
      "start": 528.53,
      "end": 530.37,
      "text": "從另一個角度表示了"
    },
    {
      "start": 530.37,
      "end": 532.53,
      "text": "原邏輯表達式所表示的"
    },
    {
      "start": 532.53,
      "end": 535.52,
      "text": "輸入與輸出之間的邏輯關係"
    },
    {
      "start": 535.52,
      "end": 537.44,
      "text": "使得我們更容易看出"
    },
    {
      "start": 537.44,
      "end": 540.48,
      "text": "輸入si yi z的組合中"
    },
    {
      "start": 540.48,
      "end": 542.24,
      "text": "只要有基礎個一"
    },
    {
      "start": 542.24,
      "end": 544.96,
      "text": "輸出si就等於一"
    },
    {
      "start": 545.04,
      "end": 546.56,
      "text": "從針織表中的關係"
    },
    {
      "start": 546.56,
      "end": 548.98,
      "text": "也不能發現這一點"
    },
    {
      "start": 548.98,
      "end": 551.06,
      "text": "另外通過以上描述"
    },
    {
      "start": 551.06,
      "end": 553.14,
      "text": "學習過接有教院原理的同學"
    },
    {
      "start": 553.14,
      "end": 554.69,
      "text": "可能會想到"
    },
    {
      "start": 554.69,
      "end": 557.25,
      "text": "可以按照上面這個邏輯表達式的方式"
    },
    {
      "start": 557.25,
      "end": 560.05,
      "text": "來計算接有教院的教院位"
    },
    {
      "start": 560.05,
      "end": 562.8,
      "text": "我們就不再進一步介紹了"
    },
    {
      "start": 562.8,
      "end": 563.68,
      "text": "接下來"
    },
    {
      "start": 563.68,
      "end": 565.92,
      "text": "請同學們根據之前拆分出的"
    },
    {
      "start": 565.92,
      "end": 567.2,
      "text": "另一個針織表"
    },
    {
      "start": 567.2,
      "end": 569.92,
      "text": "寫出本位加數si yi"
    },
    {
      "start": 569.92,
      "end": 572.8,
      "text": "來自低位的敬畏ci作為輸入"
    },
    {
      "start": 572.8,
      "end": 575.28,
      "text": "本位向高位的敬畏ci加1"
    },
    {
      "start": 575.28,
      "end": 582.86,
      "text": "作為輸出的邏輯表達式"
    },
    {
      "start": 582.86,
      "end": 585.42,
      "text": "相信同學們都能正確完成"
    },
    {
      "start": 585.42,
      "end": 587.97,
      "text": "我們就不再贅述了"
    },
    {
      "start": 587.97,
      "end": 590.21,
      "text": "假設這是根據設計要求"
    },
    {
      "start": 590.21,
      "end": 593.6,
      "text": "化解並轉換得到的邏輯表達式"
    },
    {
      "start": 593.6,
      "end": 594.96,
      "text": "該邏輯表達式"
    },
    {
      "start": 594.96,
      "end": 596.8,
      "text": "從另一個角度表示了"
    },
    {
      "start": 596.8,
      "end": 598.88,
      "text": "原邏輯表達式所表示的"
    },
    {
      "start": 598.88,
      "end": 602.08,
      "text": "輸入與輸出之間的邏輯關係"
    },
    {
      "start": 602.08,
      "end": 603.44,
      "text": "這部分表示"
    },
    {
      "start": 603.44,
      "end": 605.92,
      "text": "若si和yi都為一"
    },
    {
      "start": 605.92,
      "end": 608.3,
      "text": "則si加1為一"
    },
    {
      "start": 608.3,
      "end": 609.66,
      "text": "這部分表示"
    },
    {
      "start": 609.74,
      "end": 611.98,
      "text": "若si和yi不同"
    },
    {
      "start": 611.98,
      "end": 613.66,
      "text": "且ci為一"
    },
    {
      "start": 613.66,
      "end": 616.34,
      "text": "則si加1為一"
    },
    {
      "start": 616.34,
      "end": 617.3,
      "text": "這次"
    },
    {
      "start": 617.3,
      "end": 620.34,
      "text": "我們就要得到了本位加數si yi"
    },
    {
      "start": 620.34,
      "end": 623.22,
      "text": "來自低位的敬畏ci作為輸入"
    },
    {
      "start": 623.22,
      "end": 626.8,
      "text": "本位和si作為輸出的邏輯表達式"
    },
    {
      "start": 626.8,
      "end": 629.68,
      "text": "以及本位加數si yi"
    },
    {
      "start": 629.68,
      "end": 632.48,
      "text": "來自低位的敬畏ci作為輸入"
    },
    {
      "start": 632.48,
      "end": 637.3,
      "text": "本位向高位的敬畏ci加1作為輸出的邏輯表達式"
    },
    {
      "start": 637.3,
      "end": 639.54,
      "text": "根據這兩個邏輯表達式"
    },
    {
      "start": 639.54,
      "end": 643.17,
      "text": "我們可以畫出相應的組合邏輯電路"
    },
    {
      "start": 643.17,
      "end": 645.89,
      "text": "為了方便同學們將邏輯表達式"
    },
    {
      "start": 645.89,
      "end": 648.05,
      "text": "與邏輯電路對應起來"
    },
    {
      "start": 648.05,
      "end": 651.33,
      "text": "我們用顏色將邏輯表達式中的運算符"
    },
    {
      "start": 651.33,
      "end": 655.06,
      "text": "與邏輯電路中的邏輯門進行的對應"
    },
    {
      "start": 655.06,
      "end": 657.14,
      "text": "本位加數si yi"
    },
    {
      "start": 657.14,
      "end": 661.76,
      "text": "來自低位的敬畏ci作為該邏輯電路的輸入端"
    },
    {
      "start": 661.76,
      "end": 663.2,
      "text": "本位和si"
    },
    {
      "start": 663.2,
      "end": 666.0,
      "text": "與本位向高位的敬畏ci加1"
    },
    {
      "start": 666.0,
      "end": 668.93,
      "text": "作為該邏輯電路的輸出端"
    },
    {
      "start": 668.93,
      "end": 670.05,
      "text": "接下來"
    },
    {
      "start": 670.13,
      "end": 672.61,
      "text": "我們將真值表中的某個組合"
    },
    {
      "start": 672.61,
      "end": 675.73,
      "text": "帶入該邏輯電路來驗證一下"
    },
    {
      "start": 675.73,
      "end": 678.59,
      "text": "看看輸出結果是否正確"
    },
    {
      "start": 678.59,
      "end": 696.37,
      "text": "如下所示"
    },
    {
      "start": 696.37,
      "end": 697.33,
      "text": "接下來"
    },
    {
      "start": 697.33,
      "end": 699.09,
      "text": "我們再來分析一下"
    },
    {
      "start": 699.09,
      "end": 702.96,
      "text": "信號經過該邏輯電路所耗費的時間"
    },
    {
      "start": 702.96,
      "end": 704.8,
      "text": "再設基本邏輯門"
    },
    {
      "start": 704.8,
      "end": 709.57,
      "text": "例如貨門與門的傳播延遲為1T"
    },
    {
      "start": 709.57,
      "end": 710.77,
      "text": "複合邏輯門"
    },
    {
      "start": 710.77,
      "end": 714.88,
      "text": "例如1貨門的傳播延遲為3T"
    },
    {
      "start": 714.96,
      "end": 716.16,
      "text": "不考慮信號"
    },
    {
      "start": 716.16,
      "end": 719.79,
      "text": "在邏輯門之間的線路上的傳播實驗"
    },
    {
      "start": 719.79,
      "end": 722.99,
      "text": "從信號輸入到該邏輯電路時刻起"
    },
    {
      "start": 722.99,
      "end": 724.43,
      "text": "1T時間號"
    },
    {
      "start": 724.43,
      "end": 727.5,
      "text": "這個與門輸出有效信號"
    },
    {
      "start": 727.5,
      "end": 728.86,
      "text": "3T時間號"
    },
    {
      "start": 728.86,
      "end": 732.42,
      "text": "這個易貨門輸出有效信號"
    },
    {
      "start": 732.42,
      "end": 733.62,
      "text": "4T時間號"
    },
    {
      "start": 733.62,
      "end": 736.94,
      "text": "這個與門輸出有效信號"
    },
    {
      "start": 736.94,
      "end": 738.3,
      "text": "5T時間號"
    },
    {
      "start": 738.3,
      "end": 741.26,
      "text": "這個貨門輸出有效信號"
    },
    {
      "start": 741.26,
      "end": 742.14,
      "text": "該信號"
    },
    {
      "start": 742.14,
      "end": 746.02,
      "text": "就是本位向高位的敬畏信號"
    },
    {
      "start": 746.02,
      "end": 747.46,
      "text": "6T時間號"
    },
    {
      "start": 747.46,
      "end": 750.11,
      "text": "這個易貨門輸出有效信號"
    },
    {
      "start": 750.11,
      "end": 750.99,
      "text": "該信號"
    },
    {
      "start": 750.99,
      "end": 753.66,
      "text": "就是本位合的信號"
    },
    {
      "start": 753.66,
      "end": 755.26,
      "text": "需要說明的是"
    },
    {
      "start": 755.26,
      "end": 759.5,
      "text": "當我們不需要研究某個邏輯電路的內部細節時"
    },
    {
      "start": 759.5,
      "end": 762.32,
      "text": "我們可以用符號進行表示"
    },
    {
      "start": 762.32,
      "end": 763.36,
      "text": "例如"
    },
