    },
    {
      "start": 189.77,
      "end": 193.15,
      "text": "進而得出相應的邏輯表達式"
    },
    {
      "start": 193.15,
      "end": 199.18,
      "text": "其中本位加數和來自d位的進位作為邏輯表達式的輸入"
    },
    {
      "start": 199.18,
      "end": 205.25,
      "text": "而本位和以及本位向高位的進位作為邏輯表達式的輸出"
    },
