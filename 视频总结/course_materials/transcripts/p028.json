      "start": 763.36,
      "end": 765.44,
      "text": "這就是左側這個實現了"
    },
    {
      "start": 765.44,
      "end": 769.17,
      "text": "一位二進制加法運算的邏輯電路的符號"
    },
    {
      "start": 769.17,
      "end": 771.73,
      "text": "我們將其稱為全家器"
    },
    {
      "start": 771.73,
      "end": 774.18,
      "text": "英文所寫詞為FA"
    },
    {
      "start": 774.18,
      "end": 775.46,
      "text": "全家的意思是"
    },
    {
      "start": 775.46,
      "end": 778.29,
      "text": "帶有敬畏輸入CI"
    },
    {
      "start": 778.37,
      "end": 779.33,
      "text": "可以看到"
    },
    {
      "start": 779.33,
      "end": 780.37,
      "text": "符號表示"
    },
    {
      "start": 780.37,
      "end": 784.26,
      "text": "可以屏蔽掉邏輯電路的內部實現細節"
    },
    {
      "start": 784.26,
      "end": 787.71,
      "text": "對外僅給出輸入輸出端口即可"
    },
    {
      "start": 787.71,
      "end": 789.39,
      "text": "請同學們注意"
    },
    {
      "start": 789.39,
      "end": 791.23,
      "text": "除了一位全家器"
    },
    {
      "start": 791.23,
      "end": 793.39,
      "text": "還有一位半家器"
    },
    {
      "start": 793.39,
      "end": 796.19,
      "text": "半家器沒有敬畏輸入CI"
    },
    {
      "start": 796.19,
      "end": 797.79,
      "text": "所以其內部邏輯呢"
    },
    {
      "start": 797.79,
      "end": 801.04,
      "text": "只有一個易貨門和一個與門"
    },
    {
      "start": 801.04,
      "end": 804.83,
      "text": "其中易貨門用於產生本位和SI"
    },
    {
      "start": 804.83,
      "end": 806.35,
      "text": "與門用於產生"
    },
    {
      "start": 806.35,
      "end": 810.42,
      "text": "本位向高位的敬畏CI加1"
    },
    {
      "start": 810.42,
      "end": 811.3,
      "text": "好的"
    },
    {
      "start": 811.3,
      "end": 814.02,
      "text": "本節課到這裡就結束了"
    },
    {
      "start": 814.02,
      "end": 814.9,
      "text": "同學們"
    },
    {
      "start": 814.9,
      "end": 816.42,
      "text": "我們下節課見"
    }
