    {
      "start": 902.93,
      "end": 905.23,
      "text": "當檢測到RAW相關時"
    },
    {
      "start": 905.23,
      "end": 907.03,
      "text": "僅對一碼功能段後面的"
    },
    {
      "start": 907.03,
      "end": 910.23,
      "text": "這一個流水基存器進行清空即可"
    },
    {
      "start": 910.23,
      "end": 911.43,
      "text": "而不需要清空"
    },
    {
      "start": 911.43,
      "end": 914.63,
      "text": "一碼功能段前面的這個流水基存器"
    },
    {
      "start": 914.63,
      "end": 915.93,
      "text": "並且還要保證"
    },
    {
      "start": 915.93,
      "end": 918.33,
      "text": "程序技術器PC的值不變"
    },
    {
      "start": 918.33,
      "end": 919.73,
      "text": "這樣就暫停了"
    },
    {
      "start": 919.73,
      "end": 921.73,
      "text": "對處於旗幟功能段的指令"
    },
    {
      "start": 921.73,
      "end": 924.73,
      "text": "以及處於一碼功能段的指令的處理"
    },
    {
      "start": 924.73,
      "end": 926.03,
      "text": "要實現這一點"
    },
    {
      "start": 926.03,
      "end": 927.93,
      "text": "需要控制程序技術器PC"
    },
    {
      "start": 927.93,
      "end": 930.43,
      "text": "和該流水基存器的使能端"
    },
    {
      "start": 930.43,
      "end": 932.33,
      "text": "當使能端唯一時"
    },
    {
      "start": 932.33,
      "end": 935.13,
      "text": "PC和該流水基存器正常工作"
    },
    {
      "start": 935.13,
      "end": 936.03,
      "text": "為零時"
    },
    {
      "start": 936.03,
      "end": 937.43,
      "text": "忽略使用輸入"
    },
    {
      "start": 937.43,
      "end": 939.43,
      "text": "PC和該流水基存器的值"
    },
    {
      "start": 939.43,
      "end": 940.73,
      "text": "保持不變"
    },
    {
      "start": 940.73,
      "end": 941.83,
      "text": "從上所說"
    },
    {
      "start": 941.83,
      "end": 944.93,
      "text": "就可以得出如下所示的處理邏輯"
    },
    {
      "start": 944.93,
      "end": 946.23,
      "text": "該處理邏輯"
    },
    {
      "start": 946.23,
      "end": 949.23,
      "text": "即處理由分支指令引起的控制衝突"
    },
    {
      "start": 949.23,
      "end": 953.23,
      "text": "也處理由RAW相關引起的RAW衝突"
    },
    {
      "start": 953.23,
      "end": 954.93,
      "text": "我們來分析一下"
    },
    {
      "start": 954.93,
      "end": 959.13,
      "text": "將RAW相關檢測結果作為暫停信號STELL"
    },
    {
      "start": 959.13,
      "end": 961.53,
      "text": "取反後送入PC的使能端"
    },
    {
      "start": 961.53,
      "end": 963.53,
      "text": "和該流水基存器的使能端"
    },
    {
      "start": 963.53,
      "end": 969.83,
      "text": "如同所示"
    },
    {
      "start": 969.83,
      "end": 971.53,
      "text": "若出現分支跳轉"
    },
    {
      "start": 971.53,
      "end": 976.52,
      "text": "則要清空該流水基存器"
    },
    {
      "start": 976.52,
      "end": 977.92,
      "text": "若出現分支跳轉"
    },
    {
      "start": 977.92,
      "end": 979.62,
      "text": "或RAW相關時"
    },
    {
      "start": 979.62,
      "end": 984.68,
      "text": "需要清空這個流水基存器"
    },
    {
      "start": 984.68,
      "end": 988.58,
      "text": "這次就可以基於以上得出的邏輯表達式"
    },
    {
      "start": 988.58,
      "end": 991.88,
      "text": "設計RAW相關處理的組合邏輯電路了"
    },
    {
      "start": 991.88,
      "end": 993.78,
      "text": "我們就不再繼續介紹了"
    },
    {
      "start": 993.78,
      "end": 996.75,
      "text": "因為這是數點相關課程的內容"
    },
    {
      "start": 996.75,
      "end": 997.55,
      "text": "接下來"
    },
    {
      "start": 997.55,
      "end": 1001.25,
      "text": "為了加深同學們對氣泡流水線的理解和記憶"
    },
    {
      "start": 1001.25,
      "end": 1004.05,
      "text": "請同學們自行完成該練習"
    },
    {
      "start": 1004.05,
      "end": 1005.05,
      "text": "提示一下"
    },
    {
      "start": 1005.05,
      "end": 1006.05,
      "text": "一碼公衆段"
    },
    {
      "start": 1006.05,
      "end": 1008.85,
      "text": "與寫回公衆段的RAW衝突"
    },
    {
      "start": 1008.85,
      "end": 1012.75,
      "text": "以採用對CPU的使用信號的功能劃分解決了"
    },
    {
      "start": 1012.75,
      "end": 1013.75,
      "text": "換句話說"
    },
    {
      "start": 1013.75,
      "end": 1018.24,
      "text": "一碼公衆段與寫回公衆段不存在RAW相關"
    },
    {
      "start": 1018.24,
      "end": 1021.94,
      "text": "而一碼公衆段與執行公衆段的RAW衝突"
    },
    {
      "start": 1021.94,
      "end": 1025.34,
      "text": "一碼公衆段與仿存公衆段的RAW衝突"
    },
    {
      "start": 1025.34,
      "end": 1027.8,
      "text": "採用插入氣泡解決"
    },
    {
      "start": 1027.8,
      "end": 1031.8,
      "text": "以上都是我們本節課給同學們介紹過的內容"
    },
    {
      "start": 1031.8,
      "end": 1032.5,
      "text": "好的"
    },
    {
      "start": 1032.5,
      "end": 1034.9,
      "text": "請同學們暫停播放視頻"
    },
    {
      "start": 1034.9,
      "end": 1041.52,
      "text": "務必動手練習一下"
    },
    {
      "start": 1041.52,
      "end": 1042.32,
      "text": "好的"
    },
    {
      "start": 1042.32,
      "end": 1045.82,
      "text": "接下來我們給出該題的動畫解題過程"
    },
    {
      "start": 1045.82,
      "end": 1047.72,
      "text": "相信同學們都能看懂"
    },
    {
      "start": 1047.72,
      "end": 1090.36,
      "text": "就不再進行口頭講解了"
    },
    {
      "start": 1090.36,
      "end": 1091.06,
      "text": "好的"
    },
    {
      "start": 1091.06,
      "end": 1093.16,
      "text": "本節課到這裡就結束了"
    },
    {
      "start": 1093.16,
      "end": 1108.97,
      "text": "請同學們快速回憶一下本節課的主要內容"
    },
    {
      "start": 1108.97,
      "end": 1109.77,
      "text": "同學們"
    },
    {
      "start": 1109.77,
      "end": 1110.97,
      "text": "我們下節課見"
    }
  ]
}