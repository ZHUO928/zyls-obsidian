    {
      "start": 769.12,
      "end": 770.62,
      "text": "一碼功能段中的指令"
    },
    {
      "start": 770.62,
      "end": 774.75,
      "text": "與仿存功能段中的指令存在RAW相關"
    },
    {
      "start": 774.75,
      "end": 777.75,
      "text": "將RAW相關檢測邏輯生成的信號"
