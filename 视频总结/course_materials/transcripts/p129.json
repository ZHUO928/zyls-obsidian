    {
      "start": 777.75,
      "end": 779.85,
      "text": "這位RAW Hazard"
    },
    {
      "start": 779.85,
      "end": 783.35,
      "text": "我們來寫出生成該信號的邏輯表達式"
    },
    {
      "start": 783.35,
      "end": 784.75,
      "text": "這部分的含義是"
    },
    {
      "start": 784.75,
      "end": 788.45,
      "text": "處於一碼功能段的指令需要讀RS基存器"
    },
    {
      "start": 788.45,
      "end": 791.25,
      "text": "並且RS基存器的編號不為零"
    },
    {
      "start": 791.25,
      "end": 794.75,
      "text": "因為編號為零的基存器是橫零基存器"
    },
    {
      "start": 794.75,
      "end": 797.55,
      "text": "也就是讀出為零寫入無效"
    },
    {
      "start": 797.55,
      "end": 801.74,
      "text": "因此不需要考慮零號基存器的RAW相關"
    },
    {
      "start": 801.74,
      "end": 803.34,
      "text": "這部分的含義是"
    },
    {
      "start": 803.34,
      "end": 805.14,
      "text": "處於執行功能段的指令"
    },
    {
      "start": 805.14,
      "end": 808.24,
      "text": "其相應的寫基存器控制信號為1"
    },
    {
      "start": 808.24,
      "end": 813.0,
      "text": "這意味著該指令最終會對基存器進行寫操作"
    },
    {
      "start": 813.0,
      "end": 814.4,
      "text": "這部分的含義是"
    },
    {
      "start": 814.4,
      "end": 816.3,
      "text": "處於執行功能段的指令"
    },
    {
      "start": 816.3,
      "end": 819.3,
      "text": "其最終寫基存器時使用的編號"
    },
    {
      "start": 819.3,
      "end": 821.3,
      "text": "與處於一碼功能段的指令"
    },
    {
      "start": 821.3,
      "end": 823.7,
      "text": "足基存器時使用的編號相同"
    },
    {
      "start": 823.7,
      "end": 826.2,
      "text": "也就是同一個基存器"
    },
    {
      "start": 826.2,
      "end": 829.8,
      "text": "當以上三部分全部成立時就表明"
    },
    {
      "start": 829.8,
      "end": 832.6,
      "text": "檢測到了當前處於一碼功能段的指令"
    },
    {
      "start": 832.6,
      "end": 834.8,
      "text": "與處於執行功能段的指令"
    },
    {
      "start": 834.8,
      "end": 838.9,
      "text": "在RS基存器的訪問上存在RAW相關"
    },
    {
      "start": 838.9,
      "end": 840.4,
      "text": "同理和寫出"
    },
    {
      "start": 840.4,
      "end": 842.9,
      "text": "檢測當前處於一碼功能段的指令"
    },
    {
      "start": 842.9,
      "end": 845.0,
      "text": "與處於執行功能段的指令"
    },
    {
      "start": 845.0,
      "end": 850.26,
      "text": "在RT基存器的訪問上存在RAW相關的邏輯表達式"
    },
    {
      "start": 850.26,
      "end": 851.86,
      "text": "參照這兩個表達式"
    },
    {
      "start": 851.86,
      "end": 852.96,
      "text": "分別寫出"
    },
    {
      "start": 852.96,
      "end": 855.66,
      "text": "檢測當前處於一碼功能段的指令"
    },
    {
      "start": 855.66,
      "end": 857.76,
      "text": "與處於仿存功能段的指令"
    },
    {
      "start": 857.76,
      "end": 859.36,
      "text": "在RS基存器"
    },
    {
      "start": 859.36,
      "end": 864.97,
      "text": "RT基存器的訪問上存在RAW相關的邏輯表達式"
    },
    {
      "start": 864.97,
      "end": 866.57,
      "text": "以上四行表達式"
    },
    {
      "start": 866.57,
      "end": 868.47,
      "text": "其中任何一行結果唯一"
    },
    {
      "start": 868.47,
      "end": 871.67,
      "text": "就表明檢測到了RAW相關"
    },
    {
      "start": 871.67,
      "end": 875.17,
      "text": "因此將這四行表達式進行邏輯獲"
    },
    {
      "start": 875.17,
      "end": 878.53,
      "text": "即可得到RAW相關的檢測結果"
    },
    {
      "start": 878.53,
      "end": 881.43,
      "text": "當RAW相關的檢測結果唯一時"
    },
