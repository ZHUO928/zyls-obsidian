    },
    {
      "start": 361.85,
      "end": 365.21,
      "text": "將正三的補碼的全部位暗位取反"
    },
    {
      "start": 365.21,
      "end": 367.4,
      "text": "這是得到的結果"
    },
    {
      "start": 367.4,
      "end": 369.44,
      "text": "再將其墨尾加1"
    },
    {
      "start": 369.44,
      "end": 373.76,
      "text": "可以發現可以正確得到付三的補碼"
    },
    {
      "start": 373.76,
      "end": 375.2,
      "text": "我們來驗證一下"
    },
    {
      "start": 375.2,
      "end": 378.64,
      "text": "將付三的補碼通過全部位暗位取反"
    },
    {
      "start": 378.64,
