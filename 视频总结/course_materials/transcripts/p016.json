    },
    {
      "start": 403.32,
      "end": 405.64,
      "text": "請同學們思考一下"
    },
    {
      "start": 405.64,
      "end": 407.88,
      "text": "一支原碼、凡碼、補碼"
    },
    {
      "start": 407.88,
      "end": 414.6,
      "text": "如何算出爭執的實境之形式呢"
    },
    {
      "start": 414.68,
      "end": 418.81,
      "text": "這需要分正數和負數兩種情況"
    },
    {
      "start": 418.81,
      "end": 421.05,
      "text": "當真值是正數時"
    },
    {
      "start": 421.05,
      "end": 423.45,
      "text": "將原碼、凡碼、補碼的數值位"
    },
    {
      "start": 423.45,
      "end": 425.29,
      "text": "按權展開相加"
    },
    {
      "start": 425.29,
      "end": 427.96,
      "text": "符號位的0表示正號"
    },
    {
      "start": 427.96,
      "end": 430.28,
      "text": "當真值是負數時"
    },
    {
      "start": 430.28,
      "end": 432.84,
      "text": "將凡碼、補碼轉換成原碼"
    },
    {
      "start": 432.84,
      "end": 434.52,
      "text": "然後將原碼的數值位"
    },
    {
      "start": 434.52,
      "end": 436.2,
      "text": "按權展開相加"
    },
    {
      "start": 436.2,
      "end": 439.64,
      "text": "符號位的1表示負號"
    },
    {
      "start": 439.64,
      "end": 440.6,
      "text": "當然了"
    },
    {
      "start": 440.6,
      "end": 442.28,
      "text": "如果同學們還記得"
    },
    {
      "start": 442.28,
      "end": 445.08,
      "text": "原碼、凡碼、補碼的定義式"
    },
    {
      "start": 445.08,
