  "segments": [
    {
      "start": 3.63,
      "end": 8.23,
      "text": "同学们好,欢迎大家来到我的计算机组成原理维克堂"
    },
    {
      "start": 8.23,
      "end": 12.75,
      "text": "本节课,我们介绍无符号战略惩罚器的相关知识"
    },
    {
      "start": 12.75,
      "end": 16.75,
      "text": "在之前的几次课中,我们分别给同学们介绍了"
    },
    {
      "start": 16.75,
      "end": 20.51,
      "text": "无符号数惩罚运算的硬件逻辑实现"
    },
    {
      "start": 20.51,
      "end": 24.62,
      "text": "原码一位惩罚运算的硬件逻辑实现"
    },
    {
      "start": 24.62,
      "end": 29.66,
      "text": "补码一位惩罚运算不思算法的硬件逻辑实现"
    },
    {
      "start": 29.66,
      "end": 34.76,
      "text": "然而,原码补码一位惩罚的硬件逻辑实现"
    },
    {
      "start": 34.92,
      "end": 36.8,
      "text": "需要在始终结拍下"
    },
    {
      "start": 36.8,
      "end": 38.8,
      "text": "通过控制逻辑的控制"
    },
    {
      "start": 38.8,
      "end": 43.08,
      "text": "执行相应轮次的加法右移操作来实现"
    },
    {
      "start": 43.08,
      "end": 44.58,
      "text": "速度缴慢"
    },
    {
      "start": 44.58,
      "end": 46.78,
      "text": "为了提高运算速度"
    },
    {
      "start": 46.78,
      "end": 49.54,
      "text": "可以仅采用组合逻辑电路"
    },
    {
      "start": 49.54,
      "end": 53.79,
      "text": "以专用硬件方式构建阵略惩罚器"
    },
    {
      "start": 53.79,
      "end": 56.39,
      "text": "构建阵略惩罚器的基本思想是"
    },
    {
      "start": 56.39,
      "end": 60.0,
      "text": "模仿二进制惩罚的比算方法"
    },
    {
      "start": 60.0,
      "end": 64.97,
      "text": "那么接下来呢,我们来一起构建无符号阵略惩罚器"
    },
    {
      "start": 65.17,
      "end": 67.57,
      "text": "首先,我们来回忆一下"
    },
    {
      "start": 67.57,
      "end": 70.62,
      "text": "二进制惩罚的比算方法"
    },
    {
      "start": 70.62,
      "end": 74.1,
      "text": "假设备成数X为无符号数"
    },
    {
      "start": 74.1,
      "end": 77.42,
      "text": "从D位X0到高位X3"
    },
    {
      "start": 77.42,
      "end": 79.4,
      "text": "共4位构成"
    },
    {
      "start": 79.4,
      "end": 81.72,
      "text": "成数Y为无符号数"
    },
    {
      "start": 81.72,
      "end": 84.52,
      "text": "从D位Y0到高位Y3"
    },
    {
      "start": 84.52,
      "end": 86.48,
      "text": "共4位构成"
    },
    {
      "start": 86.48,
      "end": 88.84,
      "text": "对它们进行惩罚运算"
    },
    {
      "start": 88.84,
      "end": 91.12,
      "text": "从最低位开始"
    },
    {
      "start": 91.12,
      "end": 93.68,
      "text": "用成数Y的最低位Y0"
    },
    {
      "start": 93.72,
      "end": 97.28,
      "text": "乘以备成数X的最低位X0"
    },
    {
      "start": 97.28,
      "end": 99.24,
      "text": "得到一位结果"
    },
    {
      "start": 99.24,
      "end": 101.65,
      "text": "既为X0Y0"
    },
    {
      "start": 101.65,
      "end": 102.61,
      "text": "我们知道"
    },
    {
      "start": 102.61,
      "end": 104.41,
      "text": "对于一位二进制数"
    },
    {
      "start": 104.41,
      "end": 107.27,
      "text": "要么是1,要么是0"
    },
    {
      "start": 107.27,
      "end": 109.59,
      "text": "用成数Y的最低位Y0"
    },
    {
      "start": 109.59,
      "end": 112.95,
