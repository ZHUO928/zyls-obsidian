    {
      "start": 592.47,
      "end": 594.38,
      "text": "没有近位依赖"
    },
    {
      "start": 594.38,
      "end": 596.78,
      "text": "但是第二行内的全家界"
    },
    {
      "start": 596.78,
      "end": 600.1,
      "text": "与第一行内的全家界有近位依赖"
    },
    {
      "start": 600.1,
      "end": 603.46,
      "text": "如同所示"
    },
    {
      "start": 603.46,
      "end": 605.26,
      "text": "第三行内的全家界"
    },
    {
      "start": 605.26,
      "end": 608.54,
      "text": "与第二行内的全家界有近位依赖"
    },
    {
      "start": 608.54,
      "end": 612.14,
      "text": "如同所示"
    },
    {
      "start": 612.14,
      "end": 613.74,
