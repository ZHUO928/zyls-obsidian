    {
      "start": 632.17,
      "end": 636.53,
      "text": "M位串形近位加法器的时间延迟为2M加4"
    },
    {
      "start": 636.53,
      "end": 638.82,
      "text": "然后乘以T"
    },
    {
      "start": 638.82,
      "end": 642.06,
      "text": "根据上述有关时间延迟的分析"
    },
    {
      "start": 642.06,
      "end": 647.34,
      "text": "我们不能得出该阵列成法器的时间延迟"
