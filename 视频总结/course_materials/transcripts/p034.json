    },
    {
      "start": 566.51,
      "end": 568.71,
      "text": "此行内各全家界之间"
    },
    {
      "start": 568.71,
      "end": 573.14,
      "text": "也没有近位依赖并行执行"
    },
    {
      "start": 573.14,
      "end": 575.42,
      "text": "此行内各全家界之间"
    },
    {
      "start": 575.42,
      "end": 579.4,
      "text": "也没有近位依赖并行执行"
