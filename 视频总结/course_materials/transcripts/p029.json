    },
    {
      "start": 771.56,
      "end": 773.96,
      "text": "与第三条语句非常相似"
    },
    {
      "start": 773.96,
      "end": 775.96,
      "text": "我们就不再坠述了"
    },
    {
      "start": 775.96,
      "end": 779.4,
      "text": "将相关内容填入上表即可"
