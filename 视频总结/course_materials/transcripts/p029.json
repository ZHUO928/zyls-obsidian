    {
      "start": 687.44,
      "end": 689.14,
      "text": "我们一起来分析"
    },
    {
      "start": 689.14,
      "end": 692.44,
      "text": "我们首先根据题目给定的C元程序段"
    },
    {
      "start": 692.44,
      "end": 694.9,
      "text": "来填写这个表格"
    },
