    },
    {
      "start": 763.67,
      "end": 767.4,
      "text": "因此该内容的最高位为符号位"
    },
    {
      "start": 767.4,
      "end": 770.46,
      "text": "将相关内容填入上表即可"
    },
    {
      "start": 770.46,
      "end": 771.56,
