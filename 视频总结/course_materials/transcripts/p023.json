{
  "file": "p023.mp3",
  "duration": 1257.59275,
  "language": "zh",
  "segments": [
    {
      "start": 4.02,
      "end": 8.44,
      "text": "同學們好,歡迎大家來到我的計算機組成原理威克堂"
    },
    {
      "start": 8.44,
      "end": 11.46,
      "text": "本節課我們介紹算數儀位運算"
    },
    {
      "start": 11.46,
      "end": 15.12,
      "text": "在上節課中我們學習了邏輯儀位運算"
    },
    {
      "start": 15.12,
      "end": 17.72,
      "text": "邏輯儀位的對象是無符號數"
    },
    {
      "start": 17.72,
      "end": 20.64,
      "text": "而本節課將要介紹的算數儀位運算"
    },
    {
      "start": 20.64,
      "end": 22.96,
      "text": "其對象是有符號數"
    },
    {
      "start": 22.96,
      "end": 26.04,
      "text": "這裡的有符號數是指定點數"
    },
    {
      "start": 26.04,
      "end": 29.04,
      "text": "包括定點整數和定點小數"
    },
    {
      "start": 29.04,
      "end": 31.06,
      "text": "不論正數還是負數"
    },
    {
      "start": 31.06,
      "end": 32.7,
      "text": "符號位保持不變"
    },
    {
      "start": 32.7,
      "end": 35.09,
      "text": "僅對數值位進行儀位"
    },
    {
      "start": 35.09,
      "end": 39.33,
      "text": "對真值的圓碼、反碼和補碼進行算數儀位號"
    },
    {
      "start": 39.33,
      "end": 43.33,
      "text": "他們各自所對應的新的真值應該保持一致"
    },
    {
      "start": 43.33,
      "end": 44.53,
      "text": "我們知道"
    },
    {
      "start": 44.53,
      "end": 46.37,
      "text": "當真值為正數時"
    },
    {
      "start": 46.37,
      "end": 49.37,
      "text": "真值的圓碼、反碼和補碼都相同"
    },
    {
      "start": 49.37,
      "end": 52.65,
      "text": "因此,對他們進行算數儀位號"
    },
    {
      "start": 52.65,
      "end": 55.17,
      "text": "他們各自所對應的新的真值"
    },
    {
      "start": 55.17,
      "end": 57.09,
      "text": "自然是保持一致的"
    },
    {
      "start": 57.09,
      "end": 59.45,
      "text": "對於儀位號出現的空位"
    },
    {
      "start": 59.45,
      "end": 61.08,
      "text": "規定填補零"
    },
    {
      "start": 61.28,
      "end": 63.2,
      "text": "而當真值為負數時"
    },
    {
      "start": 63.2,
      "end": 66.44,
      "text": "真值的圓碼、反碼和補碼各不相同"
    },
    {
      "start": 66.44,
      "end": 69.6,
      "text": "因此,對他們進行算數儀位號"
    },
    {
      "start": 69.6,
      "end": 73.88,
      "text": "為了確保他們各自所對應的新的真值保持一致"
    },
    {
      "start": 73.88,
      "end": 76.44,
      "text": "對於儀位號出現的空位"
    },
    {
      "start": 76.44,
      "end": 78.6,
      "text": "填補規則各不相同"
    },
    {
      "start": 78.6,
      "end": 83.44,
      "text": "我們稍後會推導給出他們各自具體的填補規則"
    },
    {
      "start": 83.44,
      "end": 85.53,
      "text": "首先來看這個例子"
    },
    {
      "start": 85.53,
      "end": 88.17,
      "text": "假設機器數自長為8位"
    },
    {
      "start": 88.17,
      "end": 89.93,
      "text": "含1位符號位"
    },
    {
      "start": 90.05,
      "end": 92.49,
      "text": "若真值X等於正的26"
    },
    {
      "start": 92.49,
      "end": 95.57,
      "text": "請寫出X的圓碼、反碼、補碼"
    },
    {
      "start": 95.57,
      "end": 97.61,
      "text": "各自算數左移1位"
    },
    {
      "start": 97.61,
      "end": 100.09,
      "text": "2位3位後的表示形式"
    },
    {
      "start": 100.09,
      "end": 102.49,
      "text": "以及對應的真值ABC"
    },
    {
      "start": 102.49,
      "end": 105.17,
      "text": "並對儀位結果進行分析"
    },
    {
      "start": 105.17,
      "end": 107.58,
      "text": "我們來一起分析一下"
    },
    {
      "start": 107.58,
      "end": 111.18,
      "text": "這是本立給定的真值X的實進值"
    },
    {
      "start": 111.18,
      "end": 114.04,
      "text": "我們將其寫成二進值形式"
    },
    {
      "start": 114.04,
      "end": 118.68,
      "text": "進而,我們可以寫出真值X的圓碼、反碼和補碼"
    },
    {
      "start": 118.99,
      "end": 121.07,
      "text": "由於真值X為正數"
    },
    {
      "start": 121.07,
      "end": 124.83,
      "text": "因此X的圓碼、反碼和補碼都相同"
    },
    {
      "start": 124.83,
      "end": 127.98,
      "text": "本立給定機器數自長為8位"
    },
    {
      "start": 127.98,
      "end": 129.82,
      "text": "含1位符號位"
    },
    {
      "start": 129.82,
      "end": 133.82,
      "text": "因此X的圓碼、反碼和補碼都是8位的"
    },
    {
      "start": 133.82,
      "end": 136.38,
      "text": "符號位取之為0表示正數"
    },
    {
      "start": 136.38,
      "end": 138.7,
      "text": "剩餘7位為數值位"
    },
    {
      "start": 138.7,
      "end": 141.88,
      "text": "下面,我們以正數X的圓碼為例"
    },
    {
      "start": 141.88,
      "end": 143.96,
      "text": "對其進行算數1位"
    },
    {
      "start": 143.96,
      "end": 145.72,
      "text": "我們之前介紹了"
    },
    {
      "start": 145.72,
      "end": 147.8,
      "text": "不論正數還是復數"
    },
    {
      "start": 147.96,
      "end": 149.56,
      "text": "符號位保持不變"
    },
    {
      "start": 149.56,
      "end": 151.72,
      "text": "僅對數值位進行儀位"
    },
    {
      "start": 151.72,
      "end": 154.06,
      "text": "因此,對於本立"
    },
    {
      "start": 154.06,
      "end": 156.14,
      "text": "我們將符號位保持不變"
    },
    {
      "start": 156.14,
      "end": 159.26,
      "text": "僅對剩餘的7個數值位進行儀位"
    },
    {
      "start": 159.26,
      "end": 164.4,
      "text": "首先來看對X的圓碼進行算數左移儀位的操作"
    },
    {
      "start": 164.4,
      "end": 165.95,
      "text": "如讀所示"
    },
    {
      "start": 165.95,
      "end": 172.08,
      "text": "將移出的最高數值位B6的內容移除即可"
    },
    {
      "start": 172.08,
      "end": 176.48,
      "text": "而將移空的最低數值位B0的內容補0即可"
    },
    {
      "start": 177.13,
      "end": 182.17,
      "text": "這是對X的圓碼進行算數左移2位和3位的結果"
    },
    {
      "start": 182.17,
      "end": 184.17,
      "text": "相信同學們都能看懂"
    },
    {
      "start": 184.17,
      "end": 186.04,
      "text": "就不再墜數了"
    },
    {
      "start": 186.04,
      "end": 187.4,
      "text": "對比可知"
    },
    {
      "start": 187.4,
      "end": 190.36,
      "text": "算數左移1位號高位丟0"
    },
    {
      "start": 190.36,
      "end": 193.48,
      "text": "算數左移2位號高位丟0"
    },
    {
      "start": 193.48,
      "end": 196.81,
      "text": "算數左移3位號高位丟001"
    },
    {
      "start": 196.81,
      "end": 198.65,
      "text": "我們寫出真值X"
    },
    {
      "start": 198.65,
      "end": 202.25,
      "text": "以及將X的圓碼進行算數左移1位"
    },
    {
      "start": 202.25,
      "end": 203.61,
      "text": "算數左移2位"
    },
    {
      "start": 203.61,
      "end": 205.05,
      "text": "算數左移3位號"
    },
    {
      "start": 205.13,
      "end": 208.09,
      "text": "各自所對應的新的真值"
    },
    {
      "start": 208.09,
      "end": 209.29,
      "text": "不難看出"
    },
    {
      "start": 209.29,
      "end": 210.33,
      "text": "對於本例"
    },
    {
      "start": 210.33,
      "end": 213.37,
      "text": "算數左移1位號得到的新的真值"
    },
    {
      "start": 213.37,
      "end": 217.71,
      "text": "相當於原來的真值X乘以2的1次方"
    },
    {
      "start": 217.71,
      "end": 220.75,
      "text": "算數左移2位號得到的新的真值"
    },
    {
      "start": 220.75,
      "end": 224.99,
      "text": "相當於原來的真值X乘以2的2次方"
    },
    {
      "start": 224.99,
      "end": 226.11,
      "text": "上述之事"
    },
    {
      "start": 226.11,
      "end": 227.55,
      "text": "我們在第二章"
    },
    {
      "start": 227.55,
      "end": 231.15,
      "text": "浮練數的表示形式和表示範圍那些課中"
    },
    {
      "start": 231.15,
      "end": 232.67,
      "text": "已經涉及到了"
    },
    {
      "start": 232.67,
      "end": 235.23,
      "text": "只不過當時沒有深入討論"
    },
    {
      "start": 235.39,
      "end": 236.51,
      "text": "對於本例"
    },
    {
      "start": 236.51,
      "end": 239.47,
      "text": "算數左移3位號得到的新的真值"
    },
    {
      "start": 239.47,
      "end": 241.47,
      "text": "卻不滿足上述規律"
    },
    {
      "start": 241.47,
      "end": 243.71,
      "text": "而出現了錯誤的結果"
    },
    {
      "start": 243.71,
      "end": 247.23,
      "text": "這是因為高位丟棄的內容包含有1"
    },
    {
      "start": 247.23,
      "end": 249.47,
      "text": "這相當於一出了"
    },
    {
      "start": 249.47,
      "end": 251.71,
      "text": "再來看算數右移的情況"
    },
    {
      "start": 251.71,
      "end": 254.51,
      "text": "我們知道定點整數的小數點"
    },
    {
      "start": 254.51,
      "end": 258.04,
      "text": "默認銀行固定在最低數值位的右側"
    },
    {
      "start": 258.04,
      "end": 260.28,
      "text": "之前介紹算數左移時"
    },
    {
      "start": 260.28,
      "end": 262.68,
      "text": "我們並沒有強調這一點"
    },
    {
      "start": 262.68,
      "end": 264.68,
      "text": "在介紹算數右移時"
    },
    {
      "start": 264.76,
      "end": 266.68,
      "text": "我們卻強調了這一點"
    },
    {
      "start": 266.68,
      "end": 267.56,
      "text": "具體原因"
    },
    {
      "start": 267.56,
      "end": 269.4,
      "text": "等我們分析完成這個例子"
    },
    {
      "start": 269.4,
      "end": 271.31,
      "text": "大家就明白了"
    },
    {
      "start": 271.31,
      "end": 272.27,
      "text": "首先來看"
    },
    {
      "start": 272.27,
      "end": 276.11,
      "text": "對X的圓碼進行算數右移1位的操作"
    },
    {
      "start": 276.11,
      "end": 278.56,
      "text": "如讀所示"
    },
    {
      "start": 278.56,
      "end": 282.8,
      "text": "將移出的最低數值位B0的內容移除即可"
    },
    {
      "start": 282.8,
      "end": 287.31,
      "text": "而將移空的最高數值位B6的內容補0即可"
    },
    {
      "start": 287.31,
      "end": 291.47,
      "text": "這是對X的圓碼進行算數右移兩位的結果"
    },
    {
      "start": 291.47,
      "end": 295.95,
      "text": "將移出的數值位D位B1B0的內容移除即可"
    },
    {
      "start": 295.95,
      "end": 301.32,
      "text": "而將移空的數值位高位B6B5的內容補0即可"
    },
    {
      "start": 301.32,
      "end": 303.4,
      "text": "我們寫出針織X"
    },
    {
      "start": 303.4,
      "end": 306.92,
      "text": "以及將X的圓碼進行算數右移1位"
    },
    {
      "start": 306.92,
      "end": 308.44,
      "text": "算數右移兩位號"
    },
    {
      "start": 308.44,
      "end": 311.44,
      "text": "各自所對應的新的針織"
    },
    {
      "start": 311.44,
      "end": 312.64,
      "text": "不難看出"
    },
    {
      "start": 312.64,
      "end": 313.84,
      "text": "對於本例"
    },
    {
      "start": 313.84,
      "end": 317.04,
      "text": "算數右移1位號得到的新的針織"
    },
    {
      "start": 317.04,
      "end": 321.12,
      "text": "相當於原來的針織X除以二的一次方"
    },
    {
      "start": 321.12,
      "end": 324.51,
      "text": "或者說乘以二的負一次方"
    },
    {
      "start": 324.51,
      "end": 327.47,
      "text": "算數右移兩位號得到的新的針織"
    },
    {
      "start": 327.47,
      "end": 331.15,
      "text": "相當於原來的針織X除以二的二次方"
    },
    {
      "start": 331.15,
      "end": 333.95,
      "text": "或者說乘以二的負二次方"
    },
    {
      "start": 333.95,
      "end": 337.92,
      "text": "但是對於本例出現了精度缺失"
    },
    {
      "start": 337.92,
      "end": 341.44,
      "text": "這是因為被移除的D位包含有1"
    },
    {
      "start": 341.44,
      "end": 344.64,
      "text": "而1出現在小數點後的D位"
    },
    {
      "start": 344.64,
      "end": 349.42,
      "text": "該位的位權值為二的負一次方等於0.5"
    },
    {
      "start": 349.42,
      "end": 351.26,
      "text": "通過上述兩個舉例"
    },
    {
      "start": 351.34,
      "end": 354.14,
      "text": "我們可以得到當針織為正數時"
    },
    {
      "start": 354.14,
      "end": 357.98,
      "text": "其原碼繁碼和補碼進行算數一位號的結果"
    },
    {
      "start": 357.98,
      "end": 361.82,
      "text": "那就是左移相當於乘以二的N次方"
    },
    {
      "start": 361.82,
      "end": 364.11,
      "text": "N為左移的次數"
    },
    {
      "start": 364.11,
      "end": 367.39,
      "text": "右移相當於除以二的N次方"
    },
    {
      "start": 367.39,
      "end": 369.71,
      "text": "N為右移的次數"
    },
    {
      "start": 369.71,
      "end": 372.59,
      "text": "左移時若最高位丟1"
    },
    {
      "start": 372.59,
      "end": 374.43,
      "text": "則結果出錯"
    },
    {
      "start": 374.43,
      "end": 376.99,
      "text": "右移時若最低位丟1"
    },
    {
      "start": 376.99,
      "end": 379.32,
      "text": "則結果的精度缺失"
    },
    {
      "start": 379.48,
      "end": 380.36,
      "text": "接下來"
    },
    {
      "start": 380.36,
      "end": 383.56,
      "text": "請同學們完成兩個相關的練習"
    },
    {
      "start": 383.56,
      "end": 385.72,
      "text": "首先完成練習一"
    },
    {
      "start": 385.72,
      "end": 392.97,
      "text": "這是練習一的解析過程"
    },
    {
      "start": 392.97,
      "end": 394.81,
      "text": "我們就不再墜速了"
    },
    {
      "start": 394.81,
      "end": 397.29,
      "text": "再來完成練習二"
    },
    {
      "start": 397.29,
      "end": 404.54,
      "text": "這是練習二的解析過程"
    },
    {
      "start": 404.54,
      "end": 406.38,
      "text": "我們就不再墜速了"
    },
    {
      "start": 406.38,
      "end": 409.92,
      "text": "接下來我們介紹針織為負數時"
    },
    {
      "start": 409.92,
      "end": 411.52,
      "text": "算數一位的規則"
    },
    {
      "start": 411.52,
      "end": 414.6,
      "text": "我們知道當針織為負數時"
    },
    {
      "start": 414.6,
      "end": 417.56,
      "text": "針織的原碼繁碼和補碼各不相同"
    },
    {
      "start": 417.8,
      "end": 418.68,
      "text": "因此"
    },
    {
      "start": 418.68,
      "end": 421.0,
      "text": "對他們進行算數一位號"
    },
    {
      "start": 421.0,
      "end": 424.36,
      "text": "為了確保他們各自所對應的新的針織"
    },
    {
      "start": 424.36,
      "end": 425.8,
      "text": "保持一致"
    },
    {
      "start": 425.8,
      "end": 428.2,
      "text": "對於一位號出現的空位"
    },
    {
      "start": 428.2,
      "end": 430.6,
      "text": "填補規則各不相同"
    },
    {
      "start": 430.6,
      "end": 432.6,
      "text": "我們來舉例分析"
    },
    {
      "start": 432.6,
      "end": 433.88,
      "text": "圖中所示的是"
    },
    {
      "start": 433.88,
      "end": 436.04,
      "text": "某個針織X為正數時"
    },
    {
      "start": 436.04,
      "end": 438.4,
      "text": "其原碼表示形式"
    },
    {
