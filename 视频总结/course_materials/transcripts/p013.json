      "text": "該條件表明"
    },
    {
      "start": 1045.02,
      "end": 1046.86,
      "text": "真值X要麼是0"
    },
    {
      "start": 1046.86,
      "end": 1049.1,
      "text": "要麼是個正的純小數"
    },
    {
      "start": 1049.1,
      "end": 1052.7,
      "text": "其補碼表示就是真值X自身"
    },
    {
      "start": 1052.7,
      "end": 1053.5,
      "text": "只不過"
    },
    {
      "start": 1053.5,
      "end": 1056.14,
      "text": "此時X中的小數點左側的0"
    },
    {
      "start": 1056.14,
      "end": 1058.78,
      "text": "作為符號位表示正號"
    },
    {
      "start": 1058.78,
      "end": 1060.38,
      "text": "而該條件表明"
    },
    {
      "start": 1060.38,
      "end": 1062.54,
      "text": "真值X要麼是負1"
    },
    {
      "start": 1062.54,
      "end": 1064.86,
      "text": "要麼是個負的純小數"
    },
    {
      "start": 1064.86,
      "end": 1066.86,
      "text": "其補碼表示為魔數"
    },
    {
      "start": 1066.86,
      "end": 1069.49,
      "text": "加上負整數X本身"
    },
    {
      "start": 1069.49,
      "end": 1071.33,
      "text": "我們來舉例說明"
    },
    {
      "start": 1071.33,
      "end": 1072.21,
      "text": "例如"
    },
    {
      "start": 1072.21,
      "end": 1075.09,
      "text": "X等於正的0.001"
    },
    {
      "start": 1075.09,
      "end": 1076.45,
      "text": "則其補碼表示"
    },
    {
      "start": 1076.45,
      "end": 1081.58,
      "text": "可按該式寫出"
    },
    {
      "start": 1081.58,
      "end": 1082.62,
      "text": "又例如"
    },
    {
      "start": 1082.62,
      "end": 1085.66,
      "text": "X等於負的0.001"
    },
    {
      "start": 1085.66,
      "end": 1086.94,
      "text": "則其補碼表示"
    },
    {
      "start": 1086.94,
      "end": 1093.02,
      "text": "可按該式寫出"
    },
    {
      "start": 1093.02,
      "end": 1095.9,
      "text": "將2轉換成2金值小數形式"
