      "end": 577.2,
      "text": "表示正號"
    },
    {
      "start": 577.2,
      "end": 579.2,
      "text": "兜號右側為數值位"
    },
    {
      "start": 579.2,
      "end": 581.97,
      "text": "取值就是真值X"
    },
    {
      "start": 581.97,
      "end": 582.93,
      "text": "那一種是"
    },
    {
      "start": 582.93,
      "end": 584.21,
      "text": "X大於等於"
    },
    {
      "start": 584.21,
      "end": 587.09,
      "text": "-2的N次方小於0的情況"
    },
    {
      "start": 587.09,
      "end": 588.29,
      "text": "這種情況下"
    },
    {
      "start": 588.29,
      "end": 590.69,
      "text": "真值X是個負整數"
    },
    {
      "start": 590.69,
      "end": 592.13,
      "text": "其補碼表示為"
    },
    {
      "start": 592.13,
      "end": 595.33,
      "text": "魔數加上負整數X本身"
    },
    {
      "start": 595.33,
      "end": 597.44,
      "text": "我們來舉例說明"
    },
    {
      "start": 597.44,
      "end": 599.52,
      "text": "某計算機的字長為8位"
    },
    {
      "start": 599.52,
      "end": 601.68,
      "text": "真值X為定點整數"
    },
    {
      "start": 601.68,
      "end": 605.04,
      "text": "其二定值形式為負的10101"
    },
    {
      "start": 605.04,
      "end": 607.28,
      "text": "求真值X的補碼"
    },
    {
      "start": 607.28,
      "end": 608.32,
      "text": "本理給定"
    },
    {
      "start": 608.32,
      "end": 609.68,
      "text": "字長為8位"
