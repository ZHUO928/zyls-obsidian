      "text": "接下來"
    },
    {
      "start": 1015.92,
      "end": 1019.68,
      "text": "我們介紹定點小數的補碼定義的相關內容"
    },
    {
      "start": 1019.68,
      "end": 1022.24,
      "text": "假設真值X為定點小數"
    },
    {
      "start": 1022.24,
      "end": 1024.24,
      "text": "也就是純小數"
    },
    {
      "start": 1024.24,
      "end": 1026.96,
      "text": "小數點左側的位為最高位"
    },
    {
      "start": 1026.96,
      "end": 1028.8,
      "text": "也就是符號位"
    },
    {
      "start": 1028.8,
      "end": 1031.36,
      "text": "其位權值為2的0字方"
    },
    {
      "start": 1031.36,
      "end": 1034.96,
      "text": "而最高位敬位的位權值為2的1字方"
    },
    {
      "start": 1034.96,
      "end": 1038.05,
      "text": "計魔術為2的1字方等於2"
    },
    {
      "start": 1038.13,
      "end": 1040.61,
      "text": "相較於定點整數的補碼定義式"
    },
