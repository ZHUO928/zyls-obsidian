    {
      "start": 547.22,
      "end": 549.98,
      "text": "小於2的N次方的情況"
    },
    {
      "start": 549.98,
      "end": 551.82,
      "text": "這裡需要說明的是"
    },
    {
      "start": 551.82,
      "end": 554.62,
      "text": "由於N為真值X的補碼表示中"
    },
    {
      "start": 554.62,
      "end": 556.22,
      "text": "數值位的位數"
    },
    {
      "start": 556.3,
      "end": 557.1,
      "text": "因此"
    },
    {
      "start": 557.1,
      "end": 560.5,
      "text": "其最大值為2的N次方減1"
    },
    {
      "start": 560.5,
      "end": 562.34,
      "text": "所以我們得出的條件是"
    },
    {
      "start": 562.34,
      "end": 564.96,
      "text": "X小於2的N次方"
    },
    {
      "start": 564.96,
      "end": 566.24,
      "text": "這種情況下"
    },
    {
      "start": 566.24,
      "end": 568.24,
      "text": "真值X要么是0"
    },
    {
      "start": 568.24,
      "end": 570.24,
      "text": "要么是個正整數"
    },
    {
      "start": 570.24,
      "end": 573.68,
      "text": "因此其補碼表示為0兜號X"
    },
    {
      "start": 573.68,
      "end": 575.6,
