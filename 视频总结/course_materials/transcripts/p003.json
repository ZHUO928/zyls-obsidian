{
  "file": "p003.mp3",
  "duration": 864.3860625,
  "language": "zh",
  "segments": [
    {
      "start": 4.3,
      "end": 8.86,
      "text": "同學們好 歡迎大家來到我的計算機組成原理 微課堂"
    },
    {
      "start": 8.86,
      "end": 12.94,
      "text": "本節課 我們簡單介紹一下計算機的發展"
    },
    {
      "start": 12.94,
      "end": 17.14,
      "text": "需要說明的是 等課程中所謂的計算機"
    },
    {
      "start": 17.14,
      "end": 21.38,
      "text": "除特別指名外 具體是指電子數字計算機"
    },
    {
      "start": 21.38,
      "end": 26.54,
      "text": "1936年 英國數學家艾倫.圖林在其論文"
    },
    {
      "start": 26.54,
      "end": 30.22,
      "text": "論可計算數 及其在帕尼問題上的應用中"
    },
    {
      "start": 30.22,
      "end": 32.42,
      "text": "提出了一種十分簡單"
    },
    {
      "start": 32.5,
      "end": 35.78,
      "text": "但運算能力極強的理想計算裝置"
    },
    {
      "start": 35.78,
      "end": 40.26,
      "text": "用它來計算所有能想像的到的可計算還說"
    },
    {
      "start": 40.26,
      "end": 43.86,
      "text": "這一裝置只是一種理想的計算模型"
    },
    {
      "start": 43.86,
      "end": 46.74,
      "text": "或者說是一種理想中的計算機"
    },
    {
      "start": 46.74,
      "end": 49.08,
      "text": "又被稱為圖林機"
    },
    {
      "start": 49.08,
      "end": 51.62,
      "text": "圖林機由三部分組成"
    },
    {
      "start": 51.62,
      "end": 55.7,
      "text": "一條袋子 一個讀寫頭和一個控制裝置"
    },
    {
      "start": 55.7,
      "end": 58.42,
      "text": "能執行任何給定的計算"
    },
    {
      "start": 58.42,
      "end": 61.86,
      "text": "也就是能夠執行任何可能的任務"
    },
    {
      "start": 62.57,
      "end": 64.17,
      "text": "圖林的這一思想"
    },
    {
      "start": 64.17,
      "end": 67.13,
      "text": "實際上奠定了現代計算機的基礎"
    },
    {
      "start": 67.13,
      "end": 71.0,
      "text": "現代計算機實際上就是用相應的程序"
    },
    {
      "start": 71.0,
      "end": 74.81,
      "text": "來完成任何設定好的任務"
    },
    {
      "start": 74.81,
      "end": 79.37,
      "text": "1936年 圖林在普林斯頓高等研究院進修"
    },
    {
      "start": 79.37,
      "end": 81.29,
      "text": "遇見了馮東一曼"
    },
    {
      "start": 81.29,
      "end": 84.65,
      "text": "馮東一曼對圖林的論文極度讚賞"
    },
    {
      "start": 84.65,
      "end": 87.34,
      "text": "馮東一曼後來一再強調"
    },
    {
      "start": 87.34,
      "end": 90.94,
      "text": "他的存儲程序的思想主要來自圖林"
    },
    {
      "start": 90.94,
      "end": 93.7,
      "text": "有關馮東一曼計算機的特點"
    },
    {
      "start": 93.78,
      "end": 96.79,
      "text": "我們將在下節課介上"
    },
    {
      "start": 96.79,
      "end": 101.91,
      "text": "1938年 美國數學家信息論創始人湘農"
    },
    {
      "start": 101.91,
      "end": 103.91,
      "text": "在其碩士學位論文"
    },
    {
      "start": 103.91,
      "end": 107.03,
      "text": "紀念器和開關電路的符號分析中"
    },
    {
      "start": 107.03,
      "end": 109.35,
      "text": "深刻的揭示了布爾代數"
    },
    {
      "start": 109.35,
      "end": 111.67,
      "text": "與開關電路之間的聯繫"
    },
    {
      "start": 111.67,
      "end": 113.99,
      "text": "為數字電路設計與分析"
    },
    {
      "start": 113.99,
      "end": 116.81,
      "text": "奠定了堅持的數學基礎"
    },
    {
      "start": 116.81,
      "end": 118.65,
      "text": "這項開創性的研究"
    },
    {
      "start": 118.65,
      "end": 120.25,
      "text": "為計算機科學"
    },
    {
      "start": 120.25,
      "end": 122.73,
      "text": "電子工程與信息技術的發展"
    },
    {
      "start": 122.73,
      "end": 125.99,
      "text": "提供了重要的理論支持"
    },
    {
      "start": 125.99,
      "end": 130.23,
      "text": "世界上第一台真正意義上的電子數字計算機"
    },
    {
      "start": 130.23,
      "end": 133.75,
      "text": "是在1937年到1942年間"
    },
    {
      "start": 133.75,
      "end": 136.27,
      "text": "由美國埃爾瓦州立大學"
    },
    {
      "start": 136.27,
      "end": 139.11,
      "text": "物理系副教授阿塔納索夫"
    },
    {
      "start": 139.11,
      "end": 144.25,
      "text": "和當時還是物理系研究生的貝瑞合作研製成功的"
    },
    {
      "start": 144.25,
      "end": 147.05,
      "text": "稱為阿塔納索夫貝瑞計算機"
    },
    {
      "start": 147.05,
      "end": 149.35,
      "text": "簡稱為ABC"
    },
    {
      "start": 149.35,
      "end": 152.15,
      "text": "該計算機使用了300個電子管"
    },
    {
      "start": 152.15,
      "end": 153.43,
      "text": "不可編成"
    },
    {
      "start": 153.51,
      "end": 156.31,
      "text": "僅用於囚解線型方程組"
    },
    {
      "start": 156.31,
      "end": 157.83,
      "text": "只是一台樣機"
    },
    {
      "start": 157.83,
      "end": 161.7,
      "text": "並沒有完全實現阿塔納索夫的構想"
    },
    {
      "start": 161.7,
      "end": 163.22,
      "text": "1946年"
    },
    {
      "start": 163.22,
      "end": 165.3,
      "text": "默克利和艾克特"
    },
    {
      "start": 165.3,
      "end": 168.1,
      "text": "基於ABC計算機的設計思想"
    },
    {
      "start": 168.1,
      "end": 170.1,
      "text": "在美國軍方的支持"
    },
    {
      "start": 170.1,
      "end": 172.5,
      "text": "以及馮諾伊曼等人的幫助下"
    },
    {
      "start": 172.5,
      "end": 175.14,
      "text": "成功研製出了真正使用的"
    },
    {
      "start": 175.14,
      "end": 177.7,
      "text": "電子數字計算機艾尼阿克"
    },
    {
      "start": 177.7,
      "end": 181.62,
      "text": "艾尼阿克使用了18000個電子管"
    },
    {
      "start": 181.62,
      "end": 184.18,
      "text": "佔領面積170平方米"
    },
    {
      "start": 184.34,
      "end": 185.94,
      "text": "重達30噸"
    },
    {
      "start": 185.94,
      "end": 188.42,
      "text": "耗電功率150千瓦"
    },
    {
      "start": 188.42,
      "end": 190.58,
      "text": "採用實境制"
    },
    {
      "start": 190.58,
      "end": 194.42,
      "text": "運算速度為每秒5000次加法運算"
    },
    {
      "start": 194.42,
      "end": 196.9,
      "text": "每秒400次懲罰運算"
    },
    {
      "start": 196.9,
      "end": 199.38,
      "text": "以及平方和立方運算"
    },
    {
      "start": 199.38,
      "end": 203.1,
      "text": "掙錢和漁嫌函數數值運算"
    },
    {
      "start": 203.1,
      "end": 206.98,
      "text": "當時主要用它進行彈道參數計算"
    },
    {
      "start": 206.98,
      "end": 209.06,
      "text": "60秒設成的彈道"
    },
    {
      "start": 209.06,
      "end": 211.86,
      "text": "計算時間由原來的20分鐘"
    },
    {
      "start": 211.86,
      "end": 215.03,
      "text": "可縮短到僅需30秒"
    },
    {
      "start": 215.19,
      "end": 218.87,
      "text": "默克利和艾克特製造完成艾尼阿克號"
    },
    {
      "start": 218.87,
      "end": 223.19,
      "text": "就立刻為其申請並獲得了美國專利"
    },
    {
      "start": 223.19,
      "end": 224.47,
      "text": "就是這個專利"
    },
    {
      "start": 224.47,
      "end": 228.39,
      "text": "導致了ABC和艾尼阿克之間長期的"
    },
    {
      "start": 228.39,
      "end": 232.9,
      "text": "世界上第一台電子數字計算機的頭銜之爭"
    },
    {
      "start": 232.9,
      "end": 234.34,
      "text": "1973年"
    },
    {
      "start": 234.34,
      "end": 238.6,
      "text": "美國民意蘇達地區法院給出了正式宣判"
    },
    {
      "start": 238.6,
      "end": 241.93,
      "text": "推翻並吊銷了默克利的專利"
    },
    {
      "start": 241.93,
      "end": 245.69,
      "text": "現在國際計算機界公認的事實是"
    },
    {
      "start": 245.69,
      "end": 248.89,
      "text": "第一台電子數字計算機的真正發明人"
    },
    {
      "start": 248.89,
      "end": 251.11,
      "text": "是阿塔納索夫"
    },
    {
      "start": 251.11,
      "end": 252.63,
      "text": "有興趣的同學"
    },
    {
      "start": 252.63,
      "end": 257.69,
      "text": "可自行產業默克利與阿塔納索夫之間的恩怨"
    },
    {
      "start": 257.69,
      "end": 260.25,
      "text": "從艾尼阿克誕生到現在"
    },
    {
      "start": 260.25,
      "end": 262.41,
      "text": "在這70多年的時間裡"
    },
    {
      "start": 262.41,
      "end": 264.95,
      "text": "伴隨著電子氣價的發展"
    },
    {
      "start": 264.95,
      "end": 267.03,
      "text": "電子數字計算機的發展"
    },
    {
      "start": 267.03,
      "end": 269.51,
      "text": "大致經歷了電子管計算機"
    },
    {
      "start": 269.51,
      "end": 271.03,
      "text": "經體管計算機"
    },
    {
      "start": 271.03,
      "end": 272.47,
      "text": "集成電路計算機"
    },
    {
      "start": 272.47,
      "end": 274.87,
      "text": "以及超大規模集成電路計算機"
    },
    {
      "start": 274.87,
      "end": 277.22,
      "text": "這四個階段"
    },
    {
      "start": 277.22,
      "end": 280.73,
      "text": "第一代計算機為電子管計算機"
    },
    {
      "start": 280.73,
      "end": 283.45,
      "text": "其邏輯人價採用電子管"
    },
    {
      "start": 283.45,
      "end": 288.33,
      "text": "運算速度一般為每秒幾千次到幾萬次"
    },
    {
      "start": 288.33,
      "end": 291.37,
      "text": "主存先後採用水銀延遲線"
    },
    {
      "start": 291.37,
      "end": 293.38,
      "text": "磁鼓磁芯"
    },
    {
      "start": 293.38,
      "end": 298.26,
      "text": "輸出設備採用穿孔卡片或穿孔紙袋"
    },
    {
      "start": 298.26,
      "end": 300.42,
      "text": "採用機器源編制程序"
    },
    {
      "start": 300.42,
      "end": 302.46,
      "text": "沒有操作系統"
    },
    {
      "start": 302.46,
      "end": 304.7,
      "text": "電子管計算機體積大"
    },
    {
      "start": 304.7,
      "end": 306.62,
      "text": "功耗高速度慢"
    },
    {
      "start": 306.62,
      "end": 308.06,
      "text": "可靠性差"
    },
    {
      "start": 308.06,
      "end": 311.27,
      "text": "主要應用於科學計算"
    },
    {
      "start": 311.27,
      "end": 314.71,
      "text": "第二代計算機為經體管計算機"
    },
    {
      "start": 314.71,
      "end": 317.54,
      "text": "其邏輯人價採用經體管"
    },
    {
      "start": 317.54,
      "end": 322.62,
      "text": "運算速度一般為每秒數十萬次至數百萬次"
    },
    {
      "start": 322.62,
      "end": 325.34,
      "text": "主存採用磁芯存儲器"
    },
    {
      "start": 325.34,
      "end": 329.26,
      "text": "輔存採用磁鼓和磁帶存儲器"
    },
    {
      "start": 329.26,
      "end": 333.64,
      "text": "輸出設備採用穿孔卡片或打贏機"
    },
    {
      "start": 333.64,
      "end": 336.6,
      "text": "主要採用會邊語言編制程序"
    },
    {
      "start": 336.6,
      "end": 340.7,
      "text": "並開始使用搜純、Cobo等高級語言"
    },
    {
      "start": 340.7,
      "end": 345.32,
      "text": "在這一階段出現了單道批處理系統"
    },
    {
      "start": 345.32,
      "end": 347.4,
      "text": "相對於電子管計算機"
    },
    {
      "start": 347.4,
      "end": 349.48,
      "text": "經體管計算機體積小"
    },
    {
      "start": 349.48,
      "end": 350.44,
      "text": "速度快"
    },
    {
      "start": 350.44,
      "end": 351.4,
      "text": "功耗低"
    },
    {
      "start": 351.4,
      "end": 353.46,
      "text": "可靠性高"
    },
    {
      "start": 353.46,
      "end": 357.45,
      "text": "第三代計算機為集成電路計算機"
    },
    {
      "start": 357.45,
      "end": 362.47,
      "text": "其邏輯人價和存儲器均可由集成電路實現"
    },
    {
      "start": 362.47,
      "end": 367.75,
      "text": "運算速度一般為每秒數百萬次到數千萬次"
    },
    {
      "start": 367.83,
      "end": 370.47,
      "text": "主存採用半導體存儲器"
    },
    {
      "start": 370.47,
      "end": 372.78,
      "text": "輔存以磁盤為主"
    },
    {
      "start": 372.78,
      "end": 377.75,
      "text": "出現了鍵盤、鼠標、顯示器等輸入輸出設備"
    },
    {
      "start": 377.75,
      "end": 379.27,
      "text": "在這一階段"
    },
    {
      "start": 379.27,
      "end": 381.43,
      "text": "高級語言進一步發展"
    },
    {
      "start": 381.43,
      "end": 383.03,
      "text": "出現了B語言"
    },
    {
      "start": 383.03,
      "end": 385.56,
      "text": "也就是C語言的前身"
    },
    {
      "start": 385.56,
      "end": 387.0,
      "text": "操作系統方面"
    },
    {
      "start": 387.0,
      "end": 391.13,
      "text": "出現了多道批處理系統和分識系統"
    },
    {
      "start": 391.13,
      "end": 393.37,
      "text": "相對於經體管計算機"
    },
    {
      "start": 393.37,
      "end": 397.85,
      "text": "集成電路計算機的體積和功耗都顯著減小"
    },
    {
      "start": 397.85,
      "end": 400.63,
      "text": "而可靠性大大提高"
    },
    {
      "start": 400.63,
      "end": 401.91,
      "text": "在這一階段"
    },
    {
      "start": 401.91,
      "end": 406.07,
      "text": "還出現了巨型機、大型機與小型機"
    },
    {
      "start": 406.07,
      "end": 408.3,
      "text": "同時發展的趨勢"
    },
    {
      "start": 408.3,
      "end": 412.89,
      "text": "計算機類型開始出現多樣化和系列化"
    },
    {
      "start": 412.89,
      "end": 416.25,
      "text": "軟件技術與外部設備快速發展"
    },
    {
      "start": 416.25,
      "end": 419.03,
      "text": "應用領域不斷擴大"
    },
    {
      "start": 419.03,
      "end": 423.27,
      "text": "第四代計算機為超大規模集成電路計算機"
    },
    {
      "start": 423.27,
      "end": 427.19,
      "text": "其邏輯人價採用超大規模集成電路"
    },
    {
      "start": 427.27,
      "end": 430.71,
      "text": "運算速度一般為每秒數十億次"
    },
    {
      "start": 430.71,
      "end": 433.32,
      "text": "甚至數千億次"
    },
    {
      "start": 433.32,
      "end": 436.52,
      "text": "除主存採用半導體存儲器外"
    },
    {
      "start": 436.52,
      "end": 439.56,
      "text": "輔存也可使用半導體存儲器"
    },
    {
      "start": 439.56,
      "end": 444.55,
      "text": "並且主存和輔存的容量都有顯著提升"
    },
    {
      "start": 444.55,
      "end": 445.99,
      "text": "在這一階段"
    },
    {
      "start": 445.99,
      "end": 448.31,
      "text": "出現了各種高級語言"
    },
    {
      "start": 448.31,
      "end": 449.59,
      "text": "例如C"
    },
    {
      "start": 449.59,
      "end": 450.55,
      "text": "C++"
    },
    {
      "start": 450.55,
      "end": 451.35,
      "text": "Java"
    },
    {
      "start": 451.35,
      "end": 452.63,
      "text": "Python等"
    },
    {
      "start": 452.63,
      "end": 456.44,
      "text": "並且發展出了現代操作系統"
    },
    {
      "start": 456.44,
      "end": 460.76,
      "text": "從上述電子數字計算機的發展歷程可以看出"
    },
    {
      "start": 460.76,
      "end": 464.04,
      "text": "其發展特點是體積越來越小"
    },
    {
      "start": 464.04,
      "end": 465.64,
      "text": "功耗越來越低"
    },
    {
      "start": 465.64,
      "end": 467.4,
      "text": "可靠性越來越高"
    },
    {
      "start": 467.4,
      "end": 469.62,
      "text": "運算速度越來越快"
    },
    {
      "start": 469.62,
      "end": 472.74,
      "text": "這些都依賴於電子氣價的發展"
    },
    {
      "start": 472.74,
      "end": 476.34,
      "text": "而且背後隱藏著眾多科學家"
    },
    {
      "start": 476.34,
      "end": 477.7,
      "text": "貝爾實驗室"
    },
    {
      "start": 477.7,
      "end": 479.22,
      "text": "先從半導體"
    },
    {
      "start": 479.22,
      "end": 480.5,
      "text": "德州儀器"
    },
    {
      "start": 480.5,
      "end": 481.54,
      "text": "英特爾"
    },
    {
      "start": 481.54,
      "end": 484.5,
      "text": "AMD等公司的傳奇故事"
    },
    {
      "start": 484.5,
      "end": 485.7,
      "text": "時間關係呢"
    },
    {
      "start": 485.78,
      "end": 488.26,
      "text": "我們就不再逐個介紹了"
    },
    {
      "start": 488.26,
      "end": 491.5,
      "text": "有興趣的同學可以自行查閱"
    },
    {
      "start": 491.5,
      "end": 493.18,
      "text": "方法很簡單"
    },
    {
      "start": 493.18,
      "end": 495.98,
      "text": "在B站搜索相關的關鍵詞"
    },
    {
      "start": 495.98,
      "end": 498.54,
      "text": "就可以找到很多科普阿普主"
    },
    {
      "start": 498.54,
      "end": 502.07,
      "text": "製作的相關科普小短片"
    },
    {
      "start": 502.07,
      "end": 502.71,
      "text": "這裡"
    },
    {
      "start": 502.71,
      "end": 504.31,
      "text": "我們要提一下的是"
    },
    {
      "start": 504.31,
      "end": 506.23,
      "text": "英特爾公司的創始人之一"
    },
    {
      "start": 506.23,
      "end": 507.75,
      "text": "哥德摩爾"
    },
    {
      "start": 507.75,
      "end": 509.43,
      "text": "他在1965年"
    },
    {
      "start": 509.43,
      "end": 513.43,
      "text": "接受美國電子雜誌的總編採訪時"
    },
    {
      "start": 513.43,
      "end": 515.51,
      "text": "對半導體集成電路上"
    },
    {
      "start": 515.59,
      "end": 517.75,
      "text": "可容納的經體管數量"
    },
    {
      "start": 517.75,
      "end": 520.31,
      "text": "性能和價格等發展趨勢"
    },
    {
      "start": 520.31,
      "end": 522.1,
      "text": "進行了預測"
    },
    {
      "start": 522.1,
      "end": 523.46,
      "text": "也就是"
    },
    {
      "start": 523.46,
      "end": 525.22,
      "text": "半導體集成電路上"
    },
    {
      "start": 525.22,
      "end": 527.54,
      "text": "可容納的經體管數量"
    },
    {
      "start": 527.54,
      "end": 530.58,
      "text": "大約每經過18到24個月"
    },
    {
      "start": 530.58,
      "end": 532.78,
      "text": "便會增加一倍"
    },
    {
      "start": 532.78,
      "end": 534.14,
      "text": "換句話說呢"
    },
    {
      "start": 534.14,
      "end": 535.18,
      "text": "處理器的性能"
    },
    {
      "start": 535.18,
      "end": 537.5,
      "text": "大約每兩年翻一倍"
    },
    {
      "start": 537.5,
      "end": 540.98,
      "text": "同時價格下降為之前的一半"
    },
    {
      "start": 540.98,
      "end": 544.18,
      "text": "這就是著名的摩爾定律"
    },
    {
      "start": 544.18,
      "end": 545.62,
      "text": "半導體集成電路"
    },
    {
      "start": 545.62,
      "end": 547.54,
      "text": "50多年的發展歷程"
    },
    {
      "start": 547.54,
      "end": 549.06,
      "text": "證明了摩爾定律"
    },
    {
      "start": 549.06,
      "end": 550.9,
      "text": "對半導體芯片工業"
    },
    {
      "start": 550.9,
      "end": 552.58,
      "text": "發展前景的預測"
    },
    {
      "start": 552.58,
      "end": 554.82,
      "text": "是基本準確的"
    },
    {
      "start": 554.82,
      "end": 555.78,
      "text": "近年來"
    },
    {
      "start": 555.78,
      "end": 557.86,
      "text": "隨著半導體芯片的設計"
    },
    {
      "start": 557.86,
      "end": 561.8,
      "text": "製造以及封裝和測試技術的發展"
    },
    {
      "start": 561.8,
      "end": 562.92,
      "text": "半導體工藝"
    },
    {
      "start": 562.92,
      "end": 565.99,
      "text": "以接近半導體集成電路極限"
    },
    {
      "start": 565.99,
      "end": 567.59,
      "text": "半導體芯片的發展"
    },
    {
      "start": 567.59,
      "end": 571.1,
      "text": "開始逐漸偏離摩爾定律的預測"
    },
    {
      "start": 571.1,
      "end": 573.02,
      "text": "從2013年開始"
    },
    {
      "start": 573.02,
      "end": 576.84,
      "text": "逐步放緩至三年翻一番"
    },
    {
      "start": 576.84,
      "end": 579.88,
      "text": "這是英爾公司的典型微處理器"
    },
    {
      "start": 579.88,
      "end": 581.4,
      "text": "也就是CPU"
    },
    {
      "start": 581.4,
      "end": 586.28,
      "text": "從1970年到2015年的發展情況"
    },
    {
      "start": 586.28,
      "end": 590.07,
      "text": "這是製程工藝的發展情況"
    },
    {
      "start": 590.07,
      "end": 594.92,
      "text": "這是集成經濟管數量的發展情況"
    },
    {
      "start": 594.92,
      "end": 596.68,
      "text": "我還深深的記得"
    },
    {
      "start": 596.68,
      "end": 598.12,
      "text": "我在1992年"
    },
    {
      "start": 598.12,
      "end": 601.29,
      "text": "擁有了自己的第一台計算機"
    },
    {
      "start": 601.29,
      "end": 606.57,
      "text": "當時採用的CPU是80386SX-33"
    },
    {
      "start": 606.57,
      "end": 608.57,
      "text": "這個33的意思就是"
    },
    {
      "start": 608.57,
      "end": 611.42,
      "text": "主頻只有33兆Hz"
    },
    {
      "start": 611.42,
      "end": 613.58,
      "text": "內存為2兆字節"
    },
    {
      "start": 613.58,
      "end": 616.02,
      "text": "硬盤為40兆字節"
    },
    {
      "start": 616.02,
      "end": 618.5,
      "text": "是的 大家沒有聽錯"
    },
    {
      "start": 618.5,
      "end": 621.46,
      "text": "這與今天的計算機硬件配置相比"
    },
    {
      "start": 621.46,
      "end": 623.9,
      "text": "簡直是天壤直別"
    },
    {
      "start": 623.9,
      "end": 625.9,
      "text": "當時使用的操作系統"
    },
    {
      "start": 625.9,
      "end": 629.27,
      "text": "是微軟公司的到此5.0"
    },
    {
      "start": 629.27,
      "end": 633.3,
      "text": "不知道同學們的第一台計算機的配置是什麼"
    },
    {
      "start": 633.3,
      "end": 637.22,
      "text": "使用的操作系統又是什麼"
    },
    {
      "start": 637.22,
      "end": 638.1,
      "text": "另外"
    },
    {
      "start": 638.1,
      "end": 640.9,
      "text": "再給同學們布置一個小任務"
    },
    {
      "start": 640.98,
      "end": 643.86,
      "text": "查查看自己當前使用的計算機"
    },
    {
      "start": 643.86,
      "end": 646.66,
      "text": "採用的CPU的具體型號"
    },
    {
      "start": 646.66,
      "end": 649.62,
      "text": "它的製程工藝是多少納米"
    },
    {
      "start": 649.62,
      "end": 653.29,
      "text": "集成經濟管數量又是多少"
    },
    {
      "start": 653.29,
      "end": 654.09,
      "text": "最後"
    },
    {
      "start": 654.09,
      "end": 655.69,
      "text": "我們再來簡單介紹一下"
    },
    {
      "start": 655.69,
      "end": 658.17,
      "text": "計算機軟件的發展"
    },
    {
      "start": 658.17,
      "end": 661.05,
      "text": "在計算機發展的早期階段"
    },
    {
      "start": 661.05,
      "end": 664.7,
      "text": "人們使用機器語言來編寫程序"
    },
    {
      "start": 664.7,
      "end": 666.78,
      "text": "機器語言用二進之代碼"
    },
    {
      "start": 666.78,
      "end": 669.83,
      "text": "來表示不同的機器指令"
    },
    {
      "start": 669.83,
      "end": 671.67,
      "text": "計算機能夠直接識別"
    },
    {
      "start": 671.67,
      "end": 674.65,
      "text": "和執行這些機器指令"
    },
    {
      "start": 674.65,
      "end": 677.45,
      "text": "這對編成人員的要求極高"
    },
    {
      "start": 677.45,
      "end": 679.45,
      "text": "一方面要求編成人員"
    },
    {
      "start": 679.45,
      "end": 682.57,
      "text": "對計算機的硬件結構非常熟悉"
    },
    {
      "start": 682.57,
      "end": 683.77,
      "text": "另一方面"
    },
    {
      "start": 683.77,
      "end": 685.53,
      "text": "機器語言可圖性差"
    },
    {
      "start": 685.53,
      "end": 688.02,
      "text": "一出錯和難排錯"
    },
    {
      "start": 688.02,
      "end": 690.58,
      "text": "為了克服機器語言的上述特點"
    },
    {
      "start": 690.58,
      "end": 692.58,
      "text": "發展出了會邊語言"
    },
    {
      "start": 692.58,
      "end": 694.42,
      "text": "它使用一些變於記憶"
    },
    {
      "start": 694.42,
      "end": 696.9,
      "text": "並且能夠表示指令功能的註記服"
    },
    {
      "start": 696.9,
      "end": 699.02,
      "text": "來編寫程序"
    },
    {
      "start": 699.02,
      "end": 701.34,
      "text": "儘管使用會邊語言編成"
    },
    {
      "start": 701.42,
      "end": 704.94,
      "text": "比使用機器語言編成的難度有所降低"
    },
    {
      "start": 704.94,
      "end": 706.46,
      "text": "但是會邊語言"
    },
    {
      "start": 706.46,
      "end": 709.1,
      "text": "仍然是面向機器語言"
    },
    {
      "start": 709.1,
      "end": 711.66,
      "text": "人們在使用會邊語言編成前"
    },
    {
      "start": 711.66,
      "end": 713.82,
      "text": "還是要花費很多時間"
    },
    {
      "start": 713.82,
      "end": 716.86,
      "text": "熟悉所使用計算機的指令級"
    },
    {
      "start": 716.86,
      "end": 720.3,
      "text": "然後才能使用其相應的符號語言"
    },
    {
      "start": 720.3,
      "end": 723.8,
      "text": "也就是會邊語言來編寫程序"
    },
    {
      "start": 723.8,
      "end": 726.95,
      "text": "因此還是很不方便"
    },
    {
      "start": 726.95,
      "end": 729.83,
      "text": "為了使不熟悉具體計算機硬件結構"
    },
    {
      "start": 729.83,
      "end": 731.51,
      "text": "和相應指令級的人"
    },
    {
      "start": 731.51,
      "end": 735.46,
      "text": "也能很方便地為計算機編寫程序"
    },
    {
      "start": 735.46,
      "end": 741.27,
      "text": "人們又創造了各種接近於人類語言的高級語言"
    },
    {
      "start": 741.27,
      "end": 744.87,
      "text": "世界上第一個高級語言是Falcon"
    },
    {
      "start": 744.87,
      "end": 750.98,
      "text": "而最簡單和亦於初學者使用的高級語言是Basic"
    },
    {
      "start": 750.98,
      "end": 755.67,
      "text": "Pasco被認為是編成語言的一個重要里程碑"
    },
    {
      "start": 755.67,
      "end": 760.28,
      "text": "而現代程序語言革命的起點是C語言"
    },
    {
      "start": 760.28,
      "end": 762.76,
      "text": "從上世紀90年代至今"
    },
    {
      "start": 762.84,
      "end": 764.95,
      "text": "是面向對象時代"
    },
    {
      "start": 764.95,
      "end": 770.17,
      "text": "最突出的特點為封裝性、繼承性和多態性"
    },
    {
      "start": 770.17,
      "end": 773.05,
      "text": "相信同學們都聽說過C++、"
    },
    {
      "start": 773.05,
      "end": 777.58,
      "text": "Java、Python等面向對象編成語言"
    },
    {
      "start": 777.58,
      "end": 779.18,
      "text": "除編成語言外"
    },
    {
      "start": 779.18,
      "end": 782.94,
      "text": "操作系統也伴隨著計算機硬件的每一次核心"
    },
    {
      "start": 782.94,
      "end": 784.54,
      "text": "而不斷發展"
    },
    {
      "start": 784.54,
      "end": 786.78,
      "text": "自20世紀70年代以來"
    },
    {
      "start": 786.78,
      "end": 788.78,
      "text": "操作系統百家真名"
    },
    {
      "start": 788.78,
      "end": 792.7,
      "text": "湧現出Unix、DOS、Windows、Linux、"
    },
    {
      "start": 792.7,
      "end": 795.67,
      "text": "MacOS等著名的操作系統"
    },
    {
      "start": 795.67,
      "end": 798.95,
      "text": "這部分內容會在操作系統課程中講述"
    },
    {
      "start": 798.95,
      "end": 801.46,
      "text": "本課程就不再墜速了"
    },
    {
      "start": 801.46,
      "end": 805.94,
      "text": "當前的計算機系統正朝著兩極化的趨勢發展"
    },
    {
      "start": 805.94,
      "end": 808.66,
      "text": "一極式向更微型化發展"
    },
    {
      "start": 808.66,
      "end": 810.5,
      "text": "注重在低功耗下"
    },
    {
      "start": 810.5,
      "end": 812.42,
      "text": "也能取得絞好的性能"
    },
    {
      "start": 812.42,
      "end": 814.1,
      "text": "就多用途"
    },
    {
      "start": 814.1,
      "end": 817.78,
      "text": "另一極是向更劇情化、超高速、"
    },
    {
      "start": 817.78,
      "end": 820.86,
      "text": "病情處理、智能化方向發展"
    },
    {
      "start": 820.86,
      "end": 821.66,
      "text": "目前"
    },
    {
      "start": 821.66,
      "end": 826.22,
      "text": "我國最快的超級計算機是神威太湖之光"
    },
    {
      "start": 826.22,
      "end": 830.15,
      "text": "每秒可進行9.3億次浮電運算"
    },
    {
      "start": 830.15,
      "end": 831.27,
      "text": "這個知識點"
    },
    {
      "start": 831.27,
      "end": 834.71,
      "text": "在2021年的408考試的題12"
    },
    {
      "start": 834.71,
      "end": 837.98,
      "text": "作為選擇題進行過考察"
    },
    {
      "start": 837.98,
      "end": 839.42,
      "text": "我們在之後的"
    },
    {
      "start": 839.42,
      "end": 842.78,
      "text": "計算機系統的性能指標的第二次課中"
    },
    {
      "start": 842.78,
      "end": 845.5,
      "text": "會再次遇到該知識點的考察"
    },
    {
      "start": 845.5,
      "end": 846.62,
      "text": "看看同學們"
    },
    {
      "start": 846.62,
      "end": 850.17,
      "text": "到時候能否給出正確答案"
    },
    {
      "start": 850.17,
      "end": 851.05,
      "text": "好的"
    },
    {
      "start": 851.05,
      "end": 853.61,
      "text": "本節課到這裡就結束了"
    },
    {
      "start": 853.61,
      "end": 860.12,
      "text": "我們將本節課的內容小節如下"
    },
    {
      "start": 860.12,
      "end": 860.92,
      "text": "同學們"
    },
    {
      "start": 860.92,
      "end": 862.6,
      "text": "我們下節課見"
    }
  ]
}