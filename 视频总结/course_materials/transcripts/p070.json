      "text": "提高开始利用率和命中率"
    },
    {
      "start": 1291.9,
      "end": 1292.78,
      "text": "这样的话"
    },
    {
      "start": 1292.78,
      "end": 1294.94,
      "text": "组相联应设的意义又何在呢"
    },
    {
      "start": 1296.73,
      "end": 1297.69,
      "text": "实际上"
    },
    {
      "start": 1297.69,
      "end": 1300.89,
      "text": "开始组所包含开场的数量GR"
    },
    {
      "start": 1301.53,
      "end": 1303.93,
      "text": "决定了数据化冲突的概率"
    },
    {
      "start": 1303.93,
      "end": 1306.25,
      "text": "和全相联并发比较的复杂性"
    },
    {
      "start": 1307.0,
      "end": 1307.72,
      "text": "GR越大"
    },
    {
      "start": 1308.28,
      "end": 1310.6,
      "text": "则发生数据化冲突的概率越低"
    },
    {
      "start": 1311.32,
      "end": 1314.04,
      "text": "但全相联并发比较电路越复杂"
    },
    {
      "start": 1314.97,
      "end": 1315.29,
      "text": "因此"
    },
    {
      "start": 1315.93,
      "end": 1317.29,
      "text": "选取适当的GR"
    },
    {
      "start": 1317.85,
      "end": 1320.49,
      "text": "可使组相联应设的硬件开销"
    },
    {
      "start": 1320.49,
      "end": 1323.37,
      "text": "比全相联应设的硬件开销低很多"
    },
    {
      "start": 1324.09,
      "end": 1325.21,
      "text": "而性能上"
    },
    {
      "start": 1325.21,
      "end": 1327.61,
      "text": "仍可接近全相联应设方式"
    },
    {
      "start": 1329.05,
      "end": 1330.49,
      "text": "早期开始容量不大"
    },
    {
      "start": 1331.13,
      "end": 1333.05,
      "text": "通常GR等于2或4"
    },
    {
      "start": 1333.85,
      "end": 1336.25,
      "text": "借两路或四路组相联"
    },
    {
      "start": 1337.37,
      "end": 1338.57,
      "text": "随着技术的发展"
    },
    {
      "start": 1339.13,
      "end": 1340.57,
      "text": "开始容量不断增大"
    },
    {
      "start": 1341.21,
      "end": 1343.13,
      "text": "GR的值也随之增大"
    },
    {
      "start": 1343.96,
      "end": 1345.96,
      "text": "目前很多处理器的开始"
    },
    {
      "start": 1346.04,
      "end": 1348.76,
      "text": "采用8路或16路组相联"
    },
    {
      "start": 1350.86,
      "end": 1351.42,
      "text": "好的"
    },
    {
      "start": 1351.74,
      "end": 1353.66,
      "text": "本节课到这里就结束了"
    },
    {
      "start": 1354.3,
      "end": 1356.46,
      "text": "请同学们快速回忆一下"
    },
    {
      "start": 1356.7,
      "end": 1358.38,
      "text": "本节课的主要内容"
    },
    {
      "start": 1364.6,
      "end": 1365.24,
      "text": "同学们"
    },
    {
      "start": 1365.4,
      "end": 1366.68,
      "text": "我们下节课见"
    }
  ]
}