{
  "file": "p070.mp3",
  "duration": 1370.906125,
  "language": "zh",
  "segments": [
    {
      "start": 3.22,
      "end": 7.74,
      "text": "同学们好,欢迎大家来到我的计算机组成员里维克堂"
    },
    {
      "start": 7.74,
      "end": 11.4,
      "text": "在前几次课中,我们分别给同学们介绍了"
    },
    {
      "start": 11.4,
      "end": 15.3,
      "text": "开始主存系统中地址硬设的两种方式"
    },
    {
      "start": 15.3,
      "end": 18.59,
      "text": "一种是直接硬设方式"
    },
    {
      "start": 18.59,
      "end": 21.79,
      "text": "另一种是全相连硬设方式"
    },
    {
      "start": 21.79,
      "end": 26.02,
      "text": "我们知道,直接硬设方式的开始命中率低"
    },
    {
      "start": 26.02,
      "end": 27.68,
      "text": "查找成本低"
    },
    {
      "start": 27.68,
      "end": 30.24,
      "text": "全相连硬设方式的命中率高"
    },
    {
      "start": 30.24,
      "end": 32.36,
      "text": "但查找成本也高"
    },
    {
      "start": 32.52,
      "end": 35.4,
      "text": "这两种方式的优缺点正好互补"
    },
    {
      "start": 35.4,
      "end": 38.84,
      "text": "将二者结合起来,可以取长补短"
    },
    {
      "start": 38.84,
      "end": 42.5,
      "text": "既提高命中率,又降低查找成本"
    },
    {
      "start": 42.5,
      "end": 45.22,
      "text": "这样就要产生了本节课"
    },
    {
      "start": 45.22,
      "end": 49.37,
      "text": "我们将要给同学们介绍的组相连硬设方式"
    },
    {
      "start": 49.37,
      "end": 51.53,
      "text": "组相连硬设的规则是"
    },
    {
      "start": 51.53,
      "end": 56.33,
      "text": "将开始中的所有行,划分成固定大小的组"
    },
    {
      "start": 56.33,
      "end": 60.7,
      "text": "每组包含K行,称为K路组相连"
    },
    {
      "start": 60.86,
      "end": 63.74,
      "text": "组存数据框,才用直接硬设方式"
    },
    {
      "start": 63.74,
      "end": 66.06,
      "text": "对应到开始中固定的组"
    },
    {
      "start": 66.06,
      "end": 68.06,
      "text": "这是硬设关系"
    },
    {
      "start": 68.06,
      "end": 72.14,
      "text": "既开始组号,等于组存数据框号"
    },
    {
      "start": 72.14,
      "end": 74.65,
      "text": "模上开始组数量"
    },
    {
      "start": 74.65,
      "end": 79.61,
      "text": "组存数据框在所对应的组内,才用全相连硬设"
    },
    {
      "start": 79.61,
      "end": 83.06,
      "text": "可对应到组内任何一个开始行"
    },
    {
      "start": 83.06,
      "end": 85.3,
      "text": "接下来,我们举例说明"
    },
    {
      "start": 85.3,
      "end": 88.41,
      "text": "组相连硬设的以上三个规则"
    },
    {
      "start": 88.49,
      "end": 89.85,
      "text": "如同所示"
    },
    {
      "start": 89.85,
      "end": 92.49,
      "text": "这是将开始中的所有开始行"
    },
    {
      "start": 92.49,
      "end": 95.77,
      "text": "每两行,划分为一个开始组"
    },
    {
      "start": 95.77,
      "end": 97.93,
      "text": "共划分出了N个组"
    },
    {
      "start": 97.93,
      "end": 100.84,
      "text": "组编号从0到N-1"
    },
    {
      "start": 100.84,
      "end": 103.48,
      "text": "由于每个组包含有两个行"
    },
    {
      "start": 103.48,
      "end": 106.42,
      "text": "因此成为二路组相连"
    },
    {
      "start": 106.42,
      "end": 112.7,
      "text": "这样,我们就解释了组相连硬设的第一条规则"
    },
    {
      "start": 112.7,
      "end": 114.06,
      "text": "如同所示"
    },
    {
      "start": 114.06,
      "end": 118.94,
      "text": "这是将组存划分成了M乘N个等长的数据块"
    },
    {
      "start": 119.02,
      "end": 123.26,
      "text": "数据块的编号从0到M乘N再减1"
    },
    {
      "start": 123.26,
      "end": 126.06,
      "text": "组相连硬设的第二条规则规定"
    },
    {
      "start": 126.06,
      "end": 129.1,
      "text": "组存数据块采用直接硬设方式"
    },
    {
      "start": 129.1,
      "end": 131.83,
      "text": "对应到开始中固定的组"
    },
    {
      "start": 131.83,
      "end": 137.11,
      "text": "可采用该式来计算组存数据块所对应的开始组"
    },
    {
      "start": 137.11,
      "end": 140.95,
      "text": "由于该式中的各个量都是恢复整数"
    },
    {
      "start": 140.95,
      "end": 145.93,
      "text": "因此,可将模运算简单看作是求予运算"
    },
    {
      "start": 145.93,
      "end": 148.65,
      "text": "例如,组存数据块号0"
    },
    {
      "start": 148.65,
      "end": 151.21,
      "text": "除以开始组的数量N"
    },
    {
      "start": 151.21,
      "end": 154.17,
      "text": "于数0就是开始组号"
    },
    {
      "start": 154.17,
      "end": 156.41,
      "text": "组存数据块号N-1"
    },
    {
      "start": 156.41,
      "end": 158.81,
      "text": "除以开始组的数量N"
    },
    {
      "start": 158.81,
      "end": 161.93,
      "text": "于数N-1就是开始组号"
    },
    {
      "start": 161.93,
      "end": 163.75,
      "text": "以此类推"
    },
    {
      "start": 163.75,
      "end": 166.47,
      "text": "又例如,组存数据块号N"
    },
    {
      "start": 166.47,
      "end": 168.63,
      "text": "除以开始组的数量N"
    },
    {
      "start": 168.63,
      "end": 171.3,
      "text": "于数0就是开始组号"
    },
    {
      "start": 171.3,
      "end": 173.78,
      "text": "组存数据块号2N-1"
    },
    {
      "start": 173.78,
      "end": 175.86,
      "text": "除以开始组的数量N"
    },
    {
      "start": 175.86,
      "end": 179.06,
      "text": "于数N-1就是开始组号"
    },
    {
      "start": 179.06,
      "end": 180.08,
      "text": "以此类推"
    },
    {
      "start": 180.76,
      "end": 181.52,
      "text": "又例如"
    },
    {
      "start": 181.78,
      "end": 184.6,
      "text": "主存数据块号m乘以n-n"
    },
    {
      "start": 185.1,
      "end": 185.62,
      "text": "除以"
    },
    {
      "start": 185.88,
      "end": 187.16,
      "text": "开始组的数量n"
    },
    {
      "start": 187.42,
      "end": 189.2,
      "text": "于数0就是开始组号"
    },
    {
      "start": 190.08,
      "end": 192.64,
      "text": "主存数据块号m乘以n然后-1"
    },
    {
      "start": 193.14,
      "end": 193.66,
      "text": "除以"
    },
    {
      "start": 193.92,
      "end": 195.2,
      "text": "开始组的数量n"
    },
    {
      "start": 195.46,
      "end": 196.72,
      "text": "于数n-1"
    },
    {
      "start": 196.98,
      "end": 198.26,
      "text": "就是开始组号"
    },
    {
      "start": 198.78,
      "end": 199.54,
      "text": "以此类推"
    },
    {
      "start": 200.65,
      "end": 202.97,
      "text": "组相连应设的第三条规则规定"
    },
    {
      "start": 203.49,
      "end": 206.03,
      "text": "主存数据块在所对应的组内"
    },
    {
      "start": 206.29,
      "end": 207.83,
      "text": "采用全相连应设"
    },
    {
      "start": 208.35,
      "end": 211.15,
      "text": "可对应到组内任何一个开始行"
    },
    {
      "start": 212.22,
      "end": 212.72,
      "text": "例如"
    },
    {
      "start": 213.24,
      "end": 214.52,
      "text": "0号主存数据块"
    },
    {
      "start": 214.78,
      "end": 217.34,
      "text": "在其所对应的0号开始组内"
    },
    {
      "start": 217.6,
      "end": 219.38,
      "text": "和对应任何一个开始行"
    },
    {
      "start": 220.45,
      "end": 221.21,
      "text": "又例如"
    },
    {
      "start": 221.73,
      "end": 224.03,
      "text": "m乘以n-1号主存数据块"
    },
    {
      "start": 224.53,
      "end": 227.09,
      "text": "在其所对应的n-1号开始组内"
    },
    {
      "start": 227.61,
      "end": 229.65,
      "text": "和对应任何一个开始行"
    },
    {
      "start": 230.49,
      "end": 231.25,
      "text": "实际上"
    },
    {
      "start": 231.51,
      "end": 233.05,
      "text": "组相连应设的规则2"
    },
    {
      "start": 233.57,
      "end": 234.33,
      "text": "等效率"
    },
    {
      "start": 234.59,
      "end": 235.61,
      "text": "将主存数据块"
    },
    {
      "start": 235.87,
      "end": 238.17,
      "text": "按开始组的数量进行了分区"
    },
    {
      "start": 238.96,
      "end": 239.88,
      "text": "每个分区中"
    },
    {
      "start": 240.14,
      "end": 241.78,
      "text": "包含的数据块的数量"
    },
    {
      "start": 242.04,
      "end": 243.84,
      "text": "与开始组的数量相同"
    },
    {
      "start": 244.86,
      "end": 246.4,
      "text": "每个分区中的数据块"
    },
    {
      "start": 246.66,
      "end": 248.96,
      "text": "各自对应某个固定的开始组"
    },
    {
      "start": 249.72,
      "end": 250.24,
      "text": "例如"
    },
    {
      "start": 250.74,
      "end": 252.02,
      "text": "0到n-1号"
    },
    {
      "start": 252.28,
      "end": 253.3,
      "text": "这n个数据块"
    },
    {
      "start": 253.82,
      "end": 256.64,
      "text": "各自固定对应n个开始组终的某一个"
    },
    {
      "start": 257.56,
      "end": 258.08,
      "text": "因此"
    },
    {
      "start": 258.34,
      "end": 259.36,
      "text": "这n个数据块"
    },
    {
      "start": 259.62,
      "end": 261.14,
      "text": "被划分为分去0"
    },
    {
      "start": 262.3,
      "end": 264.6,
      "text": "n到n-1号这n个数据块"
    },
    {
      "start": 265.12,
      "end": 268.18,
      "text": "各自固定对应n个开始组终的某一个"
    },
    {
      "start": 268.96,
      "end": 269.46,
      "text": "因此"
    },
    {
      "start": 269.76,
      "end": 270.76,
      "text": "这n个数据块"
    },
    {
      "start": 271.0,
      "end": 272.4,
      "text": "被划分为分区1"
    },
    {
      "start": 273.18,
      "end": 273.94,
      "text": "以此类推"
    },
    {
      "start": 274.38,
      "end": 278.72,
      "text": "n-n到n-1号这n个数据块"
    },
    {
      "start": 279.24,
      "end": 282.68,
      "text": "各自固定对应n个开始组终的某一个"
    },
    {
      "start": 283.44,
      "end": 283.98,
      "text": "因此"
    },
    {
      "start": 284.24,
      "end": 285.26,
      "text": "这n个数据块"
    },
    {
      "start": 285.52,
      "end": 287.18,
      "text": "被划分为分区m"
    },
    {
      "start": 288.29,
      "end": 290.61,
      "text": "在主存数据块有了分区号之后"
    },
    {
      "start": 291.11,
      "end": 292.19,
      "text": "我们就没有必要"
    },
    {
      "start": 292.45,
      "end": 294.49,
      "text": "对主存中的全部数据块"
    },
    {
      "start": 294.75,
      "end": 296.03,
      "text": "进行统一编号了"
    },
    {
      "start": 296.79,
      "end": 298.07,
      "text": "而是对每个分区中的"
    },
    {
      "start": 298.33,
      "end": 299.87,
      "text": "第一个数据块编号为0"
    },
    {
      "start": 300.37,
      "end": 301.91,
      "text": "后续每个数据块的编号"
    },
    {
      "start": 302.17,
      "end": 302.93,
      "text": "1次加1"
    },
    {
      "start": 303.45,
      "end": 305.37,
      "text": "直到该分区中的数据块"
    },
    {
      "start": 305.63,
      "end": 307.29,
      "text": "全部都编号完成"
    },
    {
      "start": 307.79,
      "end": 308.57,
      "text": "如同所示"
    },
    {
      "start": 312.62,
      "end": 313.14,
      "text": "这样"
    },
    {
      "start": 313.4,
      "end": 315.7,
      "text": "各分区中的各个数据块的编号"
    },
    {
      "start": 315.96,
      "end": 318.72,
      "text": "就与开始中各开始组的编号"
    },
    {
      "start": 318.98,
      "end": 320.3,
      "text": "1对应相等了"
    },
    {
      "start": 320.92,
      "end": 322.96,
      "text": "可能有些同学已经发现了"
    },
    {
      "start": 323.48,
      "end": 324.0,
      "text": "这样做"
    },
    {
      "start": 324.24,
      "end": 326.8,
      "text": "实际上是将原来用于主存中"
    },
    {
      "start": 327.06,
      "end": 329.36,
      "text": "全部数据块统一编号的比特数量"
    },
    {
      "start": 329.62,
      "end": 330.64,
      "text": "减少了一部分"
    },
    {
      "start": 331.24,
      "end": 333.68,
      "text": "而这部分用于给分区编号"
    },
    {
      "start": 334.7,
      "end": 336.14,
      "text": "在同学们了解了"
    },
    {
      "start": 336.4,
      "end": 338.02,
      "text": "组相连应设规则之后"
    },
    {
      "start": 338.52,
      "end": 340.06,
      "text": "请同学们思考一下"
    },
    {
      "start": 340.58,
      "end": 341.86,
      "text": "应该如何描述"
    },
    {
      "start": 342.12,
      "end": 344.06,
      "text": "主存中某个信息的位置呢"
    },
    {
      "start": 344.98,
      "end": 345.48,
      "text": "例如"
    },
    {
      "start": 345.74,
      "end": 347.22,
      "text": "主存中的这个信息"
    },
    {
      "start": 347.64,
      "end": 349.6,
      "text": "它的位置应该如何描述呢"
    },
    {
      "start": 351.15,
      "end": 352.83,
      "text": "我想同学们都会描述"
    },
    {
      "start": 353.59,
      "end": 356.07,
      "text": "该信息位于主存分区号为排目"
    },
    {
      "start": 356.43,
      "end": 358.83,
      "text": "数据块号为n-1的数据块庄"
    },
    {
      "start": 359.63,
      "end": 360.67,
      "text": "这是该信息"
    },
    {
      "start": 360.83,
      "end": 362.91,
      "text": "在该数据块中的偏移位置"
    },
    {
      "start": 363.98,
      "end": 364.78,
      "text": "换句话说"
    },
    {
      "start": 365.22,
      "end": 367.1,
      "text": "采用组相连应设方式"
    },
    {
      "start": 367.5,
      "end": 369.26,
      "text": "我们可用主存分区号"
    },
    {
      "start": 369.58,
      "end": 370.58,
      "text": "区内块号"
    },
    {
      "start": 370.94,
      "end": 372.46,
      "text": "以及块内偏移"
    },
    {
      "start": 372.82,
      "end": 373.82,
      "text": "这三部分"
    },
    {
      "start": 374.06,
      "end": 375.38,
      "text": "一起来精确描述"
    },
    {
      "start": 375.58,
      "end": 376.3,
      "text": "某个信息"
    },
    {
      "start": 376.54,
      "end": 378.3,
      "text": "在主存中的具体位置"
    },
    {
      "start": 379.18,
      "end": 380.78,
      "text": "我们之前刚刚分析过"
    },
    {
      "start": 381.34,
      "end": 382.22,
      "text": "区内块号"
    },
    {
      "start": 382.46,
      "end": 384.7,
      "text": "与其所对应的开始组的组号"
    },
    {
      "start": 384.94,
      "end": 386.18,
      "text": "是完全相等的"
    },
    {
      "start": 386.9,
      "end": 388.86,
      "text": "那么通过区内块号"
    },
    {
      "start": 389.22,
      "end": 391.02,
      "text": "就可以精准的定位出"
    },
    {
      "start": 391.26,
      "end": 393.1,
      "text": "该数据块所应设到"
    },
    {
      "start": 393.1,
      "end": 395.7,
      "text": "开始组的那个固定组的组号"
    },
    {
      "start": 396.51,
      "end": 398.99,
      "text": "因此区内块号也称为"
    },
    {
      "start": 398.99,
      "end": 401.31,
      "text": "开始组号或开始组锁印"
    },
    {
      "start": 401.71,
      "end": 402.95,
      "text": "英文为index"
    },
    {
      "start": 403.94,
      "end": 406.18,
      "text": "主存分区号和区内块号"
    },
    {
      "start": 406.46,
      "end": 408.1,
      "text": "合起来和看作是"
    },
    {
      "start": 408.26,
      "end": 409.26,
      "text": "带访问信息"
    },
    {
      "start": 409.42,
      "end": 411.22,
      "text": "所在主存数据块的地址"
    },
    {
      "start": 411.96,
      "end": 413.16,
      "text": "而块的偏移"
    },
    {
      "start": 413.52,
      "end": 415.04,
      "text": "只出了带访问信息"
    },
    {
      "start": 415.24,
      "end": 416.8,
      "text": "在主存数据块地址"
    },
    {
      "start": 416.96,
      "end": 419.68,
      "text": "所指定的那个数据块中的具体位置"
    },
    {
      "start": 420.78,
      "end": 423.58,
      "text": "加设主存数据块的地址为s位"
    },
    {
      "start": 424.18,
      "end": 426.66,
      "text": "其中区内块号占计位"
    },
    {
      "start": 427.22,
      "end": 428.78,
      "text": "剩余的s减计位"
    },
    {
      "start": 428.98,
      "end": 430.46,
      "text": "作为主存分区号"
    },
    {
