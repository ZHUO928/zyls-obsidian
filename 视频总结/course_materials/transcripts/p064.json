{
  "file": "p064.mp3",
  "duration": 826.816125,
  "language": "zh",
  "segments": [
    {
      "start": 3.41,
      "end": 8.01,
      "text": "同学们好,欢迎大家来到我的计算机组成员里微课堂。"
    },
    {
      "start": 8.01,
      "end": 11.21,
      "text": "在上节课中,我们给同学们介绍了,"
    },
    {
      "start": 11.21,
      "end": 13.71,
      "text": "主存系统优化的第三种方法,"
    },
    {
      "start": 13.71,
      "end": 15.9,
      "text": "多体交叉存主器。"
    },
    {
      "start": 15.9,
      "end": 20.9,
      "text": "多体交叉存主器分为高位多体交叉和低位多体交叉。"
    },
    {
      "start": 20.9,
      "end": 25.34,
      "text": "我们上节课给同学们介绍的是高位多体交叉,"
    },
    {
      "start": 25.34,
      "end": 27.94,
      "text": "也就是顺序编织模式。"
    },
    {
      "start": 27.94,
      "end": 32.26,
      "text": "由于程序具有局部性和连续性的特点,"
    },
    {
      "start": 32.46,
      "end": 35.16,
      "text": "因此,采用高位多体交叉,"
    },
    {
      "start": 35.16,
      "end": 40.53,
      "text": "程序的指令和数据基本分布在同一个主存模块中。"
    },
    {
      "start": 40.53,
      "end": 44.03,
      "text": "这样就会导致在程序执行过程中,"
    },
    {
      "start": 44.03,
      "end": 47.13,
      "text": "同一个主存模块被频繁访问,"
    },
    {
      "start": 47.13,
      "end": 51.03,
      "text": "而其他主存模块基本处于空闲状态,"
    },
    {
      "start": 51.03,
      "end": 54.86,
      "text": "无法实现多个主存模块的并停工作。"
    },
    {
      "start": 54.86,
      "end": 58.96,
      "text": "而本节课,我们将要介绍的第一位多体交叉,"
    },
    {
      "start": 59.06,
      "end": 64.25,
      "text": "就是为了提高顺序访问时和存主模块的并停性。"
    },
    {
      "start": 64.25,
      "end": 69.25,
      "text": "我们仍采用上节课用到的高位多体交叉的那个例子,"
    },
    {
      "start": 69.25,
      "end": 73.21,
      "text": "给同学们介绍什么是第一位多体交叉。"
    },
    {
      "start": 73.21,
      "end": 75.61,
      "text": "只要将高位多体交叉中,"
    },
    {
      "start": 75.61,
      "end": 77.91,
      "text": "主存地址的模块地址部分,"
    },
    {
      "start": 77.91,
      "end": 81.21,
      "text": "与块的地址部分颠倒一下顺序,"
    },
    {
      "start": 81.21,
      "end": 86.27,
      "text": "则高位多体交叉就转换成了第一位多体交叉。"
    },
    {
      "start": 86.27,
      "end": 87.57,
      "text": "换句话说,"
    },
    {
      "start": 87.67,
      "end": 89.67,
      "text": "我们用主存地址的高位,"
    },
    {
      "start": 89.67,
      "end": 93.77,
      "text": "给各存储模块内的存储单元进行编织,"
    },
    {
      "start": 93.77,
      "end": 95.77,
      "text": "而主存地址的低位,"
    },
    {
      "start": 95.77,
      "end": 98.53,
      "text": "给各存储模块编号。"
    },
    {
      "start": 98.53,
      "end": 101.13,
      "text": "这样,我们就将主存地址"
    },
    {
      "start": 101.13,
      "end": 106.23,
      "text": "一次分配给了不同存储模块内相同的存储单元,"
    },
    {
      "start": 106.23,
      "end": 107.93,
      "text": "如此反复进行,"
    },
    {
      "start": 107.93,
      "end": 114.45,
      "text": "直到所有存储模块中的各存储单元都分配了相应的主存地址。"
    },
    {
      "start": 114.65,
      "end": 115.85,
      "text": "不难看出,"
    },
    {
      "start": 115.85,
      "end": 121.15,
      "text": "主存地址被一次分配给了不同存储模块内的存储单元,"
    },
    {
      "start": 121.15,
      "end": 123.15,
      "text": "而不是一次分配给了"
    },
    {
      "start": 123.15,
      "end": 127.44,
      "text": "同一个存储模块中连续的存储单元。"
    },
    {
      "start": 127.44,
      "end": 128.34,
      "text": "因此,"
    },
    {
      "start": 128.34,
      "end": 132.93,
      "text": "第一位多体交叉又称为交叉编织模式。"
    },
    {
      "start": 132.93,
      "end": 134.63,
      "text": "请同学们注意,"
    },
    {
      "start": 134.63,
      "end": 136.73,
      "text": "为了提高顺序访问时,"
    },
    {
      "start": 136.73,
      "end": 139.33,
      "text": "各存储模块的并停性,"
    },
    {
      "start": 139.33,
      "end": 140.93,
      "text": "第一位多体交叉,"
    },
    {
      "start": 140.93,
      "end": 143.73,
      "text": "也就是交叉编织模式中,"
    },
    {
      "start": 143.73,
      "end": 147.73,
      "text": "各存储模块均有独立的地址计存器,"
    },
    {
      "start": 147.73,
      "end": 149.03,
      "text": "数据计存器,"
    },
    {
      "start": 149.03,
      "end": 151.65,
      "text": "和独卸控制电路。"
    },
    {
      "start": 151.65,
      "end": 152.95,
      "text": "顺序访问时,"
    },
    {
      "start": 152.95,
      "end": 157.85,
      "text": "各存储模块一般按流水线的方式轮流存取。"
    },
    {
      "start": 157.85,
      "end": 160.1,
      "text": "我们来举例说明,"
    },
    {
      "start": 160.1,
      "end": 164.7,
      "text": "假设要顺序存取以下四个主存地址中的内容,"
    },
    {
      "start": 164.7,
      "end": 168.92,
      "text": "如同所示,"
    },
    {
      "start": 168.92,
      "end": 172.62,
      "text": "设各存储模块的存取周期为T,"
    },
    {
      "start": 172.62,
      "end": 174.32,
      "text": "设其他延迟,"
    },
    {
      "start": 174.32,
      "end": 175.32,
      "text": "例如,"
    },
    {
      "start": 175.32,
      "end": 177.12,
      "text": "总线传输周期等,"
    },
    {
      "start": 177.12,
      "end": 179.3,
      "text": "总和为套,"
    },
    {
      "start": 179.3,
      "end": 182.0,
      "text": "设存储模块数量为M,"
    },
    {
      "start": 182.0,
      "end": 185.0,
      "text": "M一般为二的整数字密,"
    },
    {
      "start": 185.0,
      "end": 187.45,
      "text": "本地中M等于四,"
    },
    {
      "start": 187.45,
      "end": 190.05,
      "text": "要实现流水线方式存取,"
    },
    {
      "start": 190.05,
      "end": 194.47,
      "text": "因满足条件T等于M乘以套。"
    },
    {
      "start": 194.47,
      "end": 198.43,
      "text": "我们来画出流水线方式存取的示意图。"
    },
    {
      "start": 198.43,
      "end": 200.72,
      "text": "横坐标为时间,"
    },
    {
      "start": 200.72,
      "end": 201.82,
      "text": "这段时间,"
    },
    {
      "start": 201.82,
      "end": 204.52,
      "text": "用于访问存储器模块M0中,"
    },
    {
      "start": 204.52,
      "end": 206.62,
      "text": "指定的存储单元,"
    },
    {
      "start": 206.62,
      "end": 209.93,
      "text": "具体为一个存取周期T,"
    },
    {
      "start": 209.93,
      "end": 212.43,
      "text": "根据实现流水线方式存取,"
    },
    {
      "start": 212.43,
      "end": 214.53,
      "text": "所因满足的条件,"
    },
    {
      "start": 214.53,
      "end": 218.33,
      "text": "以及等于一周存储模块的数量可知,"
    },
    {
      "start": 218.33,
      "end": 223.01,
      "text": "存储周期T等于四倍的其他延迟套,"
    },
    {
      "start": 223.01,
      "end": 226.31,
      "text": "从访问存储模块M0的时刻起,"
    },
    {
      "start": 226.31,
      "end": 228.41,
      "text": "经过套这么长的时间,"
    },
    {
      "start": 228.41,
      "end": 231.61,
      "text": "就可以开始访问存储模块M1中,"
    },
    {
      "start": 231.61,
      "end": 234.03,
      "text": "指定的存储单元了。"
    },
    {
      "start": 234.03,
      "end": 236.43,
      "text": "有的同学可能会有这样的疑问,"
    },
    {
      "start": 236.43,
      "end": 241.23,
      "text": "为什么访问M0和M1不同时开始呢?"
    },
    {
      "start": 241.23,
      "end": 243.24,
      "text": "这是因为,"
    },
    {
      "start": 243.24,
      "end": 244.94,
      "text": "如果同时开始,"
    },
    {
      "start": 244.94,
      "end": 246.94,
      "text": "则在第四个套时,"
    },
    {
      "start": 246.94,
      "end": 251.74,
      "text": "M0和M1会同时进入总线传输周期,"
    },
    {
      "start": 251.74,
      "end": 255.34,
      "text": "进而征用数据总线而产生冲突。"
    },
    {
      "start": 255.34,
      "end": 259.14,
      "text": "因此,访问M1要比访问M0"
    },
    {
      "start": 259.14,
      "end": 261.7,
      "text": "至后套这么长的时间。"
    },
    {
      "start": 261.7,
      "end": 262.8,
      "text": "相应的,"
    },
    {
      "start": 262.8,
      "end": 264.3,
      "text": "访问M1的套座"
    },
    {
      "start": 264.3,
      "end": 266.0,
      "text": "比访问M0的套座"
    },
    {
      "start": 266.0,
      "end": 269.29,
      "text": "会至后套这么长的时间结束。"
    },
    {
      "start": 269.29,
      "end": 270.49,
      "text": "不难看出,"
    },
    {
      "start": 270.49,
      "end": 273.99,
      "text": "M0和M1有三套这么长的时间"
    },
    {
      "start": 273.99,
      "end": 276.31,
      "text": "处于并行访问。"
    },
    {
      "start": 276.31,
      "end": 277.11,
      "text": "同理,"
    },
    {
      "start": 277.11,
      "end": 280.21,
      "text": "从访问存储模块M1的时刻起,"
    },
    {
      "start": 280.21,
      "end": 282.21,
      "text": "经过套这么长的时间,"
    },
    {
      "start": 282.21,
      "end": 285.11,
      "text": "就可以开始访问存储模块M2中,"
    },
    {
      "start": 285.11,
      "end": 287.11,
      "text": "指定的存储单元了。"
    },
    {
      "start": 287.11,
      "end": 288.11,
      "text": "相应的,"
    },
    {
      "start": 288.11,
      "end": 289.61,
      "text": "访问M2的套座"
    },
    {
      "start": 289.61,
      "end": 291.51,
      "text": "比访问M1的套座"
    },
    {
      "start": 291.51,
      "end": 294.8,
      "text": "会至后套这么长的时间结束。"
    },
    {
      "start": 294.9,
      "end": 296.1,
      "text": "不难看出,"
    },
    {
      "start": 296.1,
      "end": 298.2,
      "text": "M0、M1和M2"
    },
    {
      "start": 298.2,
      "end": 300.2,
      "text": "有二套这么长的时间"
    },
    {
      "start": 300.2,
      "end": 302.84,
      "text": "处于并行访问。"
    },
    {
      "start": 302.84,
      "end": 303.74,
      "text": "同理,"
    },
    {
      "start": 303.74,
      "end": 306.74,
      "text": "从访问存储模块M2的时刻起,"
    },
    {
      "start": 306.74,
      "end": 308.74,
      "text": "经过套这么长的时间,"
    },
    {
      "start": 308.74,
      "end": 312.04,
      "text": "就可以开始访问存储模块M3中,"
    },
    {
      "start": 312.04,
      "end": 314.14,
      "text": "指定的存储单元了。"
    },
    {
      "start": 314.14,
      "end": 315.04,
      "text": "相应的,"
    },
    {
      "start": 315.04,
      "end": 316.74,
      "text": "访问M3的套座"
    },
    {
      "start": 316.74,
      "end": 318.54,
      "text": "比访问M2的套座"
    },
    {
      "start": 318.54,
      "end": 322.0,
      "text": "会至后套这么长的时间结束。"
    },
    {
      "start": 322.0,
      "end": 323.3,
      "text": "不难看出,"
    },
    {
      "start": 323.4,
      "end": 326.0,
      "text": "M0、M1、M2、M3"
    },
    {
      "start": 326.0,
      "end": 327.6,
      "text": "有套这么长的时间"
    },
    {
      "start": 327.6,
      "end": 329.88,
      "text": "处于并行访问。"
    },
    {
      "start": 329.88,
      "end": 330.78,
      "text": "接下来,"
    },
    {
      "start": 330.78,
      "end": 332.68,
      "text": "请同学们再看一遍"
    },
    {
      "start": 332.68,
      "end": 334.28,
      "text": "流水线方式存取的"
    },
    {
      "start": 334.28,
      "end": 335.98,
      "text": "动画示意图,"
    },
    {
      "start": 335.98,
      "end": 345.09,
      "text": "如图所示,"
    },
    {
      "start": 345.09,
      "end": 347.39,
      "text": "我们再用左侧的这幅图"
    },
    {
      "start": 347.39,
      "end": 348.69,
      "text": "来演示一遍"
    },
    {
      "start": 348.69,
      "end": 351.19,
      "text": "流水线方式存取的过程。"
    },
    {
      "start": 351.19,
      "end": 353.29,
      "text": "请同学们注意观察,"
    },
    {
      "start": 353.29,
      "end": 356.09,
      "text": "四个待顺序访问的存储单元"
    },
    {
      "start": 356.09,
      "end": 357.69,
      "text": "被访问的时刻,"
    },
    {
      "start": 357.69,
      "end": 358.99,
      "text": "以及他们各自"
    },
    {
      "start": 358.99,
      "end": 362.09,
      "text": "向数据总线发送数据的时刻,"
    },
    {
      "start": 362.09,
      "end": 371.94,
      "text": "如图所示。"
    },
    {
      "start": 371.94,
      "end": 372.84,
      "text": "接下来,"
    },
    {
      "start": 372.84,
      "end": 374.14,
      "text": "我们总结一下"
    },
    {
      "start": 374.14,
      "end": 375.74,
      "text": "第一位多体交叉,"
    },
    {
      "start": 375.74,
      "end": 378.04,
      "text": "也就是交叉编织模式下"
    },
    {
      "start": 378.04,
      "end": 380.04,
      "text": "进行顺序访问时"
    },
    {
      "start": 380.04,
      "end": 382.6,
      "text": "流水线方式存取的特点。"
    },
    {
      "start": 382.6,
      "end": 385.1,
      "text": "在一次流水线存取过程中,"
    },
    {
      "start": 385.1,
      "end": 386.6,
      "text": "所有存储模块"
    },
    {
      "start": 386.6,
      "end": 388.5,
      "text": "都被访问一次,"
    },
    {
      "start": 388.5,
      "end": 389.8,
      "text": "不能重复访问"
    },
    {
      "start": 389.8,
      "end": 392.13,
      "text": "某一个存储模块。"
    },
    {
      "start": 392.13,
      "end": 394.23,
      "text": "一次流水线存取过程,"
    },
    {
      "start": 394.23,
      "end": 398.38,
      "text": "总号实为T加上M-1倍的套,"
    },
    {
      "start": 398.38,
      "end": 400.78,
      "text": "连续N次流水线存取过程,"
    },
    {
      "start": 400.78,
      "end": 405.83,
      "text": "总号实为N倍的T加上M-1倍的套。"
    },
    {
      "start": 405.83,
      "end": 408.53,
      "text": "请同学们基于上面的示意图,"
    },
    {
      "start": 408.53,
      "end": 410.23,
      "text": "好好理解一下,"
    },
    {
      "start": 410.23,
      "end": 412.63,
      "text": "因为我们稍后要挑战的"
    },
    {
      "start": 412.63,
      "end": 415.43,
      "text": "2-408考研另一年整体,"
    },
    {
      "start": 415.43,
      "end": 418.09,
      "text": "就会用到上述知识点。"
    },
    {
      "start": 418.09,
      "end": 419.79,
      "text": "请同学们注意,"
    },
    {
      "start": 419.79,
      "end": 421.49,
      "text": "可从任意地址,"
    },
    {
      "start": 421.49,
      "end": 423.69,
      "text": "也就是某个存储模块的"
    },
    {
      "start": 423.79,
      "end": 425.29,
      "text": "某个存储单元,"
    },
    {
      "start": 425.29,
      "end": 427.19,
      "text": "开始顺序存取,"
    },
    {
      "start": 427.19,
      "end": 431.38,
      "text": "如都所示,"
    },
    {
      "start": 431.38,
      "end": 434.28,
      "text": "而不一定像我们之前举例的那样,"
    },
    {
      "start": 434.28,
      "end": 437.64,
      "text": "非要从存储模块M-0开始。"
    },
    {
      "start": 437.64,
      "end": 438.64,
      "text": "接下来,"
    },
    {
      "start": 438.64,
      "end": 440.64,
      "text": "请同学们趁热打铁,"
    },
    {
      "start": 440.64,
      "end": 443.64,
      "text": "挑战着到408考研整体。"
    },
    {
      "start": 443.64,
      "end": 446.34,
      "text": "请同学们暂停播放视频,"
    },
    {
      "start": 446.34,
      "end": 448.04,
      "text": "动手练习一下,"
    },
    {
      "start": 448.04,
      "end": 455.1,
      "text": "然后给出你的答案。"
    },
    {
      "start": 455.1,
      "end": 457.5,
      "text": "本题的答案是选项第。"
    },
    {
      "start": 457.5,
      "end": 459.3,
      "text": "大家都选对了吗?"
    },
    {
      "start": 459.4,
      "end": 461.87,
      "text": "我们来一起分析一下,"
    },
    {
      "start": 461.87,
      "end": 462.97,
      "text": "题目给定,"
    },
    {
      "start": 462.97,
      "end": 465.57,
      "text": "是用四体交叉编织存储器,"
    },
    {
      "start": 465.57,
      "end": 468.07,
      "text": "也就是我们本节课介绍的"
    },
    {
      "start": 468.07,
      "end": 470.47,
      "text": "第一位多体交叉存储器,"
    },
    {
      "start": 470.47,
      "end": 473.2,
      "text": "其才用交叉编织模式。"
    },
    {
      "start": 473.2,
      "end": 475.1,
      "text": "因此,可以推出,"
    },
    {
      "start": 475.1,
      "end": 476.4,
      "text": "这些主存地址,"
    },
    {
      "start": 476.4,
      "end": 479.2,
      "text": "各自的二净之形式的第一两位,"
    },
    {
      "start": 479.2,
      "end": 482.5,
      "text": "为存储器中各存储模块的地址。"
    },
    {
      "start": 482.5,
      "end": 483.5,
      "text": "这是因为,"
    },
    {
      "start": 483.5,
      "end": 486.6,
      "text": "本题给定的存储器模块数量为四个,"
    },
    {
      "start": 486.6,
      "end": 487.4,
      "text": "因此,"
    },
    {
      "start": 487.4,
      "end": 489.2,
      "text": "用两位二净之数,"
    },
    {
      "start": 489.2,
      "end": 492.1,
      "text": "可有二到二次方等于四个组合,"
    },
    {
      "start": 492.1,
      "end": 494.1,
      "text": "借零零到一一,"
    },
    {
      "start": 494.1,
      "end": 497.83,
      "text": "来分别给这四个存储模块编号。"
    },
    {
      "start": 497.83,
      "end": 499.03,
      "text": "我们写出,"
    },
    {
      "start": 499.03,
      "end": 500.03,
      "text": "题目给定的,"
    },
    {
      "start": 500.03,
      "end": 502.23,
      "text": "这些实际制主存地址的,"
    },
    {
      "start": 502.23,
      "end": 504.93,
      "text": "二净之形式的第一两位即可。"
    },
    {
      "start": 504.93,
      "end": 507.33,
      "text": "这是同学们学习完第二张号,"
    },
    {
      "start": 507.33,
      "end": 509.73,
      "text": "就应该熟练掌握的基本功,"
    },
    {
      "start": 509.73,
      "end": 511.75,
      "text": "就不再赚数了。"
    },
    {
      "start": 511.75,
      "end": 513.55,
      "text": "我们画出题目所给的,"
    },
    {
      "start": 513.55,
      "end": 516.58,
      "text": "四体交叉编织存储器。"
    },
    {
      "start": 516.58,
      "end": 518.88,
      "text": "这是给个存储模块分配的,"
    },
    {
      "start": 518.88,
      "end": 521.96,
      "text": "主存地址中的模块地址部分,"
    },
    {
      "start": 521.96,
      "end": 523.86,
      "text": "则地址八千零五,"
    },
    {
      "start": 523.86,
      "end": 526.16,
      "text": "可以是存储模块M1中,"
    },
    {
      "start": 526.16,
      "end": 528.62,
      "text": "某个存储单元的地址。"
    },
    {
      "start": 528.62,
      "end": 530.72,
      "text": "我们在该存储单元旁边,"
    },
    {
      "start": 530.72,
      "end": 533.68,
      "text": "标记出它的地址八千零五。"
    },
    {
      "start": 533.68,
      "end": 534.48,
      "text": "这样,"
    },
    {
      "start": 534.48,
      "end": 537.88,
      "text": "地址八千零五的下一个地址八千零六,"
    },
    {
      "start": 537.88,
      "end": 542.18,
      "text": "对应的是存储模块M2中的该存储单元。"
    },
    {
      "start": 542.18,
      "end": 543.28,
      "text": "以此类推,"
    },
    {
      "start": 543.28,
      "end": 546.25,
      "text": "我们就不再赚数了。"
    },
    {
      "start": 546.25,
      "end": 550.05,
      "text": "而地址八零零五的上一个地址八零零四,"
    },
    {
      "start": 550.05,
      "end": 554.78,
      "text": "对应的是存储模块M0中的该存储单元。"
    },
    {
      "start": 554.78,
      "end": 555.78,
      "text": "以此类推,"
    },
    {
      "start": 555.78,
      "end": 559.68,
      "text": "我们就不再赚数了。"
    },
    {
      "start": 559.68,
      "end": 560.78,
      "text": "题目给定,"
    },
    {
      "start": 560.78,
      "end": 566.04,
      "text": "要依次顺序访问这些地址所对应的存储单元。"
    },
    {
      "start": 566.04,
      "end": 567.04,
      "text": "我们画出,"
    },
    {
      "start": 567.04,
      "end": 570.8,
      "text": "本题采用流水线方式存取的示意图。"
    },
    {
      "start": 570.8,
      "end": 573.8,
      "text": "如读所示,"
    },
    {
      "start": 573.8,
      "end": 574.9,
      "text": "不难看出,"
    },
    {
      "start": 574.9,
      "end": 577.4,
      "text": "在同一个存储周期替内,"
    },
    {
      "start": 577.4,
      "end": 580.7,
      "text": "存储模块M0被重复访问,"
    },
    {
      "start": 580.7,
      "end": 583.6,
      "text": "具体为M0中地址为八千零四,"
    },
    {
      "start": 583.6,
      "end": 586.7,
      "text": "和八千的两个存储单元。"
    },
    {
      "start": 586.7,
      "end": 590.03,
      "text": "因此会发生仿存冲突,"
    },
    {
      "start": 590.03,
      "end": 595.66,
      "text": "而其他存储模块都是按存取周期替进行周期性访问。"
    },
    {
      "start": 595.66,
      "end": 596.56,
      "text": "例如,"
    },
    {
      "start": 596.56,
      "end": 601.17,
      "text": "对存储模块M1的访问,"
    },
    {
      "start": 601.17,
      "end": 605.93,
      "text": "对存储模块M2的访问,"
    },
    {
      "start": 605.93,
      "end": 607.23,
      "text": "综上所述,"
    },
    {
      "start": 607.23,
      "end": 610.18,
      "text": "本题的答案是选项替,"
    },
    {
      "start": 610.18,
      "end": 614.58,
      "text": "请同学们再来挑战2017年的题13。"
    },
    {
      "start": 614.58,
      "end": 617.18,
      "text": "请大家暂停播放视频,"
    },
    {
      "start": 617.28,
      "end": 618.98,
      "text": "动手练习一下,"
    },
    {
      "start": 618.98,
      "end": 621.08,
      "text": "然后给出你的答案。"
    },
    {
      "start": 621.08,
      "end": 629.0,
      "text": "你的答案是选项C,"
    },
    {
      "start": 629.0,
      "end": 630.9,
      "text": "大家都选对了吗?"
    },
    {
      "start": 630.9,
      "end": 633.37,
      "text": "我们来一起分析一下,"
    },
    {
      "start": 633.37,
      "end": 634.47,
      "text": "题目给定,"
    },
    {
      "start": 634.47,
      "end": 637.17,
      "text": "辨量X的类型为Double型,"
    },
    {
      "start": 637.17,
      "end": 638.37,
      "text": "因此可知,"
    },
    {
      "start": 638.37,
      "end": 640.9,
      "text": "X的长度为八字节。"
    },
    {
      "start": 640.9,
      "end": 643.3,
      "text": "这是同学们学习完第二张号,"
    },
    {
      "start": 643.3,
      "end": 645.69,
      "text": "就应该熟记的内容。"
    },
    {
      "start": 645.69,
      "end": 646.79,
      "text": "题目给定,"
    },
    {
      "start": 646.79,
      "end": 649.29,
      "text": "主存按字节编织。"
    },
    {
      "start": 649.29,
      "end": 653.05,
      "text": "这是题目给定的X的主存地址,"
    },
    {
      "start": 653.05,
      "end": 654.95,
      "text": "因此我们可以写出,"
    },
    {
      "start": 654.95,
      "end": 658.75,
      "text": "辨量X所占用的八字节主存地址,"
    },
    {
      "start": 658.75,
      "end": 662.43,
      "text": "意思为以下八个地址。"
    },
    {
      "start": 662.43,
      "end": 663.63,
      "text": "题目给定,"
    },
    {
      "start": 663.63,
      "end": 665.93,
      "text": "主存由四个D-RAM的芯片,"
    },
    {
      "start": 665.93,
      "end": 668.66,
      "text": "采用交叉编织方式构成。"
    },
    {
      "start": 668.66,
      "end": 670.66,
      "text": "因此可以推出,"
    },
    {
      "start": 670.66,
      "end": 672.26,
      "text": "上述主存地址,"
    },
    {
      "start": 672.26,
      "end": 674.96,
      "text": "各次的二净值形式的D两位,"
    },
    {
      "start": 674.96,
      "end": 678.55,
      "text": "为主存中各存储芯片的地址。"
    },
    {
      "start": 678.55,
      "end": 680.55,
      "text": "我们写出题目给定的这些,"
    },
    {
      "start": 680.55,
      "end": 682.25,
      "text": "十六净值主存地址的,"
    },
    {
      "start": 682.25,
      "end": 685.34,
      "text": "二净值形式的D两位即可。"
    },
    {
      "start": 685.34,
      "end": 687.64,
      "text": "这是同学们学习完第二张,"
    },
    {
      "start": 687.64,
      "end": 690.34,
      "text": "就应该熟练掌握的基本功,"
    },
    {
      "start": 690.34,
      "end": 692.53,
      "text": "就不再赘述了。"
    },
    {
      "start": 692.53,
      "end": 693.63,
      "text": "我们画出,"
    },
    {
      "start": 693.63,
      "end": 697.46,
      "text": "题目所给的四体交叉编织存储器。"
    },
    {
      "start": 697.46,
      "end": 699.76,
      "text": "这是给个存储芯片分配的,"
    },
    {
      "start": 699.76,
      "end": 703.01,
      "text": "主存地址中的模块地址部分。"
    },
    {
      "start": 703.01,
      "end": 705.71,
      "text": "则地址804001A,"
    },
    {
      "start": 705.71,
      "end": 708.11,
      "text": "可以是存储模块M2中,"
    },
    {
      "start": 708.11,
      "end": 710.47,
      "text": "某个存储单元的地址。"
    },
    {
      "start": 710.47,
      "end": 712.57,
      "text": "我们在该存储单元旁边,"
    },
    {
      "start": 712.57,
      "end": 716.23,
      "text": "标记出它的地址804001A,"
    },
    {
      "start": 716.23,
      "end": 718.93,
      "text": "这样该地址的下一个地址,"
    },
    {
      "start": 718.93,
      "end": 720.83,
      "text": "804001B,"
    },
    {
      "start": 720.83,
      "end": 725.13,
      "text": "对应的是存储模块M3中的该存储单元。"
    },
    {
      "start": 725.13,
      "end": 726.23,
      "text": "以此类推,"
    },
    {
      "start": 726.23,
      "end": 732.01,
      "text": "我们就不再赘述了。"
    },
    {
      "start": 732.01,
      "end": 733.81,
      "text": "题目要求我们给出,"
    },
    {
      "start": 733.81,
      "end": 738.3,
      "text": "读取变量X需要的存取周期的数量。"
    },
    {
      "start": 738.3,
      "end": 739.3,
      "text": "我们画出,"
    },
    {
      "start": 739.3,
      "end": 743.1,
      "text": "本题采用流水线方式存取的示意图。"
    },
    {
      "start": 743.2,
      "end": 746.4,
      "text": "如读所示,"
    },
    {
      "start": 746.4,
      "end": 747.6,
      "text": "不难看出,"
    },
    {
      "start": 747.6,
      "end": 752.39,
      "text": "读取X需要的时间约为三个存取周期。"
    },
    {
      "start": 752.39,
      "end": 753.69,
      "text": "通上所说,"
    },
    {
      "start": 753.69,
      "end": 756.77,
      "text": "本题的答案是选项C,"
    },
    {
      "start": 756.77,
      "end": 758.27,
      "text": "需要说明的是,"
    },
    {
      "start": 758.27,
      "end": 760.37,
      "text": "本题也可看作我们之前"
    },
    {
      "start": 760.37,
      "end": 763.57,
      "text": "曾给同学们介绍过的未扩展方式,"
    },
    {
      "start": 763.57,
      "end": 766.04,
      "text": "也称为数据总线扩展。"
    },
    {
      "start": 766.04,
      "end": 767.94,
      "text": "四个八位的DRAM芯片,"
    },
    {
      "start": 767.94,
      "end": 770.34,
      "text": "一共提供32位数据,"
    },
    {
      "start": 770.34,
      "end": 772.94,
      "text": "与存储器总线位宽相同,"
    },
    {
      "start": 772.94,
      "end": 776.84,
      "text": "可同时启动四个芯片进行病情读写,"
    },
    {
      "start": 776.84,
      "end": 779.37,
      "text": "同时读写32位数据。"
    },
    {
      "start": 779.37,
      "end": 780.37,
      "text": "因此,"
    },
    {
      "start": 780.37,
      "end": 786.58,
      "text": "读取X需要的存储周期数如读所示,"
    },
    {
      "start": 786.58,
      "end": 787.78,
      "text": "通上所说,"
    },
    {
      "start": 787.78,
      "end": 791.3,
      "text": "本题的答案是选项C。"
    },
    {
      "start": 791.3,
      "end": 792.2,
      "text": "最后,"
    },
    {
      "start": 792.2,
      "end": 794.4,
      "text": "请同学们思考一下,"
    },
    {
      "start": 794.4,
      "end": 798.7,
      "text": "针对程序具有局部性和连续性的课点,"
    },
    {
      "start": 798.7,
      "end": 800.3,
      "text": "第一位多体交叉,"
    },
    {
      "start": 800.3,
      "end": 803.0,
      "text": "也就是交叉编织模式,"
    },
    {
      "start": 803.1,
      "end": 805.0,
      "text": "比高位多体交叉,"
    },
    {
      "start": 805.0,
      "end": 807.6,
      "text": "也就是顺序编织模式,"
    },
    {
      "start": 807.6,
      "end": 810.91,
      "text": "有什么优势呢?"
    },
    {
      "start": 810.91,
      "end": 814.41,
      "text": "好的,本节课到这里就结束了。"
    },
    {
      "start": 814.41,
      "end": 821.22,
      "text": "我们将本节课的主要内容小节如下。"
    },
    {
      "start": 821.22,
      "end": 823.62,
      "text": "同学们,我们下节课见!"
    }
  ]
