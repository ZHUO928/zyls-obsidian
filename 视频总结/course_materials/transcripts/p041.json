  "segments": [
    {
      "start": 3.28,
      "end": 7.88,
      "text": "同学们好,欢迎大家来到我的计算机组成原理,威克唐。"
    },
    {
      "start": 7.88,
      "end": 12.38,
      "text": "本节课,我们介绍辅典惩罚运算的相关知识。"
    },
    {
      "start": 12.38,
      "end": 16.1,
      "text": "假设X和Y是两个辅典数,"
    },
    {
      "start": 16.1,
      "end": 19.6,
      "text": "EX和EY分别是它们各自的接码,"
    },
    {
      "start": 19.6,
      "end": 24.0,
      "text": "MX和MY分别是它们各自的尾数,"
    },
    {
      "start": 24.0,
      "end": 28.4,
      "text": "则X和Y各自可表示为以下形式,"
    },
    {
      "start": 28.4,
      "end": 33.24,
      "text": "因此X乘以外可得如下形式,"
    },
    {
      "start": 34.46,
      "end": 37.56,
      "text": "不难看出,两个辅典数的惩罚运算,"
    },
    {
      "start": 37.56,
      "end": 40.96,
      "text": "实际上需要将它们各自的接码相加,"
    },
    {
      "start": 40.96,
      "end": 43.22,
      "text": "尾数相乘,"
    },
    {
      "start": 43.82,
      "end": 45.22,
      "text": "接码相加,"
    },
    {
      "start": 45.22,
      "end": 47.72,
      "text": "才用定年整数加法运算,"
    },
    {
      "start": 47.72,
      "end": 50.02,
      "text": "当两个接码同号时,"
    },
    {
      "start": 50.02,
      "end": 52.34,
      "text": "可能会发生一戳,"
    },
    {
      "start": 52.34,
      "end": 53.84,
      "text": "尾数相乘,"
    },
    {
      "start": 53.84,
      "end": 56.34,
      "text": "才用定年小数惩罚运算,"
    },
    {
      "start": 56.34,
      "end": 59.74,
      "text": "可能需要规格化和舍入处理。"
    },
    {
      "start": 59.74,
      "end": 61.14,
      "text": "通常所说,"
    },
    {
      "start": 61.14,
      "end": 64.9,
      "text": "辅典惩罚运算包含以下三个步骤,"
    },
    {
      "start": 65.1,
      "end": 67.92,
      "text": "步骤一,接码相加,"
    },
    {
      "start": 67.92,
      "end": 70.61,
      "text": "步骤二,尾数相乘,"
    },
    {
      "start": 70.61,
      "end": 74.1,
      "text": "步骤三,规格化和舍入,"
    },
    {
      "start": 74.1,
      "end": 76.5,
      "text": "在进行接码相加时,"
    },
    {
      "start": 76.5,
      "end": 79.1,
      "text": "才用定年整数加法运算,"
    },
    {
      "start": 79.1,
      "end": 81.1,
      "text": "可能会发生一戳,"
    },
    {
      "start": 81.1,
      "end": 83.9,
      "text": "因此应做一戳判断,"
    },
    {
      "start": 83.9,
      "end": 87.16,
      "text": "以便通知计算机做一戳处理,"
    },
    {
      "start": 87.16,
      "end": 89.56,
      "text": "在进行尾数相乘时,"
    },
    {
      "start": 89.56,
      "end": 91.86,
      "text": "才用定年小数惩罚,"
    },
    {
      "start": 91.86,
      "end": 95.86,
      "text": "运算结果可能需要进行规格化和舍入处理,"
    },
    {
      "start": 96.85,
      "end": 98.85,
      "text": "而规格化和舍入处理,"
    },
    {
      "start": 98.85,
      "end": 101.85,
      "text": "与辅典加减法是相同的,"
    },
    {
      "start": 101.85,
      "end": 105.2,
      "text": "对于HB 1754辅典书,"
    },
    {
      "start": 105.2,
      "end": 107.2,
      "text": "接码运算,"
    },
    {
      "start": 107.2,
      "end": 109.2,
      "text": "才用一码的运算规则,"
    },
    {
      "start": 109.2,
      "end": 111.52,
      "text": "尾数相乘时,"
    },
    {
      "start": 111.52,
      "end": 113.52,
      "text": "隐藏位也要参与运算,"
    },
    {
      "start": 113.52,
      "end": 116.91,
      "text": "才用HB 1754的规格化"
    },
    {
      "start": 116.91,
      "end": 120.36,
      "text": "和溢出检测与处理方法,"
    },
    {
      "start": 120.36,
      "end": 122.36,
      "text": "需要特别注意的是,"
    },
    {
      "start": 122.36,
      "end": 125.36,
      "text": "HB 1754辅典惩罚运算中,"
    },
    {
      "start": 125.36,
      "end": 127.36,
      "text": "都存在向左规格化操作,"
    },
    {
      "start": 127.36,
      "end": 131.25,
      "text": "不知同学们是否已经发现了,"
    },
    {
      "start": 131.25,
      "end": 136.25,
      "text": "辅典惩罚运算所涉及到的定年整数加法运算,"
    },
    {
      "start": 136.25,
      "end": 138.25,
      "text": "定年小数惩罚运算,"
    },
    {
      "start": 138.25,
      "end": 141.35,
      "text": "辅典加减法的溢出判断,"
    },
    {
      "start": 141.35,
      "end": 143.35,
      "text": "规格化和舍入处理,"
    },
    {
      "start": 143.35,
      "end": 145.35,
      "text": "我们在之前的几节课中,"
    },
    {
      "start": 145.35,
      "end": 147.35,
      "text": "都已经学习过了,"
    },
    {
      "start": 147.35,
      "end": 150.7,
      "text": "因此就不再坠述了,"
    },
    {
      "start": 150.7,
      "end": 153.7,
      "text": "好的,本节课到这里就结束了,"
    },
    {
      "start": 153.7,
      "end": 156.7,
      "text": "同学们,我们下节课见!"
    }
  ]
