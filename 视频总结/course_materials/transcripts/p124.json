{
  "file": "p124.mp3",
  "duration": 292.71075,
  "language": "zh",
  "segments": [
    {
      "start": 3.98,
      "end": 8.22,
      "text": "同學們好,歡迎大家來到我的階段級組成原理威克堂"
    },
    {
      "start": 8.22,
      "end": 12.3,
      "text": "之前,我們用三次課的時間給同學們介紹了"
    },
    {
      "start": 12.3,
      "end": 16.38,
      "text": "如何為CPU增加中斷處理功能的相關知識"
    },
    {
      "start": 16.38,
      "end": 20.86,
      "text": "包括對數據通路的改造,對控制器的改造"
    },
    {
      "start": 20.86,
      "end": 24.26,
      "text": "這些都屬於硬件修改和擴充"
    },
    {
      "start": 24.26,
      "end": 29.14,
      "text": "我們知道,中斷機制是硬件和軟件協同的機制"
    },
    {
      "start": 29.14,
      "end": 32.78,
      "text": "有了硬件支持,還需要為各種中斷請求"
    },
    {
      "start": 32.78,
      "end": 35.34,
      "text": "編寫相應的中斷服務程序"
    },
    {
      "start": 35.34,
      "end": 38.26,
      "text": "本節課呢,我們給同學們介紹"
    },
    {
      "start": 38.26,
      "end": 41.62,
      "text": "中斷服務程序主要包含的四個步驟"
    },
    {
      "start": 41.62,
      "end": 44.22,
      "text": "步驟一是保護現場"
    },
    {
      "start": 44.22,
      "end": 47.41,
      "text": "步驟二是中斷服務"
    },
    {
      "start": 47.41,
      "end": 50.35,
      "text": "步驟三是恢復現場"
    },
    {
      "start": 51.18,
      "end": 53.5,
      "text": "步驟四是中斷返回"
    },
    {
      "start": 53.5,
      "end": 55.89,
      "text": "保護現場的目的是"
    },
    {
      "start": 55.89,
      "end": 60.13,
      "text": "確保被中斷的程序在執行完中斷服務程序之後"
    },
    {
      "start": 60.13,
      "end": 61.73,
      "text": "還能正確執行"
    },
    {
      "start": 61.73,
      "end": 64.29,
      "text": "這就需要將中斷服務程序中"
    },
    {
      "start": 64.37,
      "end": 66.53,
      "text": "會被改寫的任何機存器"
    },
    {
      "start": 66.53,
      "end": 70.05,
      "text": "例如,程序狀態自PSW機存器"
    },
    {
      "start": 70.05,
      "end": 71.41,
      "text": "通用機存器"
    },
    {
      "start": 71.41,
      "end": 75.49,
      "text": "多級嵌套中斷時的異常指令地址EPC機存器"
    },
    {
      "start": 75.49,
      "end": 77.97,
      "text": "壓佔到內存堆佔中"
    },
    {
      "start": 77.97,
      "end": 79.49,
      "text": "請同學們注意"
    },
    {
      "start": 79.49,
      "end": 81.25,
      "text": "這裡所謂的現場"
    },
    {
      "start": 81.25,
      "end": 82.77,
      "text": "與函數調用中"
    },
    {
      "start": 82.77,
      "end": 87.33,
      "text": "需要由調用者保存機存器的概念並不完全相同"
    },
    {
      "start": 87.33,
      "end": 90.29,
      "text": "由於中斷服務程序沒有調用者"
    },
    {
      "start": 90.29,
      "end": 93.65,
      "text": "因此,需要由中斷服務程序自身負責"
    },
    {
      "start": 93.65,
      "end": 96.77,
      "text": "將任何可能被改寫破壞的機存器"
    },
    {
      "start": 96.77,
      "end": 99.79,
      "text": "作為現場進行壓佔保護"
    },
    {
      "start": 99.79,
      "end": 101.39,
      "text": "保護現場結束後"
    },
    {
      "start": 101.39,
      "end": 104.51,
      "text": "就進入中斷服務階段"
    },
    {
      "start": 104.51,
      "end": 107.47,
      "text": "針對該中斷進行所需的操作"
    },
    {
      "start": 107.47,
      "end": 108.35,
      "text": "例如"
    },
    {
      "start": 108.35,
      "end": 112.51,
      "text": "針對網卡收到新的數據針所觸發的印紮中斷"
    },
    {
      "start": 112.51,
      "end": 115.3,
      "text": "中斷服務所需的操作如下"
    },
    {
      "start": 115.3,
      "end": 116.9,
      "text": "從網卡緩衝區"
    },
    {
      "start": 116.9,
      "end": 118.82,
      "text": "快速提取數據針"
    },
    {
      "start": 118.82,
      "end": 121.87,
      "text": "對數據針進行循環容易教驗"
    },
    {
      "start": 121.87,
      "end": 124.59,
      "text": "將數據針轉入內存安全區"
    },
    {
      "start": 124.82,
      "end": 126.74,
      "text": "解析數據針首部"
    },
    {
      "start": 126.74,
      "end": 129.49,
      "text": "設置待處理數據針標誌位"
    },
    {
      "start": 129.49,
      "end": 132.26,
      "text": "喚醒後臺網絡協議站現場"
    },
    {
      "start": 132.26,
      "end": 135.87,
      "text": "通知調度器由網絡任務待處理"
    },
    {
      "start": 135.87,
      "end": 137.89,
      "text": "請同兄注意"
    },
    {
      "start": 137.89,
      "end": 141.09,
      "text": "中斷服務需要遵循二把法則"
    },
    {
      "start": 141.09,
      "end": 145.57,
      "text": "也就是中斷服務僅完成20%的必要工作"
    },
    {
      "start": 145.57,
      "end": 148.21,
      "text": "80%轉交後臺處理"
    },
    {
      "start": 148.21,
      "end": 150.18,
      "text": "這並不難理解"
    },
    {
      "start": 150.18,
      "end": 152.18,
      "text": "例如案件處理中斷"
    },
    {
      "start": 152.18,
      "end": 155.14,
      "text": "如果在中斷服務中處理大量工作"
    },
    {
      "start": 155.3,
      "end": 158.74,
      "text": "則在中斷服務過程中再次出現案件中斷"
    },
    {
      "start": 158.74,
      "end": 160.74,
      "text": "則不能及時響應"
    },
    {
      "start": 160.74,
      "end": 163.39,
      "text": "使用戶感受到卡頓"
    },
    {
      "start": 163.39,
      "end": 164.99,
      "text": "中斷服務結束後"
    },
    {
      "start": 164.99,
      "end": 167.31,
      "text": "就進入恢復現場階段"
    },
    {
      "start": 167.31,
      "end": 170.51,
      "text": "按於壓佔相反的順序"
    },
    {
      "start": 170.51,
      "end": 172.35,
      "text": "對之前保護現場時"
    },
    {
      "start": 172.35,
      "end": 176.7,
      "text": "壓佔的各計存器內容進行初戰恢復"
    },
    {
      "start": 176.7,
      "end": 178.38,
      "text": "恢復現場結束後"
    },
    {
      "start": 178.38,
      "end": 181.38,
      "text": "就進入中斷返回階段"
    },
    {
      "start": 181.38,
      "end": 182.34,
      "text": "例如"
    },
    {
      "start": 182.34,
      "end": 184.9,
      "text": "使用密布斯32中的一RET指令"
    },
    {
      "start": 184.9,
      "end": 187.06,
      "text": "返回被中斷的程序"
    },
    {
      "start": 187.49,
      "end": 189.09,
      "text": "需要說明的是"
    },
    {
      "start": 189.09,
      "end": 192.77,
      "text": "以上給出的是針對簡單的單級中斷"
    },
    {
      "start": 192.77,
      "end": 196.59,
      "text": "其中斷服務程序所包含的四個步驟"
    },
    {
      "start": 196.59,
      "end": 199.07,
      "text": "根據之前的學習我們知道"
    },
    {
      "start": 199.07,
      "end": 201.23,
      "text": "進入中斷服務程序之前"
    },
    {
      "start": 201.23,
      "end": 203.31,
      "text": "是中斷響應週期"
    },
    {
      "start": 203.31,
      "end": 206.19,
      "text": "所執行的操作是關中斷"
    },
    {
      "start": 206.19,
      "end": 207.39,
      "text": "保存斷點"
    },
    {
      "start": 207.39,
      "end": 209.66,
      "text": "進入中斷服務程序"
    },
    {
      "start": 209.66,
      "end": 212.38,
      "text": "而在中斷服務程序的最後一個步驟"
    },
    {
      "start": 212.38,
      "end": 214.38,
      "text": "也就是中斷返回中"
    },
    {
      "start": 214.38,
      "end": 217.1,
      "text": "所執行的操作是返回斷點"
    },
    {
      "start": 217.18,
      "end": 218.59,
      "text": "開中斷"
    },
    {
      "start": 218.59,
      "end": 222.19,
      "text": "這是我們上節課就學習過的內容"
    },
    {
      "start": 222.19,
      "end": 223.87,
      "text": "這是中斷響應週期的"
    },
    {
      "start": 223.87,
      "end": 225.07,
      "text": "第一個節拍電位"
    },
    {
      "start": 225.07,
      "end": 229.17,
      "text": "所執行的關中斷和保存斷點的操作"
    },
    {
      "start": 229.17,
      "end": 230.85,
      "text": "這是中斷響應週期的"
    },
    {
      "start": 230.85,
      "end": 233.09,
      "text": "第二個節拍電位所執行的"
    },
    {
      "start": 233.09,
      "end": 236.56,
      "text": "進入當前中斷服務程序的操作"
    },
    {
      "start": 236.56,
      "end": 239.12,
      "text": "這是中斷返回指令的執行週期"
    },
    {
      "start": 239.12,
      "end": 243.44,
      "text": "所執行的返回斷點和開中斷的操作"
    },
    {
      "start": 243.44,
      "end": 246.45,
      "text": "相信同學們都還記得"
    },
    {
      "start": 246.45,
      "end": 249.25,
      "text": "那麼對於多級嵌桃中斷呢"
    },
    {
      "start": 249.25,
      "end": 251.73,
      "text": "保護現場後應該開中斷"
    },
    {
      "start": 251.73,
      "end": 255.66,
      "text": "以確保中斷服務程序還可以被中斷"
    },
    {
      "start": 255.66,
      "end": 258.62,
      "text": "而恢復現場前應該關中斷"
    },
    {
      "start": 258.62,
      "end": 261.74,
      "text": "以確保恢復現場的完整性"
    },
    {
      "start": 261.74,
      "end": 266.05,
      "text": "我們將這兩個步驟標記在上圖中"
    },
    {
      "start": 266.05,
      "end": 267.65,
      "text": "需要說明的是"
    },
    {
      "start": 267.65,
      "end": 269.25,
      "text": "對於單級中斷"
    },
    {
      "start": 269.25,
      "end": 271.73,
      "text": "同時出現多個中斷請求時"
    },
    {
      "start": 271.73,
      "end": 274.27,
      "text": "按中斷優先級順序處理"
    },
    {
      "start": 274.27,
      "end": 275.95,
      "text": "對於嵌桃中斷"
    },
    {
      "start": 275.95,
      "end": 278.59,
      "text": "遵循優先級搶佔規則"
    },
    {
      "start": 278.59,
      "end": 280.59,
      "text": "也就是高優先級中斷"
    },
    {
      "start": 280.59,
      "end": 285.25,
      "text": "可以中斷低優先級中斷的中斷服務程序"
    },
    {
      "start": 285.25,
      "end": 288.45,
      "text": "好的本節課到這裡就結束了"
    },
    {
      "start": 288.45,
      "end": 290.85,
      "text": "同學們我們下節課見"
    }
  ]
}