    },
    {
      "start": 998.7,
      "end": 1003.0,
      "text": "表明還剩餘一次加法和一位操作"
    },
    {
      "start": 1003.0,
      "end": 1008.22,
      "text": "由於此時成商基存器MQ的最低位MQ零等於一"
    },
    {
      "start": 1008.22,
      "end": 1011.46,
      "text": "於是控制邏輯會控制ALU"
    },
    {
      "start": 1011.46,
      "end": 1014.1,
      "text": "將操作數基存器X中的內容"
    },
    {
      "start": 1014.1,
      "end": 1018.54,
      "text": "與磊家器ACC中的內容進行加法運算"
    },
    {
      "start": 1018.54,
      "end": 1021.86,
      "text": "此次加法運算會產生健位信號"
    },
    {
      "start": 1021.86,
      "end": 1024.58,
      "text": "在寫取能信號1N的控制下"
    },
    {
      "start": 1024.62,
      "end": 1030.74,
      "text": "運算結果和健位信號被分別寫入到ACC和COUT中"
    },
    {
      "start": 1030.74,
      "end": 1036.1,
      "text": "我們將上述操作的結果記錄到右側的表格中"
    },
    {
      "start": 1036.1,
      "end": 1041.14,
      "text": "至此上面這個表達式中的這部分就已經完成了"
    },
    {
      "start": 1041.14,
      "end": 1044.38,
      "text": "之後控制邏輯會控制COUT"
    },
    {
      "start": 1044.38,
      "end": 1049.87,
      "text": "ACC MQ中的內容同時向右移動一位"
    },
    {
      "start": 1049.87,
      "end": 1052.55,
      "text": "MQ中最低位的內容被移出"
    },
    {
      "start": 1052.55,
      "end": 1053.83,
      "text": "丟棄即可"
    },
    {
      "start": 1053.87,
      "end": 1058.95,
      "text": "而COUT中的1被移入到ACC中的左側第一位"
    },
    {
      "start": 1058.95,
      "end": 1061.39,
      "text": "COUT中不零即可"
    },
    {
      "start": 1061.39,
      "end": 1066.32,
      "text": "我們將上述操作的結果記錄到右側的表格中"
    },
    {
      "start": 1066.32,
      "end": 1070.9,
      "text": "這次上面這個表達式就全部計算完成了"
    },
    {
      "start": 1070.9,
      "end": 1075.82,
      "text": "也就是第四輪次的加法和一位操作執行完畢"
    },
    {
      "start": 1075.82,
      "end": 1081.06,
      "text": "技術器CN的內容被更新為零表明運算結束"
    },
    {
      "start": 1081.06,
      "end": 1087.9,
      "text": "而此時累加器ACC中保存的就是成績的整數形式的高四位"
    },
    {
      "start": 1087.9,
      "end": 1094.9,
      "text": "而乘上技術器MQ中保存的就是成績的整數形式的第四位"
    },
    {
      "start": 1094.9,
      "end": 1105.9,
      "text": "最後請同學們參照上面這個例子完成該練習"
    },
    {
      "start": 1105.9,
      "end": 1109.14,
      "text": "好的本節課到這裡就結束了"
    },
    {
      "start": 1109.14,
      "end": 1111.26,
      "text": "同學們我們下節課見"
    }
  ]
}