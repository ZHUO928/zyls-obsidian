      "text": "采用恢复余数法"
    },
    {
      "start": 848.7,
      "end": 852.06,
      "text": "来完成本立原码主法运算"
    },
    {
      "start": 852.06,
      "end": 853.66,
      "text": "出示余数r0"
    },
    {
      "start": 853.66,
      "end": 855.58,
      "text": "就是被除出x"
    },
    {
      "start": 855.58,
